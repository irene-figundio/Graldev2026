@using Graldev.Web.Models

@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

@section Style {
    <style>
        .integration-page {
            --integration-copy: 760px;
        }

        /* =========================================================
                   OVERVIEW
                   ========================================================= */

        .integration-overview {
            position: relative;
            padding: 7rem 0;
        }

        .integration-overview-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(360px, .95fr);
            gap: clamp(3rem, 7vw, 7rem);
            align-items: center;
        }

        .integration-copy {
            max-width: var(--integration-copy);
        }

            .integration-copy h2 {
                margin: 0 0 1.35rem;
                color: var(--brand-green-dark);
                font-size: clamp(2.15rem, 4vw, 3.6rem);
                line-height: 1.03;
                letter-spacing: -.045em;
            }

            .integration-copy p {
                margin: 0;
                color: var(--text-soft);
                font-size: 1.03rem;
                line-height: 1.82;
            }

                .integration-copy p + p {
                    margin-top: 1.1rem;
                }

        .integration-highlight {
            margin-top: 1.9rem;
            padding: 1.2rem 1.35rem;
            border-left: 2px solid var(--champagne-gold);
            color: var(--brand-green-dark);
            font-size: .94rem;
            font-weight: 650;
            line-height: 1.65;
            background: linear-gradient( 90deg, rgba(197,160,89,.075), transparent );
        }

        /* =========================================================
                   INTEGRATION SCOPE
                   ========================================================= */

        .integration-scope-card {
            padding: 2rem;
            border-radius: 29px;
        }

        .integration-card-kicker {
            display: inline-flex;
            align-items: center;
            gap: .65rem;
            margin-bottom: .75rem;
            color: var(--brand-green);
            font-size: .69rem;
            font-weight: 820;
            letter-spacing: .09em;
            text-transform: uppercase;
        }

            .integration-card-kicker::before {
                content: "";
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--champagne-gold);
                box-shadow: 0 0 0 5px rgba(197,160,89,.10);
            }

        .integration-scope-card h3 {
            margin: 0 0 1.5rem;
            color: var(--brand-green-dark);
            font-size: 1.55rem;
            line-height: 1.15;
            letter-spacing: -.035em;
        }

        .integration-scope-list {
            display: grid;
            gap: .72rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .integration-scope-item {
            display: grid;
            grid-template-columns: 48px minmax(0, 1fr);
            gap: .9rem;
            align-items: center;
            min-height: 70px;
            padding: .75rem .85rem;
            border: 1px solid rgba(255,255,255,.48);
            border-radius: 16px;
            background: rgba(255,255,255,.26);
        }

        .integration-scope-code {
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            border-radius: 13px;
            color: var(--brand-green-dark);
            font-size: .61rem;
            font-weight: 850;
            background: linear-gradient( 145deg, rgba(255,255,255,.76), rgba(229,244,235,.46) );
            border: 1px solid rgba(255,255,255,.78);
            box-shadow: 6px 7px 16px rgba(42,79,57,.06), inset 1px 1px 0 rgba(255,255,255,.96);
        }

        .integration-scope-copy strong {
            display: block;
            color: var(--brand-green-dark);
            font-size: .87rem;
            line-height: 1.3;
        }

        .integration-scope-copy span {
            display: block;
            margin-top: .14rem;
            color: var(--text-muted);
            font-size: .71rem;
            line-height: 1.4;
        }

        /* =========================================================
                   BEFORE / AFTER
                   ========================================================= */

        .integration-flow-section {
            padding: 7rem 0;
        }

        .integration-flow-heading {
            max-width: 860px;
            margin: 0 auto 3.4rem;
            text-align: center;
        }

            .integration-flow-heading h2 {
                margin: 0 0 1rem;
                color: var(--brand-green-dark);
                font-size: clamp(2.15rem, 4vw, 3.55rem);
                line-height: 1.03;
                letter-spacing: -.045em;
            }

            .integration-flow-heading p {
                max-width: 680px;
                margin: 0 auto;
                color: var(--text-soft);
                line-height: 1.72;
            }

        .integration-flow-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 72px minmax(0, 1fr);
            gap: 1rem;
            align-items: stretch;
        }

        .integration-state {
            padding: 2rem;
            border-radius: 28px;
        }

        .integration-state--before {
            border-color: rgba(156,71,61,.11);
            background: linear-gradient( 145deg, rgba(255,255,255,.63), rgba(249,243,241,.50) );
        }

        .integration-state--after {
            border-color: rgba(17,171,100,.12);
        }

        .integration-state-label {
            display: inline-flex;
            align-items: center;
            margin-bottom: 1.6rem;
            padding: .43rem .72rem;
            border-radius: 999px;
            font-size: .65rem;
            font-weight: 820;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .integration-state--before .integration-state-label {
            color: #8f4d45;
            background: rgba(156,71,61,.055);
            border: 1px solid rgba(156,71,61,.10);
        }

        .integration-state--after .integration-state-label {
            color: var(--brand-green);
            background: rgba(17,171,100,.055);
            border: 1px solid rgba(17,171,100,.10);
        }

        .integration-stack {
            display: grid;
            gap: .65rem;
        }

        .integration-system-node {
            min-height: 60px;
            display: grid;
            place-items: center;
            border-radius: 16px;
            color: var(--brand-green-dark);
            font-size: .82rem;
            font-weight: 800;
            background: linear-gradient( 145deg, rgba(255,255,255,.75), rgba(241,247,243,.54) );
            border: 1px solid rgba(255,255,255,.78);
            box-shadow: 6px 7px 16px rgba(42,79,57,.05), inset 1px 1px 0 rgba(255,255,255,.95);
        }

        .integration-gap {
            min-height: 43px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #9b5c53;
            font-size: .7rem;
            font-weight: 760;
            letter-spacing: .02em;
        }

        .integration-link {
            min-height: 47px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--brand-green);
            font-size: .69rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .045em;
        }

        .integration-state-summary {
            margin: 1.6rem 0 0;
            padding-top: 1.3rem;
            border-top: 1px solid rgba(16,73,40,.07);
            color: var(--text-soft);
            font-size: .85rem;
            line-height: 1.62;
        }

        .integration-flow-arrow {
            display: grid;
            place-items: center;
            color: var(--champagne-gold);
            font-size: 1.6rem;
        }

        /* =========================================================
                   CAPABILITIES
                   ========================================================= */

        .integration-capabilities-section {
            padding: 7rem 0;
        }

        .integration-capabilities-heading {
            max-width: 830px;
            margin-bottom: 3.3rem;
        }

            .integration-capabilities-heading h2 {
                margin: 0;
                color: var(--brand-green-dark);
                font-size: clamp(2.15rem, 4vw, 3.55rem);
                line-height: 1.03;
                letter-spacing: -.045em;
            }

        .integration-capabilities-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem;
        }

        .integration-capability {
            min-height: 300px;
            padding: 1.6rem;
            border-radius: 25px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .integration-capability-number {
            color: var(--champagne-gold);
            font-size: .69rem;
            font-weight: 850;
            letter-spacing: .08em;
        }

        .integration-capability h3 {
            margin: 2.5rem 0 .75rem;
            color: var(--brand-green-dark);
            font-size: 1.25rem;
            line-height: 1.15;
            letter-spacing: -.03em;
        }

        .integration-capability p {
            margin: 0;
            color: var(--text-soft);
            font-size: .84rem;
            line-height: 1.62;
        }

        /* =========================================================
                   RESILIENCE
                   ========================================================= */

        .integration-resilience-section {
            padding: 0 0 7rem;
        }

        .integration-resilience {
            position: relative;
            overflow: hidden;
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(360px, .9fr);
            gap: clamp(2.5rem, 6vw, 5.5rem);
            align-items: center;
            padding: clamp(2.8rem, 5vw, 4.7rem);
            border-radius: 32px;
            background: linear-gradient( 145deg, rgba(255,255,255,.66), rgba(237,248,241,.56) );
            border: 1px solid rgba(255,255,255,.82);
            box-shadow: 18px 22px 48px rgba(49,73,59,.085), inset 1px 1px 0 rgba(255,255,255,.95);
        }

            .integration-resilience::after {
                content: "";
                position: absolute;
                width: 430px;
                height: 430px;
                right: -180px;
                top: -230px;
                border-radius: 50%;
                pointer-events: none;
                background: radial-gradient( circle, rgba(197,160,89,.14), transparent 68% );
            }

        .integration-resilience-copy,
        .integration-resilience-list {
            position: relative;
            z-index: 2;
        }

        .integration-resilience h2 {
            margin: 0 0 1rem;
            color: var(--brand-green-dark);
            font-size: clamp(2rem, 4vw, 3.4rem);
            line-height: 1.04;
            letter-spacing: -.045em;
        }

        .integration-resilience-copy p {
            max-width: 700px;
            margin: 0;
            color: var(--text-soft);
            font-size: 1rem;
            line-height: 1.76;
        }

        .integration-resilience-list {
            display: grid;
            gap: .68rem;
        }

        .integration-resilience-item {
            display: grid;
            grid-template-columns: 42px minmax(0, 1fr);
            gap: .8rem;
            align-items: center;
            min-height: 62px;
            padding: .67rem .75rem;
            border-radius: 15px;
            background: rgba(255,255,255,.25);
            border: 1px solid rgba(255,255,255,.47);
        }

        .integration-resilience-code {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            color: var(--brand-green-dark);
            font-size: .6rem;
            font-weight: 850;
            background: linear-gradient( 145deg, rgba(255,255,255,.76), rgba(229,244,235,.44) );
            border: 1px solid rgba(255,255,255,.78);
        }

        .integration-resilience-item strong {
            display: block;
            color: var(--brand-green-dark);
            font-size: .8rem;
            line-height: 1.3;
        }

        .integration-resilience-item span {
            display: block;
            margin-top: .1rem;
            color: var(--text-muted);
            font-size: .68rem;
            line-height: 1.35;
        }

        /* =========================================================
                   FAQ
                   ========================================================= */

        .integration-faq-section {
            padding: 7rem 0;
        }

        .integration-faq-shell {
            max-width: 850px;
            margin: 0 auto;
        }

        .integration-faq-heading {
            margin-bottom: 2.6rem;
            text-align: center;
        }

            .integration-faq-heading h2 {
                margin: 0;
                color: var(--brand-green-dark);
                font-size: clamp(2rem, 3.7vw, 3rem);
                line-height: 1.05;
                letter-spacing: -.045em;
            }

        .integration-faq-item {
            border-bottom: 1px solid rgba(16,73,40,.08);
        }

        .integration-faq-trigger {
            width: 100%;
            padding: 1.3rem 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            border: 0;
            background: transparent;
            color: var(--brand-green-dark);
            font-family: inherit;
            font-size: 1rem;
            font-weight: 760;
            text-align: left;
            cursor: pointer;
        }

            .integration-faq-trigger::after {
                content: "+";
                flex: 0 0 auto;
                color: var(--champagne-gold);
                font-size: 1.4rem;
                font-weight: 400;
                transition: transform 180ms ease;
            }

            .integration-faq-trigger[aria-expanded="true"]::after {
                transform: rotate(45deg);
            }

        .integration-faq-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 260ms ease;
        }

            .integration-faq-content p {
                margin: 0;
                padding: 0 0 1.4rem;
                color: var(--text-soft);
                font-size: .92rem;
                line-height: 1.72;
            }

        /* =========================================================
                   CTA
                   ========================================================= */

        .integration-cta-section {
            padding: 1rem 0 7rem;
        }

        .integration-cta {
            position: relative;
            overflow: hidden;
            padding: clamp(3rem, 7vw, 5.7rem);
            border-radius: 34px;
            text-align: center;
            background: radial-gradient( circle at 50% 0%, rgba(255,255,255,.90), rgba(245,251,247,.74) 40%, rgba(231,244,236,.72) );
            border: 1px solid rgba(255,255,255,.82);
            box-shadow: 20px 25px 58px rgba(49,73,59,.09), inset 1px 1px 0 rgba(255,255,255,.96);
        }

            .integration-cta h2 {
                max-width: 860px;
                margin: 0 auto 1rem;
                color: var(--brand-green-dark);
                font-size: clamp(2.1rem, 4.4vw, 3.8rem);
                line-height: 1.03;
                letter-spacing: -.05em;
            }

            .integration-cta p {
                max-width: 650px;
                margin: 0 auto 2rem;
                color: var(--text-soft);
                line-height: 1.72;
            }

        /* =========================================================
                   RESPONSIVE
                   ========================================================= */

        @@media (max-width: 1050px) {
            .integration-capabilities-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 960px) {
            .integration-overview-grid,
            .integration-resilience {
                grid-template-columns: 1fr;
            }

            .integration-flow-grid {
                grid-template-columns: 1fr;
            }

            .integration-flow-arrow {
                min-height: 60px;
                transform: rotate(90deg);
            }
        }

        @@media (max-width: 700px) {
            .integration-overview,
            .integration-flow-section,
            .integration-capabilities-section,
            .integration-faq-section {
                padding: 5.5rem 0;
            }

            .integration-capabilities-grid {
                grid-template-columns: 1fr;
            }

            .integration-capability {
                min-height: 245px;
            }
        }

        @@media (max-width: 520px) {
            .integration-scope-card,
            .integration-state,
            .integration-capability {
                padding: 1.4rem;
                border-radius: 22px;
            }

            .integration-resilience,
            .integration-cta {
                padding: 3rem 1.35rem;
                border-radius: 27px;
            }

            .integration-faq-trigger {
                font-size: .92rem;
            }
        }
    </style>
}

<div class="integration-page">

    @await Html.PartialAsync(
        "_MetalHero",
        new MetalHeroViewModel
        {
            Id = "system-integration",

            Size = "large",

            Eyebrow = "SYSTEM INTEGRATION",

            Title = isEn
                ? "We make systems work together instead of beside each other."
                : "Facciamo lavorare insieme sistemi che oggi operano separatamente.",

            Subtitle = isEn
                ? "We design monitored integration flows between ERP, CRM, databases, SaaS platforms and commerce systems to reduce repetitive manual work and keep information coordinated."
                : "Progettiamo flussi di integrazione monitorati tra ERP, CRM, database, piattaforme SaaS e sistemi commerce per ridurre le attività manuali ripetitive e mantenere le informazioni coordinate.",

            Breadcrumbs = new List<MetalHeroBreadcrumbItem>
            {
                new()
                {
                    Label = "Home",
                    Url = isEn ? "/en" : "/"
                },
                new()
                {
                    Label = "System Integration",
                    IsCurrent = true
                }
            }
        }
    )


    <!-- ==========================================================
         OVERVIEW
         ========================================================== -->
    <section class="integration-overview premium-pale-green soft-transition transition-from-warm">

        <div class="container integration-overview-grid">

            <div class="integration-copy">

                <span class="section-eyebrow">
                    @(isEn
                        ? "THE SPACE BETWEEN SYSTEMS"
                        : "LO SPAZIO TRA I SISTEMI")
                </span>

                <h2>
                    @(isEn
                        ? "The individual applications may work perfectly. The friction often lives between them."
                        : "I singoli applicativi possono funzionare perfettamente. L'attrito spesso nasce tra un sistema e l'altro.")
                </h2>

                <p>
                    @(isEn
                        ? "Many organizations already own capable ERP, CRM, commerce platforms and operational databases. Problems appear when those systems exchange information through manual exports, spreadsheets, repeated copy-paste operations or fragile point-to-point procedures."
                        : "Molte organizzazioni dispongono già di ERP, CRM, piattaforme commerce e database operativi validi. I problemi emergono quando questi sistemi si scambiano informazioni attraverso esportazioni manuali, fogli Excel, copia-incolla ripetuti o procedure point-to-point fragili.")
                </p>

                <p>
                    @(isEn
                        ? "System integration creates controlled interfaces between those platforms, defining how information is validated, transformed, delivered, retried and reconciled."
                        : "La System Integration crea interfacce controllate tra queste piattaforme, definendo come le informazioni vengono validate, trasformate, consegnate, ritentate e riconciliate.")
                </p>

                <div class="integration-highlight">
                    @(isEn
                        ? "The goal is not to replace systems that already work. It is to remove the manual work required to keep them aligned."
                        : "L'obiettivo non è sostituire sistemi che già funzionano. È eliminare il lavoro manuale necessario per mantenerli allineati.")
                </div>

            </div>


            <aside class="premium-card integration-scope-card"
                   data-motif="network">

                <span class="integration-card-kicker">
                    @(isEn
                        ? "Integration scope"
                        : "Ambito di integrazione")
                </span>

                <h3>
                    @(isEn
                        ? "Systems and interfaces we connect"
                        : "Sistemi e interfacce che colleghiamo")
                </h3>

                <ul class="integration-scope-list">

                    <li class="integration-scope-item">

                        <span class="integration-scope-code">
                            ERP
                        </span>

                        <span class="integration-scope-copy">
                            <strong>ERP Systems</strong>

                            <span>
                                SAP · Dynamics · TeamSystem · Custom
                            </span>
                        </span>

                    </li>


                    <li class="integration-scope-item">

                        <span class="integration-scope-code">
                            CRM
                        </span>

                        <span class="integration-scope-copy">
                            <strong>CRM Platforms</strong>

                            <span>
                                Salesforce · HubSpot · Custom CRM
                            </span>
                        </span>

                    </li>


                    <li class="integration-scope-item">

                        <span class="integration-scope-code">
                            COM
                        </span>

                        <span class="integration-scope-copy">
                            <strong>
                                @(isEn
                                    ? "Commerce systems"
                                    : "Sistemi commerce")
                            </strong>

                            <span>
                                Shopify · Amazon · eBay · Magento
                            </span>
                        </span>

                    </li>


                    <li class="integration-scope-item">

                        <span class="integration-scope-code">
                            API
                        </span>

                        <span class="integration-scope-copy">
                            <strong>
                                @(isEn
                                    ? "Service interfaces"
                                    : "Interfacce di servizio")
                            </strong>

                            <span>
                                REST · SOAP · Webhooks · JSON · XML
                            </span>
                        </span>

                    </li>

                </ul>

            </aside>

        </div>

    </section>


    <!-- ==========================================================
         BEFORE / AFTER
         ========================================================== -->
    <section class="integration-flow-section bg-warm-white soft-transition transition-from-green">

        <div class="container">

            <div class="integration-flow-heading">

                <span class="section-eyebrow">
                    @(isEn
                        ? "BEFORE & AFTER"
                        : "PRIMA & DOPO")
                </span>

                <h2>
                    @(isEn
                        ? "The difference is an orchestration layer between the applications."
                        : "La differenza è un livello di orchestrazione tra gli applicativi.")
                </h2>

                <p>
                    @(isEn
                        ? "Integration changes how information moves between systems without necessarily changing the systems themselves."
                        : "L'integrazione cambia il modo in cui le informazioni si muovono tra i sistemi senza dover necessariamente cambiare i sistemi stessi.")
                </p>

            </div>


            <div class="integration-flow-grid">

                <!-- BEFORE -->
                <article class="premium-card integration-state integration-state--before">

                    <span class="integration-state-label">
                        @(isEn
                            ? "Before · Silos"
                            : "Prima · Silos")
                    </span>

                    <div class="integration-stack">

                        <div class="integration-system-node">
                            ERP
                        </div>

                        <div class="integration-gap">
                            @(isEn
                                ? "Manual export / copy"
                                : "Export / copia manuale")
                        </div>

                        <div class="integration-system-node">
                            CRM
                        </div>

                        <div class="integration-gap">
                            @(isEn
                                ? "Manual reconciliation"
                                : "Riconciliazione manuale")
                        </div>

                        <div class="integration-system-node">
                            Shopify
                        </div>

                    </div>


                    <p class="integration-state-summary">
                        @(isEn
                            ? "Repeated data entry, duplicate records, delayed synchronization and limited visibility across the full process."
                            : "Inserimenti ripetuti, anagrafiche duplicate, sincronizzazioni ritardate e visibilità limitata sull'intero processo.")
                    </p>

                </article>


                <div class="integration-flow-arrow"
                     aria-hidden="true">
                    →
                </div>


                <!-- AFTER -->
                <article class="premium-card integration-state integration-state--after"
                         data-motif="network">

                    <span class="integration-state-label">
                        @(isEn
                            ? "After · Integrated"
                            : "Dopo · Integrato")
                    </span>

                    <div class="integration-stack">

                        <div class="integration-system-node">
                            ERP
                        </div>

                        <div class="integration-link">
                            API / Middleware
                        </div>

                        <div class="integration-system-node">
                            CRM
                        </div>

                        <div class="integration-link">
                            Events / Webhooks
                        </div>

                        <div class="integration-system-node">
                            Shopify
                        </div>

                    </div>


                    <p class="integration-state-summary">
                        @(isEn
                            ? "Information moves through controlled interfaces with validation, monitoring and automated retry strategies where required."
                            : "Le informazioni transitano attraverso interfacce controllate con validazione, monitoraggio e strategie automatiche di retry dove necessario.")
                    </p>

                </article>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         CAPABILITIES
         ========================================================== -->
    <section class="integration-capabilities-section premium-pale-green soft-transition transition-from-warm">

        <div class="container">

            <div class="integration-capabilities-heading">

                <span class="section-eyebrow">
                    @(isEn
                        ? "INTEGRATION CAPABILITIES"
                        : "CAPACITÀ DI INTEGRAZIONE")
                </span>

                <h2>
                    @(isEn
                        ? "More than moving data from A to B."
                        : "Molto più che spostare dati da A a B.")
                </h2>

            </div>


            <div class="integration-capabilities-grid">

                <article class="premium-card integration-capability"
                         data-motif="architecture">

                    <span class="integration-capability-number">
                        01 / API
                    </span>

                    <div>
                        <h3>
                            API Integration
                        </h3>

                        <p>
                            @(isEn
                                ? "REST and SOAP interfaces with clear contracts, validation, authentication and controlled error handling."
                                : "Interfacce REST e SOAP con contratti chiari, validazione, autenticazione e gestione controllata degli errori.")
                        </p>
                    </div>

                </article>


                <article class="premium-card integration-capability"
                         data-motif="network">

                    <span class="integration-capability-number">
                        02 / EVENTS
                    </span>

                    <div>
                        <h3>
                            Webhooks &amp; Events
                        </h3>

                        <p>
                            @(isEn
                                ? "Event-driven flows reduce unnecessary polling and allow systems to react when meaningful changes occur."
                                : "I flussi event-driven riducono il polling non necessario e permettono ai sistemi di reagire quando avvengono variazioni significative.")
                        </p>
                    </div>

                </article>


                <article class="premium-card integration-capability"
                         data-motif="roadmap">

                    <span class="integration-capability-number">
                        03 / MIDDLEWARE
                    </span>

                    <div>
                        <h3>
                            Middleware
                        </h3>

                        <p>
                            @(isEn
                                ? "A dedicated orchestration layer can transform formats, route messages and decouple systems with different constraints."
                                : "Un layer dedicato di orchestrazione può trasformare formati, instradare messaggi e disaccoppiare sistemi con vincoli differenti.")
                        </p>
                    </div>

                </article>


                <article class="premium-card integration-capability"
                         data-motif="data">

                    <span class="integration-capability-number">
                        04 / DATA
                    </span>

                    <div>
                        <h3>
                            @(isEn
                                ? "Data synchronization"
                                : "Sincronizzazione dati")
                        </h3>

                        <p>
                            @(isEn
                                ? "Mapping, normalization, reconciliation and idempotent processing help keep information consistent across systems."
                                : "Mapping, normalizzazione, riconciliazione e processi idempotenti aiutano a mantenere le informazioni coerenti tra i sistemi.")
                        </p>
                    </div>

                </article>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         RESILIENCE
         ========================================================== -->
    <section class="integration-resilience-section bg-warm-white">

        <div class="container">

            <div class="integration-resilience">

                <div class="integration-resilience-copy">

                    <span class="section-eyebrow">
                        @(isEn
                            ? "RESILIENT INTEGRATION"
                            : "INTEGRAZIONE RESILIENTE")
                    </span>

                    <h2>
                        @(isEn
                            ? "An integration is only useful if it also behaves correctly when something fails."
                            : "Un'integrazione è utile solo se si comporta correttamente anche quando qualcosa non funziona.")
                    </h2>

                    <p>
                        @(isEn
                            ? "External APIs can become unavailable, ERP systems can enter maintenance windows and network calls can fail. Integration architecture therefore includes failure handling as part of the design, not as an afterthought."
                            : "Le API esterne possono diventare indisponibili, gli ERP possono entrare in manutenzione e le chiamate di rete possono fallire. Per questo la gestione degli errori fa parte dell'architettura di integrazione fin dall'inizio.")
                    </p>

                </div>


                <div class="integration-resilience-list">

                    <div class="integration-resilience-item">

                        <span class="integration-resilience-code">
                            Q
                        </span>

                        <div>
                            <strong>
                                @(isEn
                                    ? "Message queues"
                                    : "Code di messaggi")
                            </strong>

                            <span>
                                @(isEn
                                    ? "Buffer work when downstream systems are unavailable"
                                    : "Mantengono le operazioni quando un sistema downstream non è disponibile")
                            </span>
                        </div>

                    </div>


                    <div class="integration-resilience-item">

                        <span class="integration-resilience-code">
                            RT
                        </span>

                        <div>
                            <strong>
                                @(isEn
                                    ? "Controlled retries"
                                    : "Retry controllati")
                            </strong>

                            <span>
                                @(isEn
                                    ? "Retry transient failures without uncontrolled duplication"
                                    : "Gestiscono errori transitori evitando duplicazioni incontrollate")
                            </span>
                        </div>

                    </div>


                    <div class="integration-resilience-item">

                        <span class="integration-resilience-code">
                            ID
                        </span>

                        <div>
                            <strong>
                                Idempotency
                            </strong>

                            <span>
                                @(isEn
                                    ? "Protect repeated requests from creating duplicate effects"
                                    : "Evita che richieste ripetute producano effetti duplicati")
                            </span>
                        </div>

                    </div>


                    <div class="integration-resilience-item">

                        <span class="integration-resilience-code">
                            OBS
                        </span>

                        <div>
                            <strong>
                                @(isEn
                                    ? "Logging & monitoring"
                                    : "Logging e monitoraggio")
                            </strong>

                            <span>
                                @(isEn
                                    ? "Make integration failures observable and diagnosable"
                                    : "Rende gli errori di integrazione osservabili e diagnosticabili")
                            </span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         FAQ
         ========================================================== -->
    <section class="integration-faq-section premium-pale-green soft-transition transition-from-warm">

        <div class="container integration-faq-shell">

            <div class="integration-faq-heading">

                <span class="section-eyebrow">
                    @(isEn
                        ? "TECHNICAL DETAILS"
                        : "DETTAGLI TECNICI")
                </span>

                <h2>
                    @(isEn
                        ? "Common integration questions"
                        : "Domande comuni sulla System Integration")
                </h2>

            </div>


            <div class="integration-faq-item">

                <button class="integration-faq-trigger"
                        type="button"
                        aria-expanded="false"
                        onclick="toggleIntegrationFaq(this)">

                    @(isEn
                        ? "How are credentials and secrets protected?"
                        : "Come vengono protette credenziali e chiavi di accesso?")

                </button>

                <div class="integration-faq-content">

                    <p>
                        @(isEn
                            ? "Credentials should be kept outside source code and managed through appropriate secret stores or encrypted configuration mechanisms. The exact approach depends on the target infrastructure and deployment model."
                            : "Le credenziali vengono mantenute fuori dal codice sorgente e gestite tramite secret store appropriati o configurazioni cifrate. La soluzione concreta dipende dall'infrastruttura e dal modello di deployment utilizzato.")
                    </p>

                </div>

            </div>


            <div class="integration-faq-item">

                <button class="integration-faq-trigger"
                        type="button"
                        aria-expanded="false"
                        onclick="toggleIntegrationFaq(this)">

                    @(isEn
                        ? "What happens when one of the systems is temporarily unavailable?"
                        : "Cosa succede quando uno dei sistemi è temporaneamente indisponibile?")

                </button>

                <div class="integration-faq-content">

                    <p>
                        @(isEn
                            ? "Where the business flow requires it, asynchronous queues, retry policies, dead-letter handling and reconciliation processes can prevent a temporary outage from turning into lost or duplicated transactions."
                            : "Quando il flusso lo richiede, code asincrone, policy di retry, gestione delle dead-letter e processi di riconciliazione possono evitare che un'indisponibilità temporanea si trasformi in transazioni perse o duplicate.")
                    </p>

                </div>

            </div>


            <div class="integration-faq-item">

                <button class="integration-faq-trigger"
                        type="button"
                        aria-expanded="false"
                        onclick="toggleIntegrationFaq(this)">

                    @(isEn
                        ? "Can legacy systems without modern APIs still be integrated?"
                        : "È possibile integrare anche sistemi legacy senza API moderne?")

                </button>

                <div class="integration-faq-content">

                    <p>
                        @(isEn
                            ? "Often yes. Depending on the available interfaces, integration may use databases, file exchanges, SOAP services, scheduled imports, adapters or a dedicated compatibility layer. The safest option is selected after assessing the legacy system."
                            : "Spesso sì. In base alle interfacce disponibili si possono utilizzare database, scambio file, servizi SOAP, import pianificati, adapter o un layer dedicato di compatibilità. La soluzione più sicura viene scelta dopo l'assessment del sistema legacy.")
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         CTA
         ========================================================== -->
    <section class="integration-cta-section bg-warm-white">

        <div class="container">

            <div class="integration-cta">

                <span class="section-eyebrow">
                    ERP · CRM · API · DATA
                </span>

                <h2>
                    @(isEn
                        ? "Where are people still moving data manually between your systems?"
                        : "Dove state ancora spostando dati manualmente tra un sistema e l'altro?")
                </h2>

                <p>
                    @(isEn
                        ? "Let's map the systems, interfaces and hand-offs involved to identify where a controlled integration layer can remove repetitive work and improve reliability."
                        : "Mappiamo sistemi, interfacce e passaggi coinvolti per capire dove un layer di integrazione controllato può eliminare lavoro ripetitivo e aumentare l'affidabilità.")
                </p>

                <a href="@(isEn ? "/en/contact" : "/contatti")"
                   class="btn btn-primary">

                    @(isEn
                        ? "Request an integration assessment"
                        : "Richiedi un Integration Assessment")

                </a>

            </div>

        </div>

    </section>

</div>

@section Scripts {
    <script>
        function toggleIntegrationFaq(element) {
            const expanded =
                element.getAttribute("aria-expanded") === "true";

            element.setAttribute(
                "aria-expanded",
                expanded ? "false" : "true"
            );

            const content = element.nextElementSibling;

            if (!content) {
                return;
            }

            if (expanded) {
                content.style.maxHeight = "0px";
            } else {
                content.style.maxHeight =
                    content.scrollHeight + "px";
            }
        }
    </script>
}