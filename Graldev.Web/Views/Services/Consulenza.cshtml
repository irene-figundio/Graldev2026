@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

@section Style {
    <link rel="stylesheet" href="~/css/graldev-premium-shared.css" asp-append-version="true" />
}

<section class="consulting-hero metal-v3-section" data-metal-v3="consulting-hero">
    <div class="hero-metal-pattern-wrap" aria-hidden="true">
        <svg class="hero-metal-pattern-svg"
             viewBox="0 0 1600 1000"
             preserveAspectRatio="xMidYMid slice"
             focusable="false"
             xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="consultingGoldBase"
                                x1="0"
                                y1="0"
                                x2="1600"
                                y2="1000"
                                gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#8f651c" />
                    <stop offset="18%" stop-color="#d4a93d" />
                    <stop offset="34%" stop-color="#fff0a8" />
                    <stop offset="46%" stop-color="#b77d16" />
                    <stop offset="62%" stop-color="#f5d56d" />
                    <stop offset="79%" stop-color="#9e6b16" />
                    <stop offset="100%" stop-color="#e1b84d" />
                </linearGradient>

                <linearGradient id="consultingMetalHighlight"
                                x1="0"
                                y1="0"
                                x2="1"
                                y2="1">
                    <stop offset="0%" stop-color="#c68c19" />
                    <stop offset="28%" stop-color="#ffe793" />
                    <stop offset="46%" stop-color="#ffffff" />
                    <stop offset="58%" stop-color="#fff0ad" />
                    <stop offset="78%" stop-color="#d8a42d" />
                    <stop offset="100%" stop-color="#a26a12" />
                </linearGradient>

                <radialGradient id="consultingShineMaskGradient">
                    <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                    <stop offset="38%" stop-color="#ffffff" stop-opacity=".98" />
                    <stop offset="68%" stop-color="#ffffff" stop-opacity=".42" />
                    <stop offset="100%" stop-color="#000000" stop-opacity="0" />
                </radialGradient>

                <mask id="consultingShineMask"
                      maskUnits="userSpaceOnUse"
                      x="0"
                      y="0"
                      width="1600"
                      height="1000">
                    <rect width="1600" height="1000" fill="#000000" />
                    <circle class="hero-metal-shine-circle"
                            cx="800"
                            cy="350"
                            r="280"
                            fill="url(#consultingShineMaskGradient)" />
                </mask>

                <filter id="consultingEmboss"
                        x="-20%"
                        y="-20%"
                        width="140%"
                        height="140%">
                    <feDropShadow dx="0"
                                  dy="1"
                                  stdDeviation=".7"
                                  flood-color="#ffffff"
                                  flood-opacity=".72" />
                    <feDropShadow dx="0"
                                  dy="2"
                                  stdDeviation="1.6"
                                  flood-color="#7c5517"
                                  flood-opacity=".14" />
                </filter>

                <symbol id="consultingMetalMotif" viewBox="0 0 520 520">
                    <path d="
                    M260 0 L520 155 L520 390 L260 520 L0 390 L0 155 Z
                    M260 92 L392 170 L392 334 L260 412 L128 334 L128 170 Z
                    M260 166 L326 205 L326 286 L260 326 L194 286 L194 205 Z
                    M260 0 L260 92
                    M0 155 L128 232
                    M520 155 L392 232
                    M0 390 L128 313
                    M520 390 L392 313
                    M260 412 L260 520
                    " />
                </symbol>
            </defs>

            <g class="hero-metal-pattern-soft">
                <use href="#consultingMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#consultingMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#consultingMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#consultingMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#consultingMetalMotif" x="790" y="380" width="540" height="540" />
            </g>

            <g class="hero-metal-pattern-base"
               style="stroke:url(#consultingGoldBase);filter:url(#consultingEmboss);">
                <use href="#consultingMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#consultingMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#consultingMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#consultingMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#consultingMetalMotif" x="790" y="380" width="540" height="540" />
            </g>

            <g class="hero-metal-pattern-shine"
               style="stroke:url(#consultingMetalHighlight);mask:url(#consultingShineMask);">
                <use href="#consultingMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#consultingMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#consultingMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#consultingMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#consultingMetalMotif" x="790" y="380" width="540" height="540" />
            </g>
        </svg>
    </div>

    <div class="container">
        <span class="section-eyebrow">
            @(isEn ? "IT STRATEGY & ADVICE" : "CONSULENZA INFORMATICA DIREZIONALE")
        </span>

        <h1 class="section-title">
            @(isEn
                ? "IT consulting to turn complex technical needs into concrete operational solutions."
                : "Consulenza informatica per trasformare esigenze tecnologiche in soluzioni concrete.")
        </h1>

        <p class="section-subtitle">
            @(isEn
                ? "We support enterprises in assessment, design, systems architecture, selection of platforms and digital evolution."
                : "Supportiamo le imprese nelle fasi di assessment, progettazione, disegno architetturale, scelta tecnologica ed evoluzione digitale.")
        </p>
    </div>
</section>

<section class="consulting-main-section premium-pale-green soft-transition transition-from-warm">
    <div class="container split-layout">
        <div class="split-left">
            <h2>
                @(isEn
                    ? "Not every problem requires custom coding"
                    : "Non sempre serve sviluppare nuovo software")
            </h2>

            <p>
                @if (isEn)
                {
                    <text>Unlike software vendors or traditional software houses whose main business is selling more development hours, <strong>Graldev is a consultant and technical partner</strong>. We believe that writing custom code is just one of many ways to solve a business problem.</text>
                }
                else
                {
                    <text>A differenza dei vendor di software o delle tradizionali software house il cui interesse primario è vendere ore di sviluppo aggiuntive, <strong>Graldev opera come consulente e partner tecnico strategico</strong>. Crediamo che scrivere nuovo codice da zero sia solo una delle possibili risposte a un problema aziendale.</text>
                }
            </p>

            <p>
                @if (isEn)
                {
                    <text>A strategic consulting session can open much more efficient, rapid and cost-effective paths:</text>
                }
                else
                {
                    <text>Una consulenza informatica approfondita e oggettiva può rivelare strade molto più efficienti, rapide ed economicamente sostenibili per l'azienda:</text>
                }
            </p>

            <ul class="consulting-path-list">
                <li class="consulting-path-item">
                    <span class="consulting-path-icon">↗</span>
                    <div class="consulting-path-copy">
                        <strong>@(isEn ? "System Integration" : "Integrazione di sistemi esistenti")</strong>
                        @(isEn ? "connecting software already present in the company." : "connettere gestionali e piattaforme già presenti in azienda.")
                    </div>
                </li>

                <li class="consulting-path-item">
                    <span class="consulting-path-icon">◎</span>
                    <div class="consulting-path-copy">
                        <strong>@(isEn ? "Platform Optimization" : "Miglior configurazione")</strong>
                        @(isEn ? "getting more from existing software without replacing it." : "configurare o personalizzare meglio applicativi esistenti senza acquistarne di nuovi.")
                    </div>
                </li>

                <li class="consulting-path-item">
                    <span class="consulting-path-icon">◇</span>
                    <div class="consulting-path-copy">
                        <strong>@(isEn ? "Light Middleware" : "Creazione di middleware")</strong>
                        @(isEn ? "building small, smart connectors to flow data automatically." : "costruire piccoli connettori mirati per automatizzare i passaggi di dati.")
                    </div>
                </li>

                <li class="consulting-path-item">
                    <span class="consulting-path-icon">↻</span>
                    <div class="consulting-path-copy">
                        <strong>@(isEn ? "Modernization" : "Modernizzazione applicativa")</strong>
                        @(isEn ? "evolving legacy apps without disrupting company workflows." : "ringiovanire vecchi software senza bloccare l'operatività.")
                    </div>
                </li>

                <li class="consulting-path-item">
                    <span class="consulting-path-icon">✦</span>
                    <div class="consulting-path-copy">
                        <strong>@(isEn ? "AI Orchestration" : "Introduzione dell'AI")</strong>
                        @(isEn ? "integrating smart cognitive layers into actual database pipelines." : "integrare modelli intelligenti (LLM) direttamente sulle basi dati esistenti.")
                    </div>
                </li>
            </ul>
        </div>

        <div class="split-right">
            <div class="premium-card consulting-focus-card" data-motif="roadmap">
                <span class="premium-card-icon">◎</span>

                <h3>
                    @(isEn ? "Core Consulting Activities" : "Attività di Consulenza")
                </h3>

                <ul>
                    <li>@(isEn ? "Infrastructure & Code Audit" : "Assessment Tecnologico e del Codice")</li>
                    <li>@(isEn ? "Systems Architecture & Design" : "Disegno dell'Architettura Software")</li>
                    <li>@(isEn ? "Software Platform Selection" : "Software Selection & Fornitori")</li>
                    <li>@(isEn ? "AI Feasibility & Integration Review" : "Studio di fattibilità e Governance dell'AI")</li>
                    <li>@(isEn ? "IT Security & Migration Planning" : "Strategie di migrazione e Sicurezza")</li>
                </ul>

                <a href="@(isEn ? "/en/contact" : "/contatti")"
                   class="btn btn-primary"
                   style="width:100%;">
                    @(isEn ? "Speak with our Consultant" : "Parliamo della tua esigenza")
                </a>
            </div>
        </div>
    </div>
</section>

<section class="consulting-related-section metal-v3-section soft-transition transition-from-green"
         data-metal-v3="consulting-related">

    <div class="hero-metal-pattern-wrap" aria-hidden="true">
        <svg class="hero-metal-pattern-svg"
             viewBox="0 0 1600 1000"
             preserveAspectRatio="xMidYMid slice"
             focusable="false"
             xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="relatedGoldBase"
                                x1="0"
                                y1="0"
                                x2="1600"
                                y2="1000"
                                gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#8f651c" />
                    <stop offset="18%" stop-color="#d4a93d" />
                    <stop offset="34%" stop-color="#fff0a8" />
                    <stop offset="46%" stop-color="#b77d16" />
                    <stop offset="62%" stop-color="#f5d56d" />
                    <stop offset="79%" stop-color="#9e6b16" />
                    <stop offset="100%" stop-color="#e1b84d" />
                </linearGradient>

                <linearGradient id="relatedMetalHighlight"
                                x1="0"
                                y1="0"
                                x2="1"
                                y2="1">
                    <stop offset="0%" stop-color="#c68c19" />
                    <stop offset="28%" stop-color="#ffe793" />
                    <stop offset="46%" stop-color="#ffffff" />
                    <stop offset="58%" stop-color="#fff0ad" />
                    <stop offset="78%" stop-color="#d8a42d" />
                    <stop offset="100%" stop-color="#a26a12" />
                </linearGradient>

                <radialGradient id="relatedShineMaskGradient">
                    <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                    <stop offset="38%" stop-color="#ffffff" stop-opacity=".98" />
                    <stop offset="68%" stop-color="#ffffff" stop-opacity=".42" />
                    <stop offset="100%" stop-color="#000000" stop-opacity="0" />
                </radialGradient>

                <mask id="relatedShineMask"
                      maskUnits="userSpaceOnUse"
                      x="0"
                      y="0"
                      width="1600"
                      height="1000">
                    <rect width="1600" height="1000" fill="#000000" />
                    <circle class="hero-metal-shine-circle"
                            cx="800"
                            cy="350"
                            r="280"
                            fill="url(#relatedShineMaskGradient)" />
                </mask>

                <filter id="relatedEmboss"
                        x="-20%"
                        y="-20%"
                        width="140%"
                        height="140%">
                    <feDropShadow dx="0"
                                  dy="1"
                                  stdDeviation=".7"
                                  flood-color="#ffffff"
                                  flood-opacity=".72" />
                    <feDropShadow dx="0"
                                  dy="2"
                                  stdDeviation="1.6"
                                  flood-color="#7c5517"
                                  flood-opacity=".14" />
                </filter>

                <symbol id="relatedMetalMotif" viewBox="0 0 520 520">
                    <path d="
                    M260 0 L520 155 L520 390 L260 520 L0 390 L0 155 Z
                    M260 92 L392 170 L392 334 L260 412 L128 334 L128 170 Z
                    M260 166 L326 205 L326 286 L260 326 L194 286 L194 205 Z
                    M260 0 L260 92
                    M0 155 L128 232
                    M520 155 L392 232
                    M0 390 L128 313
                    M520 390 L392 313
                    M260 412 L260 520
                    " />
                </symbol>
            </defs>

            <g class="hero-metal-pattern-soft">
                <use href="#relatedMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#relatedMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#relatedMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#relatedMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#relatedMetalMotif" x="790" y="380" width="540" height="540" />
            </g>

            <g class="hero-metal-pattern-base"
               style="stroke:url(#relatedGoldBase);filter:url(#relatedEmboss);">
                <use href="#relatedMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#relatedMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#relatedMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#relatedMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#relatedMetalMotif" x="790" y="380" width="540" height="540" />
            </g>

            <g class="hero-metal-pattern-shine"
               style="stroke:url(#relatedMetalHighlight);mask:url(#relatedShineMask);">
                <use href="#relatedMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#relatedMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#relatedMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#relatedMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#relatedMetalMotif" x="790" y="380" width="540" height="540" />
            </g>
        </svg>
    </div>

    <div class="container">
        <div class="section-heading">
            <span class="section-eyebrow">
                @(isEn ? "RELATED CAPABILITIES" : "AREE CORRELATE")
            </span>

            <h2>
                @(isEn
                    ? "Explore our focus areas"
                    : "Approfondisci le nostre specializzazioni")
            </h2>
        </div>

        <div class="consulting-related-grid">
            <div class="premium-card" data-motif="network">
                <div>
                    <h3>System Integration</h3>
                    <p>
                        @(isEn
                            ? "Automating communication between your CRM, ERP, and commerce databases."
                            : "Collega ERP, CRM, database e software esterni eliminando passaggi manuali.")
                    </p>
                </div>

                <a href="@(isEn ? "/en/services/system-integration" : "/servizi/system-integration")"
                   class="premium-card-link">
                    System Integration
                </a>
            </div>

            <div class="premium-card" data-motif="ai">
                <div>
                    <h3>AI & Automation</h3>
                    <p>
                        @(isEn
                            ? "Integrating advanced generative AI and LLMs inside your processes securely."
                            : "Porta modelli AI intelligenti (RAG) all'interno dei database aziendali.")
                    </p>
                </div>

                <a href="@(isEn ? "/en/services/ai-integration" : "/servizi/ai-integration")"
                   class="premium-card-link">
                    AI Integration
                </a>
            </div>

            <div class="premium-card" data-motif="cloud">
                <div>
                    <h3>Cloud & Architecture</h3>
                    <p>
                        @(isEn
                            ? "Designing highly scaling and cost-effective modern cloud structures."
                            : "Evolvi le infrastrutture applicative per garantire alta disponibilità.")
                    </p>
                </div>

                <a href="@(isEn ? "/en/services/cloud-architecture" : "/servizi/cloud-architecture")"
                   class="premium-card-link">
                    Cloud Architecture
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/graldev-metal-v3.js" asp-append-version="true"></script>
}