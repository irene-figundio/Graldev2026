@using Graldev.Web.Models

@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

@section Style {
    <style>
        .consulting-page {
            --consulting-copy: 760px;
        }

        /* =========================================================
                   OVERVIEW
                   ========================================================= */

        .consulting-overview {
            position: relative;
            padding: 7rem 0;
        }

        .consulting-overview-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.08fr) minmax(360px, .92fr);
            gap: clamp(3rem, 7vw, 7rem);
            align-items: start;
        }

        .consulting-copy {
            max-width: var(--consulting-copy);
        }

            .consulting-copy h2 {
                margin: 0 0 1.35rem;
                color: var(--brand-green-dark);
                font-size: clamp(2.15rem, 4vw, 3.6rem);
                line-height: 1.03;
                letter-spacing: -.045em;
            }

            .consulting-copy p {
                margin: 0;
                color: var(--text-soft);
                font-size: 1.03rem;
                line-height: 1.82;
            }

                .consulting-copy p + p {
                    margin-top: 1.1rem;
                }

        .consulting-highlight {
            margin-top: 1.9rem;
            padding: 1.2rem 1.35rem;
            border-left: 2px solid var(--champagne-gold);
            color: var(--brand-green-dark);
            font-size: .94rem;
            font-weight: 650;
            line-height: 1.65;
            background: linear-gradient( 90deg, rgba(197,160,89,.075), transparent );
        }

        /* =========================================================
                   CONSULTING CARD
                   ========================================================= */

        .consulting-focus-card {
            position: sticky;
            top: 112px;
            padding: 2rem;
            border-radius: 29px;
        }

        .consulting-card-kicker {
            display: inline-flex;
            align-items: center;
            gap: .65rem;
            margin-bottom: .75rem;
            color: var(--brand-green);
            font-size: .69rem;
            font-weight: 820;
            letter-spacing: .09em;
            text-transform: uppercase;
        }

            .consulting-card-kicker::before {
                content: "";
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--champagne-gold);
                box-shadow: 0 0 0 5px rgba(197,160,89,.10);
            }

        .consulting-focus-card h3 {
            margin: 0 0 1.5rem;
            color: var(--brand-green-dark);
            font-size: 1.55rem;
            line-height: 1.15;
            letter-spacing: -.035em;
        }

        .consulting-focus-list {
            display: grid;
            gap: .7rem;
            margin: 0 0 1.7rem;
            padding: 0;
            list-style: none;
        }

        .consulting-focus-item {
            display: grid;
            grid-template-columns: 44px minmax(0, 1fr);
            gap: .8rem;
            align-items: center;
            min-height: 64px;
            padding: .65rem .72rem;
            border-radius: 15px;
            border: 1px solid rgba(255,255,255,.50);
            background: rgba(255,255,255,.25);
        }

        .consulting-focus-code {
            width: 44px;
            height: 44px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            color: var(--brand-green-dark);
            font-size: .6rem;
            font-weight: 850;
            background: linear-gradient( 145deg, rgba(255,255,255,.76), rgba(229,244,235,.44) );
            border: 1px solid rgba(255,255,255,.78);
            box-shadow: 5px 6px 14px rgba(42,79,57,.055), inset 1px 1px 0 rgba(255,255,255,.96);
        }

        .consulting-focus-copy strong {
            display: block;
            color: var(--brand-green-dark);
            font-size: .8rem;
            line-height: 1.3;
        }

        .consulting-focus-copy span {
            display: block;
            margin-top: .1rem;
            color: var(--text-muted);
            font-size: .67rem;
            line-height: 1.35;
        }

        .consulting-focus-card .btn {
            width: 100%;
            min-height: 51px;
        }

        /* =========================================================
                   POSSIBLE PATHS
                   ========================================================= */

        .consulting-paths-section {
            padding: 7rem 0;
        }

        .consulting-paths-heading {
            max-width: 830px;
            margin-bottom: 3.4rem;
        }

            .consulting-paths-heading h2 {
                margin: 0 0 1rem;
                color: var(--brand-green-dark);
                font-size: clamp(2.15rem, 4vw, 3.55rem);
                line-height: 1.03;
                letter-spacing: -.045em;
            }

            .consulting-paths-heading p {
                max-width: 680px;
                margin: 0;
                color: var(--text-soft);
                line-height: 1.72;
            }

        .consulting-paths-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: .85rem;
        }

        .consulting-path {
            min-height: 280px;
            padding: 1.45rem;
            border-radius: 23px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .consulting-path-number {
            color: var(--champagne-gold);
            font-size: .68rem;
            font-weight: 850;
            letter-spacing: .08em;
        }

        .consulting-path h3 {
            margin: 2.3rem 0 .7rem;
            color: var(--brand-green-dark);
            font-size: 1.1rem;
            line-height: 1.2;
            letter-spacing: -.03em;
        }

        .consulting-path p {
            margin: 0;
            color: var(--text-soft);
            font-size: .8rem;
            line-height: 1.58;
        }

        /* =========================================================
                   METHOD
                   ========================================================= */

        .consulting-method-section {
            padding: 7rem 0;
        }

        .consulting-method-grid {
            display: grid;
            grid-template-columns: minmax(0, .9fr) minmax(360px, 1.1fr);
            gap: clamp(3rem, 7vw, 7rem);
            align-items: center;
        }

        .consulting-method-copy h2 {
            margin: 0 0 1.15rem;
            color: var(--brand-green-dark);
            font-size: clamp(2.1rem, 4vw, 3.5rem);
            line-height: 1.03;
            letter-spacing: -.045em;
        }

        .consulting-method-copy p {
            max-width: 700px;
            margin: 0;
            color: var(--text-soft);
            line-height: 1.78;
        }

        .consulting-method-card {
            padding: 2rem;
            border-radius: 28px;
        }

        .consulting-method-list {
            display: grid;
            gap: .62rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .consulting-method-step {
            display: grid;
            grid-template-columns: 40px minmax(0, 1fr);
            gap: .8rem;
            align-items: center;
            min-height: 61px;
            padding: .65rem .72rem;
            border-radius: 15px;
            background: rgba(255,255,255,.25);
            border: 1px solid rgba(255,255,255,.46);
        }

        .consulting-method-index {
            width: 40px;
            height: 40px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            color: var(--brand-green-dark);
            font-size: .68rem;
            font-weight: 850;
            background: linear-gradient( 145deg, rgba(255,255,255,.75), rgba(229,244,235,.44) );
            border: 1px solid rgba(255,255,255,.78);
        }

        .consulting-method-step strong {
            color: var(--brand-green-dark);
            font-size: .79rem;
            line-height: 1.3;
            text-transform: uppercase;
            letter-spacing: .015em;
        }

        /* =========================================================
                   RELATED CAPABILITIES
                   ========================================================= */

        .consulting-related-section {
            padding: 7rem 0;
        }

        .consulting-related-heading {
            max-width: 780px;
            margin: 0 auto 3.5rem;
            text-align: center;
        }

            .consulting-related-heading h2 {
                margin: 0 0 1rem;
                color: var(--brand-green-dark);
                font-size: clamp(2.1rem, 4vw, 3.4rem);
                line-height: 1.04;
                letter-spacing: -.045em;
            }

            .consulting-related-heading p {
                max-width: 650px;
                margin: 0 auto;
                color: var(--text-soft);
                line-height: 1.72;
            }

        .consulting-related-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.15rem;
        }

        .consulting-related-card {
            min-height: 310px;
            padding: 1.8rem;
            border-radius: 26px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .consulting-related-number {
            color: var(--champagne-gold);
            font-size: .68rem;
            font-weight: 850;
            letter-spacing: .08em;
        }

        .consulting-related-card h3 {
            margin: 2.6rem 0 .8rem;
            color: var(--brand-green-dark);
            font-size: 1.45rem;
            line-height: 1.15;
            letter-spacing: -.035em;
        }

        .consulting-related-card p {
            margin: 0;
            color: var(--text-soft);
            font-size: .9rem;
            line-height: 1.67;
        }

        .consulting-related-link {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            margin-top: 1.5rem;
            color: var(--brand-green-dark);
            font-size: .82rem;
            font-weight: 780;
            text-decoration: none;
        }

            .consulting-related-link::after {
                content: "↗";
                color: var(--champagne-gold);
                transition: transform 180ms ease;
            }

            .consulting-related-link:hover::after {
                transform: translate(2px, -2px);
            }

        /* =========================================================
                   POSITIONING
                   ========================================================= */

        .consulting-positioning-section {
            padding: 0 0 7rem;
        }

        .consulting-positioning {
            position: relative;
            overflow: hidden;
            padding: clamp(2.8rem, 5vw, 4.7rem);
            border-radius: 32px;
            background: linear-gradient( 145deg, rgba(255,255,255,.66), rgba(237,248,241,.56) );
            border: 1px solid rgba(255,255,255,.82);
            box-shadow: 18px 22px 48px rgba(49,73,59,.085), inset 1px 1px 0 rgba(255,255,255,.95);
        }

            .consulting-positioning::after {
                content: "";
                position: absolute;
                width: 430px;
                height: 430px;
                right: -180px;
                top: -230px;
                border-radius: 50%;
                pointer-events: none;
                background: radial-gradient( circle, rgba(197,160,89,.14), transparent 68% );
            }

        .consulting-positioning-content {
            position: relative;
            z-index: 2;
            max-width: 880px;
        }

        .consulting-positioning h2 {
            margin: 0 0 1.1rem;
            color: var(--brand-green-dark);
            font-size: clamp(2rem, 4vw, 3.4rem);
            line-height: 1.04;
            letter-spacing: -.045em;
        }

        .consulting-positioning p {
            max-width: 760px;
            margin: 0;
            color: var(--text-soft);
            font-size: 1rem;
            line-height: 1.76;
        }

        /* =========================================================
                   CTA
                   ========================================================= */

        .consulting-cta-section {
            padding: 1rem 0 7rem;
        }

        .consulting-cta {
            position: relative;
            overflow: hidden;
            padding: clamp(3rem, 7vw, 5.7rem);
            border-radius: 34px;
            text-align: center;
            background: radial-gradient( circle at 50% 0%, rgba(255,255,255,.90), rgba(245,251,247,.74) 40%, rgba(231,244,236,.72) );
            border: 1px solid rgba(255,255,255,.82);
            box-shadow: 20px 25px 58px rgba(49,73,59,.09), inset 1px 1px 0 rgba(255,255,255,.96);
        }

            .consulting-cta h2 {
                max-width: 860px;
                margin: 0 auto 1rem;
                color: var(--brand-green-dark);
                font-size: clamp(2.1rem, 4.4vw, 3.8rem);
                line-height: 1.03;
                letter-spacing: -.05em;
            }

            .consulting-cta p {
                max-width: 650px;
                margin: 0 auto 2rem;
                color: var(--text-soft);
                line-height: 1.72;
            }

        /* =========================================================
                   RESPONSIVE
                   ========================================================= */

        @@media (max-width: 1080px) {
            .consulting-paths-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media (max-width: 960px) {
            .consulting-overview-grid,
            .consulting-method-grid {
                grid-template-columns: 1fr;
            }

            .consulting-focus-card {
                position: relative;
                top: auto;
            }

            .consulting-related-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .consulting-related-card:last-child {
                grid-column: 1 / -1;
            }
        }

        @@media (max-width: 700px) {
            .consulting-overview,
            .consulting-paths-section,
            .consulting-method-section,
            .consulting-related-section {
                padding: 5.5rem 0;
            }

            .consulting-paths-grid,
            .consulting-related-grid {
                grid-template-columns: 1fr;
            }

            .consulting-related-card:last-child {
                grid-column: auto;
            }

            .consulting-path {
                min-height: 220px;
            }
        }

        @@media (max-width: 520px) {
            .consulting-focus-card,
            .consulting-method-card,
            .consulting-path,
            .consulting-related-card {
                padding: 1.4rem;
                border-radius: 22px;
            }

            .consulting-positioning,
            .consulting-cta {
                padding: 3rem 1.35rem;
                border-radius: 27px;
            }
        }
    </style>
}

<div class="consulting-page">

    @await Html.PartialAsync(
        "_MetalHero",
        new MetalHeroViewModel
        {
            Id = "it-consulting",

            Size = "large",

            Eyebrow = isEn
                ? "IT STRATEGY & ADVISORY"
                : "CONSULENZA INFORMATICA DIREZIONALE",

            Title = isEn
                ? "Technology decisions built around real business problems."
                : "Decisioni tecnologiche costruite attorno ai problemi reali dell'azienda.",

            Subtitle = isEn
                ? "We support organizations in technology assessment, architecture, platform selection, system integration and digital evolution, starting from processes and existing systems before proposing new technology."
                : "Affianchiamo le organizzazioni in assessment tecnologico, architettura, software selection, integrazione ed evoluzione digitale, partendo da processi e sistemi esistenti prima di proporre nuova tecnologia.",

            Breadcrumbs = new List<MetalHeroBreadcrumbItem>
            {
                new()
                {
                    Label = "Home",
                    Url = isEn ? "/en" : "/"
                },
                new()
                {
                    Label = isEn
                        ? "IT Consulting"
                        : "Consulenza Informatica",
                    IsCurrent = true
                }
            }
        }
    )


    <!-- ==========================================================
         OVERVIEW
         ========================================================== -->
    <section class="consulting-overview premium-pale-green soft-transition transition-from-warm">

        <div class="container consulting-overview-grid">

            <div class="consulting-copy">

                <span class="section-eyebrow">
                    @(isEn
                        ? "TECHNOLOGY BEFORE DEVELOPMENT"
                        : "STRATEGIA PRIMA DELLO SVILUPPO")
                </span>

                <h2>
                    @(isEn
                        ? "Not every problem requires new software."
                        : "Non ogni problema richiede nuovo software.")
                </h2>

                <p>
                    @if (isEn)
                    {
                        <text>
                            <strong>Graldev operates first as a technology consultant and partner.</strong>
                            Custom development is one possible answer, not the default answer.
                            Before proposing new software, we analyze workflows, existing
                            applications, data, dependencies and the operational constraint
                            the organization is actually trying to remove.
                        </text>
                    }
                    else
                    {
                        <text>
                            <strong>Graldev opera prima di tutto come consulente e technology partner.</strong>
                            Lo sviluppo custom è una possibile risposta, non la risposta predefinita.
                            Prima di proporre nuovo software analizziamo workflow, applicazioni
                            esistenti, dati, dipendenze e il vincolo operativo che l'organizzazione
                            deve realmente eliminare.
                        </text>
                    }
                </p>

                <p>
                    @(isEn
                        ? "Sometimes the correct answer is integration. Sometimes configuration, modernization, automation or replacing one component. Only when the existing ecosystem cannot solve the problem sustainably does custom development become the most appropriate path."
                        : "A volte la risposta corretta è un'integrazione. Altre volte una configurazione migliore, una modernizzazione, un'automazione o la sostituzione di un singolo componente. Solo quando l'ecosistema esistente non può risolvere il problema in modo sostenibile, lo sviluppo custom diventa il percorso più adatto.")
                </p>

                <div class="consulting-highlight">
                    @(isEn
                        ? "The objective is not to sell more technology. It is to reduce operational friction with the minimum architecture necessary to solve the problem well."
                        : "L'obiettivo non è vendere più tecnologia. È ridurre l'attrito operativo con l'architettura minima necessaria per risolvere bene il problema.")
                </div>

            </div>


            <aside class="premium-card consulting-focus-card"
                   data-motif="roadmap">

                <span class="consulting-card-kicker">
                    @(isEn
                        ? "Core consulting activities"
                        : "Attività di consulenza")
                </span>

                <h3>
                    @(isEn
                        ? "Where we support technical decisions"
                        : "Dove supportiamo le decisioni tecnologiche")
                </h3>

                <ul class="consulting-focus-list">

                    <li class="consulting-focus-item">
                        <span class="consulting-focus-code">AUD</span>

                        <span class="consulting-focus-copy">
                            <strong>
                                @(isEn
                                    ? "Technology assessment"
                                    : "Assessment tecnologico")
                            </strong>

                            <span>
                                @(isEn
                                    ? "Architecture, code, infrastructure and dependencies"
                                    : "Architettura, codice, infrastruttura e dipendenze")
                            </span>
                        </span>
                    </li>

                    <li class="consulting-focus-item">
                        <span class="consulting-focus-code">ARC</span>

                        <span class="consulting-focus-copy">
                            <strong>
                                @(isEn
                                    ? "Architecture & design"
                                    : "Architettura e progettazione")
                            </strong>

                            <span>
                                @(isEn
                                    ? "Target architecture and evolution roadmap"
                                    : "Architettura target e roadmap evolutiva")
                            </span>
                        </span>
                    </li>

                    <li class="consulting-focus-item">
                        <span class="consulting-focus-code">SEL</span>

                        <span class="consulting-focus-copy">
                            <strong>
                                @(isEn
                                    ? "Software selection"
                                    : "Software selection")
                            </strong>

                            <span>
                                @(isEn
                                    ? "Build, buy, configure, integrate or retain"
                                    : "Sviluppare, acquistare, configurare, integrare o mantenere")
                            </span>
                        </span>
                    </li>

                    <li class="consulting-focus-item">
                        <span class="consulting-focus-code">AI</span>

                        <span class="consulting-focus-copy">
                            <strong>
                                @(isEn
                                    ? "AI feasibility"
                                    : "Fattibilità AI")
                            </strong>

                            <span>
                                @(isEn
                                    ? "Data, workflows, governance and realistic use cases"
                                    : "Dati, workflow, governance e casi d'uso realistici")
                            </span>
                        </span>
                    </li>

                    <li class="consulting-focus-item">
                        <span class="consulting-focus-code">MIG</span>

                        <span class="consulting-focus-copy">
                            <strong>
                                @(isEn
                                    ? "Migration planning"
                                    : "Pianificazione delle migrazioni")
                            </strong>

                            <span>
                                @(isEn
                                    ? "Controlled evolution with business continuity"
                                    : "Evoluzione controllata e continuità operativa")
                            </span>
                        </span>
                    </li>

                </ul>

                <a href="@(isEn ? "/en/contact" : "/contatti")"
                   class="btn btn-primary">

                    @(isEn
                        ? "Discuss your technology challenge"
                        : "Parliamo della tua esigenza")

                </a>

            </aside>

        </div>

    </section>


    <!-- ==========================================================
         POSSIBLE PATHS
         ========================================================== -->
    <section class="consulting-paths-section bg-warm-white soft-transition transition-from-green">

        <div class="container">

            <div class="consulting-paths-heading">

                <span class="section-eyebrow">
                    @(isEn
                        ? "POSSIBLE STRATEGIES"
                        : "POSSIBILI STRATEGIE")
                </span>

                <h2>
                    @(isEn
                        ? "The solution can take very different forms."
                        : "La soluzione può assumere forme molto diverse.")
                </h2>

                <p>
                    @(isEn
                        ? "The technology is selected after understanding the problem. These are some of the paths that can emerge from an assessment."
                        : "La tecnologia viene scelta dopo aver compreso il problema. Questi sono alcuni dei percorsi che possono emergere da un assessment.")
                </p>

            </div>


            <div class="consulting-paths-grid">

                <article class="premium-card consulting-path"
                         data-motif="network">

                    <span class="consulting-path-number">
                        01 / INTEGRATE
                    </span>

                    <div>
                        <h3>
                            System Integration
                        </h3>

                        <p>
                            @(isEn
                                ? "Connect applications that already work instead of replacing them."
                                : "Collegare applicazioni che già funzionano invece di sostituirle.")
                        </p>
                    </div>

                </article>


                <article class="premium-card consulting-path"
                         data-motif="roadmap">

                    <span class="consulting-path-number">
                        02 / OPTIMIZE
                    </span>

                    <div>
                        <h3>
                            @(isEn
                                ? "Platform Optimization"
                                : "Ottimizzazione")
                        </h3>

                        <p>
                            @(isEn
                                ? "Improve configuration or processes around existing platforms."
                                : "Migliorare configurazioni o processi attorno alle piattaforme esistenti.")
                        </p>
                    </div>

                </article>


                <article class="premium-card consulting-path"
                         data-motif="architecture">

                    <span class="consulting-path-number">
                        03 / CONNECT
                    </span>

                    <div>
                        <h3>
                            Middleware
                        </h3>

                        <p>
                            @(isEn
                                ? "Introduce a focused orchestration layer between disconnected systems."
                                : "Introdurre un livello di orchestrazione mirato tra sistemi scollegati.")
                        </p>
                    </div>

                </article>


                <article class="premium-card consulting-path"
                         data-motif="cloud">

                    <span class="consulting-path-number">
                        04 / EVOLVE
                    </span>

                    <div>
                        <h3>
                            @(isEn
                                ? "Modernization"
                                : "Modernizzazione")
                        </h3>

                        <p>
                            @(isEn
                                ? "Evolve legacy software incrementally while preserving operations."
                                : "Evolvere software legacy in modo incrementale preservando l'operatività.")
                        </p>
                    </div>

                </article>


                <article class="premium-card consulting-path"
                         data-motif="ai">

                    <span class="consulting-path-number">
                        05 / AUTOMATE
                    </span>

                    <div>
                        <h3>
                            AI &amp; Automation
                        </h3>

                        <p>
                            @(isEn
                                ? "Introduce AI only where data and workflow make the use case sustainable."
                                : "Introdurre AI soltanto dove dati e workflow rendono il caso d'uso sostenibile.")
                        </p>
                    </div>

                </article>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         METHOD
         ========================================================== -->
    <section class="consulting-method-section premium-pale-green soft-transition transition-from-warm">

