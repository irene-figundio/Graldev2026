@using Graldev.Web.Models

@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

@section Style {
    <style>
        .business-app-page {
            --business-copy: 760px;
        }

        /* =========================================================
                   OVERVIEW
                   ========================================================= */

        .business-overview {
            position: relative;
            padding: 7rem 0;
        }

        .business-overview-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(360px, .95fr);
            gap: clamp(3rem, 7vw, 7rem);
            align-items: center;
        }

        .business-copy {
            max-width: var(--business-copy);
        }

            .business-copy h2 {
                margin: 0 0 1.35rem;
                color: var(--brand-green-dark);
                font-size: clamp(2.15rem, 4vw, 3.6rem);
                line-height: 1.03;
                letter-spacing: -.045em;
            }

            .business-copy p {
                margin: 0;
                color: var(--text-soft);
                font-size: 1.03rem;
                line-height: 1.82;
            }

                .business-copy p + p {
                    margin-top: 1.1rem;
                }

        .business-highlight {
            margin-top: 1.9rem;
            padding: 1.2rem 1.35rem;
            border-left: 2px solid var(--champagne-gold);
            color: var(--brand-green-dark);
            font-size: .94rem;
            font-weight: 650;
            line-height: 1.65;
            background: linear-gradient( 90deg, rgba(197,160,89,.075), transparent );
        }

        /* =========================================================
                   CAPABILITIES
                   ========================================================= */

        .business-capability-card {
            padding: 2rem;
            border-radius: 29px;
        }

        .business-card-kicker {
            display: inline-flex;
            align-items: center;
            gap: .65rem;
            margin-bottom: .75rem;
            color: var(--brand-green);
            font-size: .69rem;
            font-weight: 820;
            letter-spacing: .09em;
            text-transform: uppercase;
        }

            .business-card-kicker::before {
                content: "";
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--champagne-gold);
                box-shadow: 0 0 0 5px rgba(197,160,89,.10);
            }

        .business-capability-card h3 {
            margin: 0 0 1.5rem;
            color: var(--brand-green-dark);
            font-size: 1.55rem;
            line-height: 1.15;
            letter-spacing: -.035em;
        }

        .business-capability-list {
            display: grid;
            gap: .72rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .business-capability-item {
            display: grid;
            grid-template-columns: 48px minmax(0, 1fr);
            gap: .9rem;
            align-items: center;
            min-height: 70px;
            padding: .75rem .85rem;
            border: 1px solid rgba(255,255,255,.48);
            border-radius: 16px;
            background: rgba(255,255,255,.26);
        }

        .business-capability-code {
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            border-radius: 13px;
            color: var(--brand-green-dark);
            font-size: .61rem;
            font-weight: 850;
            background: linear-gradient( 145deg, rgba(255,255,255,.76), rgba(229,244,235,.46) );
            border: 1px solid rgba(255,255,255,.78);
            box-shadow: 6px 7px 16px rgba(42,79,57,.06), inset 1px 1px 0 rgba(255,255,255,.96);
        }

        .business-capability-copy strong {
            display: block;
            color: var(--brand-green-dark);
            font-size: .87rem;
            line-height: 1.3;
        }

        .business-capability-copy span {
            display: block;
            margin-top: .14rem;
            color: var(--text-muted);
            font-size: .71rem;
            line-height: 1.4;
        }

        /* =========================================================
                   APPLICATION AREAS
                   ========================================================= */

        .business-areas {
            padding: 7rem 0;
        }

        .business-areas-heading {
            max-width: 830px;
            margin-bottom: 3.3rem;
        }

            .business-areas-heading h2 {
                margin: 0;
                color: var(--brand-green-dark);
                font-size: clamp(2.15rem, 4vw, 3.55rem);
                line-height: 1.03;
                letter-spacing: -.045em;
            }

        .business-areas-list {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .business-area-card {
            position: relative;
            overflow: hidden;
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(300px, .95fr);
            gap: clamp(2.5rem, 6vw, 5.5rem);
            align-items: center;
            min-height: 360px;
            padding: clamp(2rem, 4vw, 3.2rem);
            border-radius: 30px;
        }

        .business-area-card--reverse {
            grid-template-columns: minmax(300px, .95fr) minmax(0, 1.05fr);
        }

        .business-area-copy,
        .business-area-visual {
            position: relative;
            z-index: 2;
        }

        .business-area-number {
            display: block;
            margin-bottom: 1rem;
            color: var(--champagne-gold);
            font-size: .7rem;
            font-weight: 850;
            letter-spacing: .08em;
        }

        .business-area-card h3 {
            margin: 0 0 .9rem;
            color: var(--brand-green-dark);
            font-size: clamp(1.8rem, 3vw, 2.6rem);
            line-height: 1.06;
            letter-spacing: -.04em;
        }

        .business-area-card p {
            max-width: 680px;
            margin: 0;
            color: var(--text-soft);
            font-size: .94rem;
            line-height: 1.72;
        }

        .business-tags {
            display: flex;
            flex-wrap: wrap;
            gap: .45rem;
            margin: 1.5rem 0 0;
        }

        .business-tag {
            padding: .42rem .68rem;
            border-radius: 999px;
            color: var(--brand-green-dark);
            font-size: .66rem;
            font-weight: 720;
            background: rgba(255,255,255,.42);
            border: 1px solid rgba(16,73,40,.07);
        }

        /* =========================================================
                   SIMPLE VISUAL
                   ========================================================= */

        .business-area-visual {
            display: grid;
            place-items: center;
        }

        .business-system {
            position: relative;
            width: min(100%, 330px);
            min-height: 280px;
            display: grid;
            place-items: center;
        }

        .business-system-ring {
            position: absolute;
            width: 225px;
            height: 225px;
            border-radius: 50%;
            border: 1px solid rgba(197,160,89,.22);
        }

            .business-system-ring::after {
                content: "";
                position: absolute;
                inset: 24px;
                border-radius: 50%;
                border: 1px dashed rgba(17,171,100,.17);
            }

        .business-system-core {
            position: relative;
            z-index: 3;
            width: 125px;
            height: 125px;
            display: grid;
            place-items: center;
            border-radius: 29px;
            text-align: center;
            color: var(--brand-green-dark);
            font-size: .8rem;
            font-weight: 850;
            line-height: 1.15;
            background: linear-gradient( 145deg, rgba(255,255,255,.80), rgba(229,244,235,.54) );
            border: 1px solid rgba(255,255,255,.86);
            box-shadow: 13px 15px 32px rgba(42,79,57,.08), inset 1px 1px 0 rgba(255,255,255,.97);
        }

        .business-node {
            position: absolute;
            min-width: 78px;
            min-height: 46px;
            padding: .5rem .6rem;
            display: grid;
            place-items: center;
            border-radius: 14px;
            color: var(--brand-green-dark);
            font-size: .63rem;
            font-weight: 760;
            text-align: center;
            background: rgba(255,255,255,.47);
            border: 1px solid rgba(255,255,255,.72);
            box-shadow: 6px 8px 16px rgba(42,79,57,.055);
        }

        .business-node--top {
            top: 4px;
            left: 50%;
            transform: translateX(-50%);
        }

        .business-node--right {
            right: 0;
            top: 50%;
            transform: translateY(-50%);
        }

        .business-node--bottom {
            bottom: 4px;
            left: 50%;
            transform: translateX(-50%);
        }

        .business-node--left {
            left: 0;
            top: 50%;
            transform: translateY(-50%);
        }

        /* =========================================================
                   POSITIONING
                   ========================================================= */

        .business-positioning-section {
            padding: 0 0 7rem;
        }

        .business-positioning {
            position: relative;
            overflow: hidden;
            padding: clamp(2.8rem, 5vw, 4.6rem);
            border-radius: 31px;
            background: linear-gradient( 145deg, rgba(255,255,255,.66), rgba(237,248,241,.56) );
            border: 1px solid rgba(255,255,255,.82);
            box-shadow: 18px 22px 48px rgba(49,73,59,.085), inset 1px 1px 0 rgba(255,255,255,.95);
        }

        .business-positioning-content {
            max-width: 880px;
        }

        .business-positioning h2 {
            margin: 0 0 1.1rem;
            color: var(--brand-green-dark);
            font-size: clamp(2rem, 4vw, 3.4rem);
            line-height: 1.04;
            letter-spacing: -.045em;
        }

        .business-positioning p {
            max-width: 760px;
            margin: 0;
            color: var(--text-soft);
            font-size: 1rem;
            line-height: 1.76;
        }

        /* =========================================================
                   CTA
                   ========================================================= */

        .business-cta-section {
            padding: 1rem 0 7rem;
        }

        .business-cta {
            position: relative;
            overflow: hidden;
            padding: clamp(3rem, 7vw, 5.6rem);
            border-radius: 34px;
            text-align: center;
            background: radial-gradient( circle at 50% 0%, rgba(255,255,255,.90), rgba(245,251,247,.74) 40%, rgba(231,244,236,.72) );
            border: 1px solid rgba(255,255,255,.82);
            box-shadow: 20px 25px 58px rgba(49,73,59,.09), inset 1px 1px 0 rgba(255,255,255,.96);
        }

            .business-cta h2 {
                max-width: 850px;
                margin: 0 auto 1rem;
                color: var(--brand-green-dark);
                font-size: clamp(2.1rem, 4.4vw, 3.8rem);
                line-height: 1.03;
                letter-spacing: -.05em;
            }

            .business-cta p {
                max-width: 650px;
                margin: 0 auto 2rem;
                color: var(--text-soft);
                line-height: 1.72;
            }

        /* =========================================================
                   RESPONSIVE
                   ========================================================= */

        @@media (max-width: 980px) {
            .business-overview-grid,
            .business-area-card,
            .business-area-card--reverse {
                grid-template-columns: 1fr;
            }

                .business-area-card--reverse .business-area-copy {
                    order: 1;
                }

                .business-area-card--reverse .business-area-visual {
                    order: 2;
                }
        }

        @@media (max-width: 700px) {
            .business-overview,
            .business-areas {
                padding: 5.5rem 0;
            }

            .business-area-card {
                min-height: auto;
                padding: 1.6rem;
                border-radius: 24px;
            }
        }

        @@media (max-width: 520px) {
            .business-capability-card {
                padding: 1.4rem;
                border-radius: 22px;
            }

            .business-positioning,
            .business-cta {
                padding: 3rem 1.35rem;
                border-radius: 27px;
            }

            .business-system {
                transform: scale(.86);
            }
        }
    </style>
}

<div class="business-app-page">

    @await Html.PartialAsync(
        "_MetalHero",
        new MetalHeroViewModel
        {
            Id = "business-applications",

            Size = "large",

            Eyebrow = "BUSINESS APPLICATIONS",

            Title = isEn
                ? "Applications built around processes, not the other way around."
                : "Applicazioni costruite attorno ai processi, non il contrario.",

            Subtitle = isEn
                ? "We design operational applications, B2B portals and custom backoffice systems around the workflows, rules and information your teams actually use."
                : "Progettiamo applicazioni operative, portali B2B e sistemi di backoffice costruiti attorno ai workflow, alle regole e alle informazioni realmente utilizzate dai vostri team.",

            Breadcrumbs = new List<MetalHeroBreadcrumbItem>
            {
                new()
                {
                    Label = "Home",
                    Url = isEn ? "/en" : "/"
                },
                new()
                {
                    Label = isEn
                        ? "Business Applications"
                        : "Applicazioni Aziendali",
                    IsCurrent = true
                }
            }
        }
    )


    <!-- ==========================================================
         OVERVIEW
         ========================================================== -->
    <section class="business-overview premium-pale-green soft-transition transition-from-warm">

        <div class="container business-overview-grid">

            <div class="business-copy">

                <span class="section-eyebrow">
                    @(isEn
                        ? "SOFTWARE AROUND THE WORKFLOW"
                        : "SOFTWARE ATTORNO AL WORKFLOW")
                </span>

                <h2>
                    @(isEn
                        ? "Custom software makes sense when the process is genuinely specific."
                        : "Il software custom ha senso quando il processo è davvero specifico.")
                </h2>

                <p>
                    @(isEn
                        ? "Standard platforms are often the right choice when they already cover the required workflow. Problems arise when teams must maintain parallel spreadsheets, duplicate the same information or create manual workarounds because the software cannot represent the way the organization actually operates."
                        : "Le piattaforme standard sono spesso la scelta corretta quando coprono già il workflow necessario. I problemi iniziano quando i team devono mantenere fogli Excel paralleli, reinserire le stesse informazioni o creare workaround manuali perché il software non rappresenta realmente il modo in cui l'organizzazione lavora.")
                </p>

                <p>
                    @(isEn
                        ? "In those cases, we can design a dedicated application or a focused custom component that fits into the existing technology environment instead of replacing everything around it."
                        : "In questi casi possiamo progettare un'applicazione dedicata o un componente custom mirato, integrandolo nell'ambiente tecnologico esistente invece di sostituire tutto ciò che lo circonda.")
                </p>

                <div class="business-highlight">
                    @(isEn
                        ? "The objective is not to build more software. It is to remove friction from the operational process."
                        : "L'obiettivo non è sviluppare più software. È eliminare attrito dal processo operativo.")
                </div>

            </div>


            <aside class="premium-card business-capability-card"
                   data-motif="architecture">

                <span class="business-card-kicker">
                    @(isEn
                        ? "Application capabilities"
                        : "Capacità applicative")
                </span>

                <h3>
                    @(isEn
                        ? "What we can build"
                        : "Cosa possiamo sviluppare")
                </h3>

                <ul class="business-capability-list">

                    <li class="business-capability-item">
                        <span class="business-capability-code">ERP</span>

                        <span class="business-capability-copy">
                            <strong>
                                @(isEn
                                    ? "Custom management modules"
                                    : "Moduli gestionali custom")
                            </strong>

                            <span>
                                @(isEn
                                    ? "Operational components tailored to company rules"
                                    : "Componenti operativi adattati alle regole aziendali")
                            </span>
                        </span>
                    </li>

                    <li class="business-capability-item">
                        <span class="business-capability-code">B2B</span>

                        <span class="business-capability-copy">
                            <strong>
                                @(isEn
                                    ? "Customer & supplier portals"
                                    : "Portali clienti e fornitori")
                            </strong>

                            <span>
                                @(isEn
                                    ? "Controlled access to orders, documents and services"
                                    : "Accesso controllato a ordini, documenti e servizi")
                            </span>
                        </span>
                    </li>

                    <li class="business-capability-item">
                        <span class="business-capability-code">OPS</span>

                        <span class="business-capability-copy">
                            <strong>
                                @(isEn
                                    ? "Operational backoffice"
                                    : "Backoffice operativo")
                            </strong>

                            <span>
                                @(isEn
                                    ? "Dashboards, workflows and department tools"
                                    : "Dashboard, workflow e strumenti di reparto")
                            </span>
                        </span>
                    </li>

                    <li class="business-capability-item">
                        <span class="business-capability-code">MOB</span>

                        <span class="business-capability-copy">
                            <strong>
                                @(isEn
                                    ? "Field applications"
                                    : "Applicazioni per operatori sul campo")
                            </strong>

                            <span>
                                @(isEn
                                    ? "Mobile workflows for distributed operational teams"
                                    : "Workflow mobile per team operativi distribuiti")
                            </span>
                        </span>
                    </li>

                </ul>

            </aside>

        </div>

    </section>


    <!-- ==========================================================
         APPLICATION AREAS
         ========================================================== -->
    <section class="business-areas bg-warm-white soft-transition transition-from-green">

        <div class="container">

            <div class="business-areas-heading">

                <span class="section-eyebrow">
                    @(isEn
                        ? "BUSINESS APPLICATION AREAS"
                        : "AMBITI APPLICATIVI")
                </span>

                <h2>
                    @(isEn
                        ? "Different tools for different operational constraints."
                        : "Strumenti diversi per vincoli operativi diversi.")
                </h2>

            </div>


            <div class="business-areas-list">

                <!-- ==============================================
                     BACKOFFICE
                     ============================================== -->
                <article class="premium-card business-area-card"
                         data-motif="roadmap">

                    <div class="business-area-copy">

                        <span class="business-area-number">
                            01 / OPERATIONS
                        </span>

                        <h3>
                            @(isEn
                                ? "Operational backoffice & internal tools"
                                : "Backoffice operativo e strumenti interni")
                        </h3>

                        <p>
                            @(isEn
                                ? "Custom backoffice applications can centralize department activities, approvals, operational status and information that would otherwise be scattered across email, spreadsheets and disconnected tools."
                                : "Applicazioni di backoffice custom possono centralizzare attività di reparto, approvazioni, stati operativi e informazioni che altrimenti resterebbero distribuite tra email, fogli Excel e strumenti scollegati.")
                        </p>

                        <div class="business-tags">
                            <span class="business-tag">Workflow</span>
                            <span class="business-tag">Dashboards</span>
                            <span class="business-tag">Approvals</span>
                            <span class="business-tag">Document Management</span>
                        </div>

                    </div>


                    <div class="business-area-visual"
                         aria-hidden="true">

                        <div class="business-system">

                            <div class="business-system-ring"></div>

                            <div class="business-system-core">
                                BACKOFFICE
                            </div>

                            <div class="business-node business-node--top">
                                Users
                            </div>

                            <div class="business-node business-node--right">
                                Tasks
                            </div>

                            <div class="business-node business-node--bottom">
                                Data
                            </div>

                            <div class="business-node business-node--left">
                                Rules
                            </div>

                        </div>

                    </div>

                </article>


                <!-- ==============================================
                     B2B PORTALS
                     ============================================== -->
                <article class="premium-card business-area-card business-area-card--reverse"
                         data-motif="network">

                    <div class="business-area-visual"
                         aria-hidden="true">

                        <div class="business-system">

                            <div class="business-system-ring"></div>

                            <div class="business-system-core">
                                B2B<br />PORTAL
                            </div>

                            <div class="business-node business-node--top">
                                ERP
                            </div>

                            <div class="business-node business-node--right">
                                Orders
                            </div>

                            <div class="business-node business-node--bottom">
                                Docs
                            </div>

                            <div class="business-node business-node--left">
                                Clients
                            </div>

                        </div>

                    </div>


                    <div class="business-area-copy">

                        <span class="business-area-number">
                            02 / PORTALS
                        </span>

                        <h3>
                            @(isEn
                                ? "B2B customer and supplier portals"
                                : "Portali B2B per clienti e fornitori")
                        </h3>

                        <p>
                            @(isEn
                                ? "Dedicated portals can expose selected ERP or operational information to external users without giving them direct access to internal systems, simplifying document exchange, order status and service interactions."
                                : "Portali dedicati possono esporre informazioni selezionate provenienti da ERP o sistemi operativi agli utenti esterni senza fornire accesso diretto ai sistemi interni, semplificando documenti, stato ordini e interazioni di servizio.")
                        </p>

                        <div class="business-tags">
                            <span class="business-tag">B2B</span>
                            <span class="business-tag">ERP Integration</span>
                            <span class="business-tag">Orders</span>
                            <span class="business-tag">Documents</span>
                        </div>

                    </div>

                </article>


                <!-- ==============================================
                     FIELD & MOBILE
                     ============================================== -->
                <article class="premium-card business-area-card"
                         data-motif="cloud">

                    <div class="business-area-copy">

                        <span class="business-area-number">
                            03 / FIELD
                        </span>

                        <h3>
                            @(isEn
                                ? "Mobile and field operations"
                                : "Operatività mobile e sul campo")
                        </h3>

                        <p>
                            @(isEn
                                ? "Field teams can receive assignments, collect information, update operational records and synchronize with central systems through interfaces designed around the conditions in which they actually work."
                                : "I team sul campo possono ricevere attività, raccogliere informazioni, aggiornare dati operativi e sincronizzarsi con i sistemi centrali attraverso interfacce progettate sulle reali condizioni in cui lavorano.")
                        </p>

                        <div class="business-tags">
                            <span class="business-tag">Mobile</span>
                            <span class="business-tag">Field Operations</span>
                            <span class="business-tag">Offline Workflows</span>
                            <span class="business-tag">Synchronization</span>
                        </div>

                    </div>


                    <div class="business-area-visual"
                         aria-hidden="true">

                        <div class="business-system">

                            <div class="business-system-ring"></div>

                            <div class="business-system-core">
                                FIELD<br />APP
                            </div>

                            <div class="business-node business-node--top">
                                Tasks
                            </div>

                            <div class="business-node business-node--right">
                                Mobile
                            </div>

                            <div class="business-node business-node--bottom">
                                Sync
                            </div>

                            <div class="business-node business-node--left">
                                ERP
                            </div>

                        </div>

                    </div>

                </article>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         POSITIONING
         ========================================================== -->
    <section class="business-positioning-section bg-warm-white">

        <div class="container">

            <div class="business-positioning">

                <div class="business-positioning-content">

                    <span class="section-eyebrow">
                        @(isEn
                            ? "CUSTOM WHERE IT CREATES VALUE"
                            : "CUSTOM DOVE GENERA VALORE")
                    </span>

                    <h2>
                        @(isEn
                            ? "We do not replace a good platform just to build our own."
                            : "Non sostituiamo una buona piattaforma soltanto per svilupparne una nostra.")
                    </h2>

                    <p>
                        @(isEn
                            ? "Our first choice is always to understand whether an existing SaaS, ERP module or integration can solve the problem sustainably. Custom development becomes the right option when the workflow, constraints or competitive advantage genuinely require something specific."
                            : "La prima scelta è sempre capire se un SaaS esistente, un modulo ERP o un'integrazione possono risolvere il problema in modo sostenibile. Lo sviluppo custom diventa la soluzione corretta quando workflow, vincoli o vantaggio competitivo richiedono davvero qualcosa di specifico.")
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         CTA
         ========================================================== -->
    <section class="business-cta-section premium-pale-green soft-transition transition-from-warm">

        <div class="container">

            <div class="business-cta">

                <span class="section-eyebrow">
                    @(isEn
                        ? "PROCESS · APPLICATION · INTEGRATION"
                        : "PROCESSO · APPLICAZIONE · INTEGRAZIONE")
                </span>

                <h2>
                    @(isEn
                        ? "Which workflow is still being managed around the software instead of through it?"
                        : "Quale workflow viene ancora gestito aggirando il software invece che attraverso di esso?")
                </h2>

                <p>
                    @(isEn
                        ? "Let's map the operational process, existing tools and recurring workarounds to understand whether integration, configuration or a custom application is the right answer."
                        : "Mappiamo processo operativo, strumenti esistenti e workaround ricorrenti per capire se la soluzione corretta sia integrazione, configurazione o un'applicazione custom.")
                </p>

                <a href="@(isEn ? "/en/contact" : "/contatti")"
                   class="btn btn-primary">

                    @(isEn
                        ? "Discuss your business application"
                        : "Parliamo della tua applicazione")

                </a>

            </div>

        </div>

    </section>

</div>