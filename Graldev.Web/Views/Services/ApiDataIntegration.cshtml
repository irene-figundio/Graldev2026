@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

<section class="case-study-hero">
    <div class="container">
        <span class="section-eyebrow">API & DATA INTEGRATION</span>
        <h1 class="section-title">
            @(isEn ? "Data available where it's needed, when it's needed." : "Dati disponibili dove servono, quando servono.")
        </h1>
        <p class="section-subtitle">
            @(isEn ? "We structure secure REST/SOAP APIs, webhooks, and ETL architectures to ensure flawless data synchronization across your systems." : "Progettiamo architetture API (REST/SOAP), webhook e canali ETL robusti per garantire una sincronizzazione dati costante e affidabile tra i tuoi software.")
        </p>
    </div>
</section>

<section>
    <div class="container split-layout">
        <div class="split-left">
            <h2>@(isEn ? "Structuring robust information architectures" : "Scambiare informazioni senza compromettere la consistenza")</h2>
            <p>
                @if (isEn)
                {
                    <text>In modern enterprises, data is frequently distributed in multiple distinct databases, ERPs, and cloud environments. Sincronizing this information manually is a recipe for operational disaster. We design structured API layers and transactional middleware that communicate automatically in real-time or via scheduled batches.</text>
                }
                else
                {
                    <text>Le informazioni aziendali sono spesso distribuite in database diversi, gestionali locali e applicativi cloud. Sincronizzare queste basi dati a mano o tramite esportazioni disordinate rallenta l'azienda. Graldev progetta e sviluppa canali API sicuri ed interfacce di comunicazione transazionali per allineare i dati in tempo reale.</text>
                }
            </p>
            <p>
                @if (isEn)
                {
                    <text>We pay extreme attention to structural reliability: incorporating secure authentication (OAuth, tokens), automatic retries, error logs, and performance dashboards to ensure zero data losses.</text>
                }
                else
                {
                    <text>Poniamo la massima cura sulla stabilità dell'infrastruttura: sistemi di autenticazione sicuri (OAuth, token), gestione automatica dei tentativi (retry policy), log dettagliati delle transazioni e cruscotti di controllo per monitorare lo stato di salute di tutti i flussi.</text>
                }
            </p>
        </div>
        <div class="split-right">
            <div class="premium-card">
                <h3>@(isEn ? "API & Data Competences" : "Competenze API & Dati")</h3>
                <ul style="list-style-position: inside; color: var(--text-secondary); margin-top: 1rem; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.95rem;">
                    <li>🌐 REST API, Webhooks, SOAP Web Services</li>
                    <li>🔄 Real-time and scheduled batch synchronization</li>
                    <li>💾 ETL data transformation pipelines</li>
                    <li>🔑 Secure Authentication (API keys, OAuth2)</li>
                    <li>🛡️ Auto-retry, error routing, and fail-safes</li>
                    <li>📊 Observability: logs, monitoring, and alerts</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Related cases -->
<section style="background-color: rgba(255, 255, 255, 0.01);">
    <div class="container">
        <h2>@(isEn ? "Related Case Study: Geordie" : "Case Study Correlato: Geordie")</h2>
        <p class="section-subtitle">
            @(isEn ? "See how we applied complex API and Data Integration to synchronize inventory and orders across global sales channels." : "Scopri come abbiamo applicato l'integrazione dati e lo sviluppo di API per allineare store e magazzini complessi.")
        </p>
        <a href="@(isEn ? "/en/case-studies/geordie" : "/case-study/geordie")" class="btn btn-outline">
            @(isEn ? "Read Geordie Case Study" : "Scopri Geordie")
        </a>
    </div>
</section>
