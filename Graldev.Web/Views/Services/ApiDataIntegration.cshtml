@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

<section class="case-study-hero" style="padding-bottom: 2rem;">
    <div class="container">
        <span class="section-eyebrow">API & DATA INTEGRATION</span>
        <h1 class="section-title" style="font-weight: 900; line-height: 1.15; margin-bottom: 0.75rem;">
            @(isEn ? "Data available where it's needed, when it's needed." : "Dati disponibili dove servono, quando servono.")
        </h1>
        <p class="section-subtitle" style="max-width: 700px; font-size: 1.1rem; line-height: 1.5; margin-bottom: 1.5rem;">
            @(isEn ? "We engineer reliable REST/SOAP APIs, webhook triggers, and automated ETL pipelines to sync corporate databases and SaaS applications in real time." : "Progettiamo e sviluppiamo connettori API REST/SOAP, webhook e pipeline ETL per sincronizzare database aziendali e piattaforme SaaS.")
        </p>
        <a href="@(isEn ? "/en/contact" : "/contatti")" class="btn btn-primary" style="padding: 0.75rem 1.5rem; font-size: 0.95rem;">
            @(isEn ? "Let's talk about your needs" : "Parliamo della tua esigenza")
        </a>
    </div>
</section>

<!-- Visual Data Flow Pipeline Diagram -->
<section class="white-section" style="padding: 3rem 0;">
    <div class="container">
        <div style="text-align: center; margin-bottom: 2.5rem;">
            <span class="section-eyebrow">PIPELINE MAP</span>
            <h2 style="font-weight: 900; font-size: 2rem; margin-bottom: 0.5rem;">@(isEn ? "Automated Secure Data Pipelines" : "Architettura dei flussi dati sincronizzati")</h2>
        </div>

        <div class="flow-comparison">
            <!-- Sources -->
            <div class="card-glass" style="text-align: center; padding: 1.25rem;">
                <h4 style="font-size: 1.1rem; color: var(--brand-green-dark); margin-bottom: 0.75rem;">SOURCES</h4>
                <div style="display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem; font-weight: 700;">
                    <div class="card-neomorphic">ERP Database</div>
                    <div class="card-neomorphic">CRM Contacts</div>
                    <div class="card-neomorphic">Shopify Listings</div>
                </div>
            </div>

            <!-- Webhook Connection Line -->
            <div class="flow-arrow-container" style="flex-direction: column; gap: 0.5rem;">
                <span style="font-size: 0.75rem; font-weight: 800; color: var(--brand-green); text-transform: uppercase;">TRANSFORM</span>
                <span class="data-pulse" style="display: inline-block; font-size: 2rem;">⇅</span>
                <span style="font-size: 0.75rem; font-weight: 800; color: var(--brand-green); text-transform: uppercase;">SYNC</span>
            </div>

            <!-- Target Systems -->
            <div class="card-glass" style="text-align: center; padding: 1.25rem;">
                <h4 style="font-size: 1.1rem; color: var(--brand-green-dark); margin-bottom: 0.75rem;">TARGET</h4>
                <div style="display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem; font-weight: 700;">
                    <div class="card-neomorphic">Dashboard Panels</div>
                    <div class="card-neomorphic">External Marketplace</div>
                    <div class="card-neomorphic">Private AI Vaults</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Scannable specs -->
<section class="alt-section" style="padding: 3rem 0;">
    <div class="container split-layout" style="align-items: center;">
        <div class="split-left" style="max-width: 550px;">
            <span class="section-eyebrow">FEATURES</span>
            <h2 style="font-weight: 900; font-size: 2rem;">@(isEn ? "API Architectures We Deploy" : "Architetture API stabili e sicure")</h2>
            <p style="font-size: 1rem; line-height: 1.5; margin-bottom: 1.5rem;">
                @(isEn ? "All our API integrations feature real-time health-checks, automatic retries, strict error log alert systems, and encrypted storage." : "Progettiamo connettori dotati di log automatici, gestione delle eccezioni e crittografia end-to-end dei dati sensibili.")
            </p>
        </div>
        <div class="split-right">
            <div class="grid-2" style="gap: 1rem;">
                <div class="card-base" style="padding: 1rem;">
                    <h4 style="font-size: 1.05rem; margin-bottom: 0.25rem;">📡 REST & Webhooks</h4>
                    <p style="font-size: 0.85rem; line-height: 1.4; margin-bottom: 0;">@(isEn ? "Fast, lightweight real-time communications." : "Sincronizzazioni veloci guidate da eventi.")</p>
                </div>
                <div class="card-base" style="padding: 1rem;">
                    <h4 style="font-size: 1.05rem; margin-bottom: 0.25rem;">🔒 Dynamic OAuth</h4>
                    <p style="font-size: 0.85rem; line-height: 1.4; margin-bottom: 0;">@(isEn ? "Secure encrypted authentication layers." : "Autenticazione solida tramite chiavi e token protetti.")</p>
                </div>
            </div>
        </div>
    </div>
</section>
