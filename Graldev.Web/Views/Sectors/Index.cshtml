@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

@section Style {
    <link rel="stylesheet" href="~/css/graldev-premium-shared.css" asp-append-version="true" />
}

<section class="consulting-hero metal-v3-section" data-metal-v3="sectors-hub-hero">
    <div class="hero-metal-pattern-wrap" aria-hidden="true">
        <svg class="hero-metal-pattern-svg"
             viewBox="0 0 1600 1000"
             preserveAspectRatio="xMidYMid slice"
             focusable="false"
             xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="sectorsGoldBase"
                                x1="0"
                                y1="0"
                                x2="1600"
                                y2="1000"
                                gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#8f651c" />
                    <stop offset="18%" stop-color="#d4a93d" />
                    <stop offset="34%" stop-color="#fff0a8" />
                    <stop offset="46%" stop-color="#b77d16" />
                    <stop offset="62%" stop-color="#f5d56d" />
                    <stop offset="79%" stop-color="#9e6b16" />
                    <stop offset="100%" stop-color="#e1b84d" />
                </linearGradient>

                <linearGradient id="sectorsMetalHighlight"
                                x1="0"
                                y1="0"
                                x2="1"
                                y2="1">
                    <stop offset="0%" stop-color="#c68c19" />
                    <stop offset="28%" stop-color="#ffe793" />
                    <stop offset="46%" stop-color="#ffffff" />
                    <stop offset="58%" stop-color="#fff0ad" />
                    <stop offset="78%" stop-color="#d8a42d" />
                    <stop offset="100%" stop-color="#a26a12" />
                </linearGradient>

                <radialGradient id="sectorsShineMaskGradient">
                    <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                    <stop offset="38%" stop-color="#ffffff" stop-opacity=".98" />
                    <stop offset="68%" stop-color="#ffffff" stop-opacity=".42" />
                    <stop offset="100%" stop-color="#000000" stop-opacity="0" />
                </radialGradient>

                <mask id="sectorsShineMask"
                      maskUnits="userSpaceOnUse"
                      x="0"
                      y="0"
                      width="1600"
                      height="1000">
                    <rect width="1600" height="1000" fill="#000000" />
                    <circle class="hero-metal-shine-circle"
                            cx="800"
                            cy="350"
                            r="280"
                            fill="url(#sectorsShineMaskGradient)" />
                </mask>

                <filter id="sectorsEmboss"
                        x="-20%"
                        y="-20%"
                        width="140%"
                        height="140%">
                    <feDropShadow dx="0"
                                  dy="1"
                                  stdDeviation=".7"
                                  flood-color="#ffffff"
                                  flood-opacity=".72" />
                    <feDropShadow dx="0"
                                  dy="2"
                                  stdDeviation="1.6"
                                  flood-color="#7c5517"
                                  flood-opacity=".14" />
                </filter>

                <symbol id="sectorsMetalMotif" viewBox="0 0 520 520">
                    <path d="
                    M260 0 L520 155 L520 390 L260 520 L0 390 L0 155 Z
                    M260 92 L392 170 L392 334 L260 412 L128 334 L128 170 Z
                    M260 166 L326 205 L326 286 L260 326 L194 286 L194 205 Z
                    M260 0 L260 92
                    M0 155 L128 232
                    M520 155 L392 232
                    M0 390 L128 313
                    M520 390 L392 313
                    M260 412 L260 520
                    " />
                </symbol>
            </defs>

            <g class="hero-metal-pattern-soft">
                <use href="#sectorsMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#sectorsMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#sectorsMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#sectorsMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#sectorsMetalMotif" x="790" y="380" width="540" height="540" />
            </g>

            <g class="hero-metal-pattern-base"
               style="stroke:url(#sectorsGoldBase);filter:url(#sectorsEmboss);">
                <use href="#sectorsMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#sectorsMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#sectorsMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#sectorsMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#sectorsMetalMotif" x="790" y="380" width="540" height="540" />
            </g>

            <g class="hero-metal-pattern-shine"
               style="stroke:url(#sectorsMetalHighlight);mask:url(#sectorsShineMask);">
                <use href="#sectorsMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#sectorsMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#sectorsMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#sectorsMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#sectorsMetalMotif" x="790" y="380" width="540" height="540" />
            </g>
        </svg>
    </div>

    <div class="container">
        <!-- Breadcrumbs -->
        <nav aria-label="Breadcrumb" class="premium-breadcrumb" style="margin-bottom: 1.5rem;">
            <ol style="display: flex; gap: 0.5rem; list-style: none; padding: 0; margin: 0; font-size: 0.85rem; font-weight: 600;">
                <li><a href="@(isEn ? "/en" : "/")" style="color: var(--brand-green); text-decoration: none;">Home</a></li>
                <li style="color: var(--text-soft);">&gt;</li>
                <li style="color: var(--text-soft);" aria-current="page">@(isEn ? "Sectors" : "Settori")</li>
            </ol>
        </nav>

        <span class="section-eyebrow">@(isEn ? "INDUSTRIES & VERTICALS" : "SETTORI DI INTERVENTO")</span>
        <h1 class="section-title">
            @(isEn ? "Applied technical consulting across complex sectors." : "Consulenza tecnologica applicata a settori complessi.")
        </h1>
        <p class="section-subtitle">
            @(isEn ? "We support organizations and medium-to-large enterprises in Industry, Retail, eCommerce and Telecommunications." : "Affianchiamo organizzazioni e medie-grandi imprese nei settori dell'Industria, del Retail, dell'eCommerce e delle Telecomunicazioni.")
        </p>
    </div>
</section>

<section class="consulting-main-section premium-pale-green soft-transition transition-from-warm">
    <div class="container">
        <div class="consulting-related-grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
            <!-- Sector 1: Industria -->
            <div class="premium-card" data-motif="roadmap">
                <div>
                    <span style="font-size: 2.5rem; margin-bottom: 1rem; display: block;" aria-hidden="true">🏗️</span>
                    <h3 style="color: var(--brand-green-dark); font-size: 1.45rem; margin-bottom: 0.75rem;">@(isEn ? "Industry" : "Industria")</h3>
                    <p style="color: var(--text-soft); font-size: 0.95rem; line-height: 1.65;">
                        @(isEn ? "Optimizing production data flows, hardware/software sensor integration, process automation, and stock control." : "Ottimizzazione dei flussi produttivi, integrazione di sensori hardware/software, automazione di processo e controllo reparti.")
                    </p>
                </div>
                <a href="@(isEn ? "/en/sectors/industry" : "/settori/industria")" class="premium-card-link" style="margin-top: 1.5rem;">@(isEn ? "Explore Sector" : "Scopri il Settore")</a>
            </div>

            <!-- Sector 2: Retail & eCommerce -->
            <div class="premium-card" data-motif="network">
                <div>
                    <span style="font-size: 2.5rem; margin-bottom: 1rem; display: block;" aria-hidden="true">🛒</span>
                    <h3 style="color: var(--brand-green-dark); font-size: 1.45rem; margin-bottom: 0.75rem;">Retail & eCommerce</h3>
                    <p style="color: var(--text-soft); font-size: 0.95rem; line-height: 1.65;">
                        @(isEn ? "Connecting enterprise ERP databases with Shopify, Amazon, and eBay, streamlining omnichannel logistics." : "Integrazione dei database gestionali con Shopify, Amazon ed eBay, velocizzando i flussi di logistica multicanale.")
                    </p>
                </div>
                <a href="@(isEn ? "/en/sectors/retail-ecommerce" : "/settori/retail-ecommerce")" class="premium-card-link" style="margin-top: 1.5rem;">@(isEn ? "Explore Sector" : "Scopri il Settore")</a>
            </div>

            <!-- Sector 3: Telco -->
            <div class="premium-card" data-motif="cloud">
                <div>
                    <span style="font-size: 2.5rem; margin-bottom: 1rem; display: block;" aria-hidden="true">📡</span>
                    <h3 style="color: var(--brand-green-dark); font-size: 1.45rem; margin-bottom: 0.75rem;">Telco</h3>
                    <p style="color: var(--text-soft); font-size: 0.95rem; line-height: 1.65;">
                        @(isEn ? "Structuring scalable system architectures, API marketplaces, and transactional pipelines for telecom systems." : "Architetture d'integrazione scalabili, marketplace di API e canali transazionali per operatori di telecomunicazioni.")
                    </p>
                </div>
                <a href="@(isEn ? "/en/sectors/telco" : "/settori/telco")" class="premium-card-link" style="margin-top: 1.5rem;">@(isEn ? "Explore Sector" : "Scopri il Settore")</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/graldev-metal-v3.js" asp-append-version="true"></script>
}
