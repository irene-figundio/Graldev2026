@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

@section Style {
    <link rel="stylesheet" href="~/css/graldev-premium-shared.css" asp-append-version="true" />
}

<section class="consulting-hero metal-v3-section" data-metal-v3="telco-vertical-hero">
    <div class="hero-metal-pattern-wrap" aria-hidden="true">
        <svg class="hero-metal-pattern-svg"
             viewBox="0 0 1600 1000"
             preserveAspectRatio="xMidYMid slice"
             focusable="false"
             xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="telcoGoldBase"
                                x1="0"
                                y1="0"
                                x2="1600"
                                y2="1000"
                                gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#8f651c" />
                    <stop offset="18%" stop-color="#d4a93d" />
                    <stop offset="34%" stop-color="#fff0a8" />
                    <stop offset="46%" stop-color="#b77d16" />
                    <stop offset="62%" stop-color="#f5d56d" />
                    <stop offset="79%" stop-color="#9e6b16" />
                    <stop offset="100%" stop-color="#e1b84d" />
                </linearGradient>

                <linearGradient id="telcoMetalHighlight"
                                x1="0"
                                y1="0"
                                x2="1"
                                y2="1">
                    <stop offset="0%" stop-color="#c68c19" />
                    <stop offset="28%" stop-color="#ffe793" />
                    <stop offset="46%" stop-color="#ffffff" />
                    <stop offset="58%" stop-color="#fff0ad" />
                    <stop offset="78%" stop-color="#d8a42d" />
                    <stop offset="100%" stop-color="#a26a12" />
                </linearGradient>

                <radialGradient id="telcoShineMaskGradient">
                    <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                    <stop offset="38%" stop-color="#ffffff" stop-opacity=".98" />
                    <stop offset="68%" stop-color="#ffffff" stop-opacity=".42" />
                    <stop offset="100%" stop-color="#000000" stop-opacity="0" />
                </radialGradient>

                <mask id="telcoShineMask"
                      maskUnits="userSpaceOnUse"
                      x="0"
                      y="0"
                      width="1600"
                      height="1000">
                    <rect width="1600" height="1000" fill="#000000" />
                    <circle class="hero-metal-shine-circle"
                            cx="800"
                            cy="350"
                            r="280"
                            fill="url(#telcoShineMaskGradient)" />
                </mask>

                <filter id="telcoEmboss"
                        x="-20%"
                        y="-20%"
                        width="140%"
                        height="140%">
                    <feDropShadow dx="0"
                                  dy="1"
                                  stdDeviation=".7"
                                  flood-color="#ffffff"
                                  flood-opacity=".72" />
                    <feDropShadow dx="0"
                                  dy="2"
                                  stdDeviation="1.6"
                                  flood-color="#7c5517"
                                  flood-opacity=".14" />
                </filter>

                <symbol id="telcoMetalMotif" viewBox="0 0 520 520">
                    <path d="
                    M260 0 L520 155 L520 390 L260 520 L0 390 L0 155 Z
                    M260 92 L392 170 L392 334 L260 412 L128 334 L128 170 Z
                    M260 166 L326 205 L326 286 L260 326 L194 286 L194 205 Z
                    M260 0 L260 92
                    M0 155 L128 232
                    M520 155 L392 232
                    M0 390 L128 313
                    M520 390 L392 313
                    M260 412 L260 520
                    " />
                </symbol>
            </defs>

            <g class="hero-metal-pattern-soft">
                <use href="#telcoMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#telcoMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#telcoMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#telcoMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#telcoMetalMotif" x="790" y="380" width="540" height="540" />
            </g>

            <g class="hero-metal-pattern-base"
               style="stroke:url(#telcoGoldBase);filter:url(#telcoEmboss);">
                <use href="#telcoMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#telcoMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#telcoMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#telcoMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#telcoMetalMotif" x="790" y="380" width="540" height="540" />
            </g>

            <g class="hero-metal-pattern-shine"
               style="stroke:url(#telcoMetalHighlight);mask:url(#telcoShineMask);">
                <use href="#telcoMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#telcoMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#telcoMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#telcoMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#telcoMetalMotif" x="790" y="380" width="540" height="540" />
            </g>
        </svg>
    </div>

    <div class="container">
        <!-- Breadcrumbs -->
        <nav aria-label="Breadcrumb" class="premium-breadcrumb" style="margin-bottom: 1.5rem;">
            <ol style="display: flex; gap: 0.5rem; list-style: none; padding: 0; margin: 0; font-size: 0.85rem; font-weight: 600;">
                <li><a href="@(isEn ? "/en" : "/")" style="color: var(--brand-green); text-decoration: none;">Home</a></li>
                <li style="color: var(--text-soft);">&gt;</li>
                <li><a href="@(isEn ? "/en/sectors" : "/settori")" style="color: var(--brand-green); text-decoration: none;">@(isEn ? "Sectors" : "Settori")</a></li>
                <li style="color: var(--text-soft);">&gt;</li>
                <li style="color: var(--text-soft);" aria-current="page">Telco</li>
            </ol>
        </nav>

        <span class="section-eyebrow">@(isEn ? "TELECOM VERTICAL" : "SETTORE TELECOMUNICAZIONI")</span>
        <h1 class="section-title">
            @(isEn ? "IT Consulting & Architectural Scalability for Telco" : "Consulenza Informatica e Scalabilità per le Telco")
        </h1>
        <p class="section-subtitle">
            @(isEn ? "Designing high-availability transactional pipelines, secure API marketplaces, and scalable system integration layers." : "Ingegnerizzazione di architetture dati ad alta disponibilità, marketplace di API sicuri e solidi layer d'integrazione per sistemi telco.")
        </p>
    </div>
</section>

<section class="consulting-main-section premium-pale-green soft-transition transition-from-warm">
    <div class="container split-layout">
        <div class="split-left">
            <h2>@(isEn ? "Robust architecture for high-concurrency systems" : "Architetture resilienti per grandi flussi di traffico")</h2>
            <p>
                @if (isEn)
                {
                    <text>Telecommunications companies manage massive, continuous streams of data and transactions every second. System breakdowns or latency overheads result in critical business losses. Graldev acts as the technical partner and IT consulting company to help you assess, design, and modernize technical infrastructure under high-concurrency constraints, using microservices, modern APIs, and asynchronous queuing pipelines.</text>
                }
                else
                {
                    <text>Le società di telecomunicazioni elaborano flussi ingenti di transazioni e richieste dati ad ogni secondo. Rallentamenti o interruzioni generano disagi immediati. Graldev supporta il settore Telco offrendo consulenza di alto livello sull'assessment del codice, scomposizione di monolitici in microservizi, ottimizzazione di code transazionali asincrone e disegno di API stabili capaci di sopportare carichi elevatissimi.</text>
                }
            </p>
            <p>
                @if (isEn)
                {
                    <text>We pay profound attention to security headers, data structures validation, and high-availability cloud configurations (zero-downtime deployments) to ensure technical due diligence is fully met.</text>
                }
                else
                {
                    <text>Garantiamo la massima robustezza: gestione accurata degli header di sicurezza, validazione transazionale dei database e configurazioni Cloud ad alta affidabilità (zero-downtime deployment) per rispettare i requisiti di audit tecnologici complessi.</text>
                }
            </p>
        </div>
        <div class="split-right">
            <div class="premium-card" data-motif="cloud" style="padding: 2rem; border-radius: 22px;">
                <h3 style="color: var(--brand-green-dark); font-size: 1.3rem; margin-bottom: 1rem;">@(isEn ? "Core Technical Focus" : "Focus Tecnologico")</h3>
                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.95rem; color: var(--text-soft);">
                    <li style="position: relative; padding-left: 1.5rem;">
                        <span style="position: absolute; left: 0; color: var(--brand-green);">✔</span>
                        @(isEn ? "High-concurrency Web API Design & Security" : "Progettazione e sicurezza di API Web ad alto traffico")
                    </li>
                    <li style="position: relative; padding-left: 1.5rem;">
                        <span style="position: absolute; left: 0; color: var(--brand-green);">✔</span>
                        @(isEn ? "Asynchronous Message Queuing (RabbitMQ, Kafka, Azure Service Bus)" : "Message Queuing asincrono (RabbitMQ, Kafka, Azure Service Bus)")
                    </li>
                    <li style="position: relative; padding-left: 1.5rem;">
                        <span style="position: absolute; left: 0; color: var(--brand-green);">✔</span>
                        @(isEn ? "Database scaling and performance tuning" : "Scalabilità dei database e sintonizzazione delle prestazioni")
                    </li>
                    <li style="position: relative; padding-left: 1.5rem;">
                        <span style="position: absolute; left: 0; color: var(--brand-green);">✔</span>
                        @(isEn ? "Systems Technical Due Diligence & Code Audits" : "Due Diligence tecnica dei sistemi e controlli di codice")
                    </li>
                    <li style="position: relative; padding-left: 1.5rem;">
                        <span style="position: absolute; left: 0; color: var(--brand-green);">✔</span>
                        @(isEn ? "Redundant Cloud-Native Microservices" : "Microservizi cloud-native ridondanti")
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="consulting-main-section bg-warm-white" style="text-align: center;">
    <div class="container">
        <h2 style="color: var(--brand-green-dark); font-size: clamp(2rem, 3.5vw, 3rem); letter-spacing: -0.04em; margin-bottom: 1rem;">
            @(isEn ? "Consult with our senior technical architects" : "Parla con i nostri architetti senior")
        </h2>
        <p style="max-width: 600px; margin: 0 auto 2rem auto; color: var(--text-soft); line-height: 1.6;">
            @(isEn ? "Discuss technical bottlenecks, code optimization, or microservices migration with Graldev senior advisors." : "Affronta debito tecnico, colli di bottiglia o migrazione a microservizi con i consulenti Graldev.")
        </p>
        <a href="@(isEn ? "/en/contact" : "/contatti")" class="btn btn-primary" style="padding: 0.85rem 2rem;">
            @(isEn ? "Parliamo della tua esigenza" : "Parliamo della tua esigenza")
        </a>
    </div>
</section>

@section Scripts {
    <script src="~/js/graldev-metal-v3.js" asp-append-version="true"></script>
}
