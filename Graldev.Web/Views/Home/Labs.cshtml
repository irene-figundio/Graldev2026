@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

@section Style {
    <link rel="stylesheet" href="~/css/graldev-premium-shared.css" asp-append-version="true" />
}

<section class="consulting-hero metal-v3-section" data-metal-v3="labs-hero">
    <div class="hero-metal-pattern-wrap" aria-hidden="true">
        <svg class="hero-metal-pattern-svg"
             viewBox="0 0 1600 1000"
             preserveAspectRatio="xMidYMid slice"
             focusable="false"
             xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="labsGoldBase"
                                x1="0"
                                y1="0"
                                x2="1600"
                                y2="1000"
                                gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#8f651c" />
                    <stop offset="18%" stop-color="#d4a93d" />
                    <stop offset="34%" stop-color="#fff0a8" />
                    <stop offset="46%" stop-color="#b77d16" />
                    <stop offset="62%" stop-color="#f5d56d" />
                    <stop offset="79%" stop-color="#9e6b16" />
                    <stop offset="100%" stop-color="#e1b84d" />
                </linearGradient>

                <linearGradient id="labsMetalHighlight"
                                x1="0"
                                y1="0"
                                x2="1"
                                y2="1">
                    <stop offset="0%" stop-color="#c68c19" />
                    <stop offset="28%" stop-color="#ffe793" />
                    <stop offset="46%" stop-color="#ffffff" />
                    <stop offset="58%" stop-color="#fff0ad" />
                    <stop offset="78%" stop-color="#d8a42d" />
                    <stop offset="100%" stop-color="#a26a12" />
                </linearGradient>

                <radialGradient id="labsShineMaskGradient">
                    <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                    <stop offset="38%" stop-color="#ffffff" stop-opacity=".98" />
                    <stop offset="68%" stop-color="#ffffff" stop-opacity=".42" />
                    <stop offset="100%" stop-color="#000000" stop-opacity="0" />
                </radialGradient>

                <mask id="labsShineMask"
                      maskUnits="userSpaceOnUse"
                      x="0"
                      y="0"
                      width="1600"
                      height="1000">
                    <rect width="1600" height="1000" fill="#000000" />
                    <circle class="hero-metal-shine-circle"
                            cx="800"
                            cy="350"
                            r="280"
                            fill="url(#labsShineMaskGradient)" />
                </mask>

                <filter id="labsEmboss"
                        x="-20%"
                        y="-20%"
                        width="140%"
                        height="140%">
                    <feDropShadow dx="0"
                                  dy="1"
                                  stdDeviation=".7"
                                  flood-color="#ffffff"
                                  flood-opacity=".72" />
                    <feDropShadow dx="0"
                                  dy="2"
                                  stdDeviation="1.6"
                                  flood-color="#7c5517"
                                  flood-opacity=".14" />
                </filter>

                <symbol id="labsMetalMotif" viewBox="0 0 520 520">
                    <path d="
                    M260 0 L520 155 L520 390 L260 520 L0 390 L0 155 Z
                    M260 92 L392 170 L392 334 L260 412 L128 334 L128 170 Z
                    M260 166 L326 205 L326 286 L260 326 L194 286 L194 205 Z
                    M260 0 L260 92
                    M0 155 L128 232
                    M520 155 L392 232
                    M0 390 L128 313
                    M520 390 L392 313
                    M260 412 L260 520
                    " />
                </symbol>
            </defs>

            <g class="hero-metal-pattern-soft">
                <use href="#labsMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#labsMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#labsMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#labsMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#labsMetalMotif" x="790" y="380" width="540" height="540" />
            </g>

            <g class="hero-metal-pattern-base"
               style="stroke:url(#labsGoldBase);filter:url(#labsEmboss);">
                <use href="#labsMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#labsMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#labsMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#labsMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#labsMetalMotif" x="790" y="380" width="540" height="540" />
            </g>

            <g class="hero-metal-pattern-shine"
               style="stroke:url(#labsMetalHighlight);mask:url(#labsShineMask);">
                <use href="#labsMetalMotif" x="-20" y="-110" width="540" height="540" />
                <use href="#labsMetalMotif" x="520" y="-110" width="540" height="540" />
                <use href="#labsMetalMotif" x="1060" y="-110" width="540" height="540" />
                <use href="#labsMetalMotif" x="250" y="380" width="540" height="540" />
                <use href="#labsMetalMotif" x="790" y="380" width="540" height="540" />
            </g>
        </svg>
    </div>

    <div class="container">
        <!-- Breadcrumbs -->
        <nav aria-label="Breadcrumb" class="premium-breadcrumb" style="margin-bottom: 1.5rem;">
            <ol style="display: flex; gap: 0.5rem; list-style: none; padding: 0; margin: 0; font-size: 0.85rem; font-weight: 600;">
                <li><a href="@(isEn ? "/en" : "/")" style="color: var(--brand-green); text-decoration: none;">Home</a></li>
                <li style="color: var(--text-soft);">&gt;</li>
                <li style="color: var(--text-soft);" aria-current="page">Labs</li>
            </ol>
        </nav>

        <span class="section-eyebrow">@(isEn ? "GRALDEV LABS" : "LABORATORI DI RICERCA")</span>
        <h1 class="section-title">Graldev Labs</h1>
        <p class="section-subtitle">
            @(isEn ? "Experimental tech, interactive gaming, educational tools, and applied interactive research." : "Tecnologie sperimentali, gaming interattivo, strumenti educational e ricerca applicata.")
        </p>
    </div>
</section>

<section class="consulting-main-section premium-pale-green soft-transition transition-from-warm">
    <div class="container split-layout">
        <div class="split-left">
            <span class="section-eyebrow">EXPERIMENTAL SOCIAL</span>
            <h2 style="color: var(--brand-green-dark); margin-bottom: 1rem;">Ludirex (Beta)</h2>
            <p style="color: var(--text-soft); line-height: 1.75; font-size: 1.05rem; margin-bottom: 2rem;">
                @if (isEn)
                {
                    <text>Ludirex is an experimental gaming community social network. Built to connect online players from around the world, it provides a 'digital courtyard' where gamers can find teammates, organize guilds, share highlights, and form gaming alliances based on shared game passions.</text>
                }
                else
                {
                    <text>Ludirex (Beta) è una piattaforma social sperimentale pensata per la comunità dei videogiocatori di tutto il mondo. Un “cortile digitale” in cui i player possono interagire, conoscersi, trovare compagni di squadra, coordinare alleanze e scambiare opinioni sulla base delle proprie passioni videoludiche.</text>
                }
            </p>
            <div>
                <a href="https://www.ludirex.com" target="_blank" rel="noopener" class="btn btn-outline" style="padding: 0.8rem 1.6rem;">
                    @(isEn ? "Visit Ludirex Beta" : "Visita Ludirex Beta")
                </a>
            </div>
        </div>
        <div class="split-right" style="text-align: center; display: grid; place-items: center;">
            <div class="premium-card" data-motif="roadmap" style="width: 100%; max-width: 320px; height: 260px; display: grid; place-items: center; border-radius: 24px;">
                <span style="font-size: 5.5rem; filter: drop-shadow(0 0 24px rgba(59, 130, 246, 0.25));" aria-hidden="true">🎮</span>
            </div>
        </div>
    </div>
</section>

<section class="consulting-main-section bg-warm-white soft-transition transition-from-green">
    <div class="container split-layout" style="direction: rtl;">
        <div class="split-left" style="direction: ltr; text-align: left;">
            <span class="section-eyebrow">INTERACTIVE EDUCATION</span>
            <h2 style="color: var(--brand-green-dark); margin-bottom: 1rem;">Parcor</h2>
            <p style="color: var(--text-soft); line-height: 1.75; font-size: 1.05rem;">
                @if (isEn)
                {
                    <text>Parcor is an interactive mobile-based application designed as part of the 'Segni Project'. In partnership with corporate kindergartens and local institutions, it enables families, educators, and organizations to interact, share educational news, and streamline communications securely.</text>
                }
                else
                {
                    <text>Parcor è un'applicazione interattiva e web-based nata per il Progetto Segni, relativo al mondo dei nidi interaziendali lucani. Uno strumento digitale agile che permette a famiglie, educatori e istituzioni di connettersi, condividere notizie, e facilitare comunicazioni organizzate e protette.</text>
                }
            </p>
        </div>
        <div class="split-right" style="direction: ltr; text-align: center; display: grid; place-items: center;">
            <div class="premium-card" data-motif="ai" style="width: 100%; max-width: 320px; height: 260px; display: grid; place-items: center; border-radius: 24px;">
                <span style="font-size: 5.5rem; filter: drop-shadow(0 0 24px rgba(6, 182, 212, 0.25));" aria-hidden="true">📱</span>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/graldev-metal-v3.js" asp-append-version="true"></script>
}
