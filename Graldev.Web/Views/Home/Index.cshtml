    <div class="container">
        <div style="text-align: center; margin-bottom: 3.5rem;">
            <span class="dp-section-eyebrow">@(isEn ? "PRACTICES" : "PRATICHE")</span>
            <h2 class="dp-section-title" style="margin: 0 auto;">@(isEn ? "Le Aree di Competenza" : "Le Aree di Competenza")</h2>
        </div>

        <div class="dp-bento-grid" style="display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px;">
            <!-- Card 1: IT Consulting (Bento Big) -->
            <div class="dp-bento-card dp-bc-lg-1" style="grid-column: span 8; grid-row: span 2; display: flex; flex-direction: column; justify-content: space-between;">
                <div class="dp-bento-card-header">
                    <span class="dp-bento-card-eyebrow">Assessment & Strategy</span>
                    <h3 class="dp-bento-card-title" style="font-size: 1.8rem; margin-bottom: 0.5rem;">@(isEn ? "IT Consulting" : "Consulenza Informatica")</h3>
                    <p class="dp-bento-card-desc" style="max-width: 480px;">
                        @(isEn ? "Analyzing infrastructures, planning future-proof architectures, and build-vs-buy software audits." : "Assessment tecnico per mappare i processi, modernizzare sistemi obsoleti, strutturare roadmap di integrazione e decidere consapevolmente tra Build, Buy o Integrate.")
