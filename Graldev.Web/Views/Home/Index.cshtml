<section id="geometric-cta" class="site-section geometric-wallpaper-section" style="padding: 6rem 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
    <!-- Static, highly-sophisticated irregular gold lines geometric wallpaper SVG -->
    <svg class="geometric-svg-backdrop" viewBox="0 0 1440 600" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <linearGradient id="goldGlowGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="var(--champagne-gold)" />
                <stop offset="50%" stop-color="#fff5db" />
                <stop offset="100%" stop-color="var(--champagne-gold)" />
            </linearGradient>
        </defs>

        <!-- Elegant irregular architectural line segments -->
        <path class="geometric-line-base" d="M -50,150 L 350,100 L 600,280 L 1100,180 L 1550,300" />
        <path class="geometric-line-base" d="M 150,550 L 500,420 L 800,520 L 1250,320 L 1550,450" />
        <path class="geometric-line-base" d="M 250,-50 L 550,180 L 950,50 L 1350,220" />
        <path class="geometric-line-base" d="M 50,280 L 400,320 L 750,150 L 1050,420 L 1490,250" />

        <!-- Glow overlays (these advance along paths strictly linked to scroll coordinates) -->
        <path class="geometric-line-glow" id="glowPath1" d="M -50,150 L 350,100 L 600,280 L 1100,180 L 1550,300" />
        <path class="geometric-line-glow" id="glowPath2" d="M 150,550 L 500,420 L 800,520 L 1250,320 L 1550,450" />
        <path class="geometric-line-glow" id="glowPath3" d="M 250,-50 L 550,180 L 950,50 L 1350,220" />
        <path class="geometric-line-glow" id="glowPath4" d="M 50,280 L 400,320 L 750,150 L 1050,420 L 1490,250" />
    </svg>

    <div class="container" style="position: relative; z-index: 10;">
        <div class="glass-panel" style="max-width: 850px; margin: 0 auto; padding: 4rem var(--spacing-md); text-align: center; background-color: rgba(250, 247, 242, 0.88); border-color: rgba(197, 160, 89, 0.3); border-radius: var(--radius-xl);">
