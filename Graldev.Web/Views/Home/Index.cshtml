                </div>
                <div class="dp-bento-card-footer">
                    <a href="@(isEn ? "/en/services/system-integration" : "/servizi/system-integration")" class="dp-bento-link">@(isEn ? "Explore Area" : "Scopri l'Area") <span>→</span></a>
                </div>
            </div>

            <!-- Card 3: AI Integration -->
            <div class="dp-bento-card dp-bc-md-2" style="grid-column: span 4; grid-row: span 1;">
                <div class="dp-bento-card-header">
                    <span class="dp-bento-card-eyebrow">Intelligent Workflow</span>
                    <h3 class="dp-bento-card-title">AI Integration</h3>
                    <p class="dp-bento-card-desc">
                        @(isEn ? "Rendiamo intelligenti i workflow interni integrando LLM e Knowledge Base." : "Rendiamo intelligenti i workflow interni integrando LLM e Knowledge Base proprietarie.")
                    </p>
                </div>
                <div class="dp-bento-card-footer">
                    <a href="@(isEn ? "/en/services/ai-integration" : "/servizi/ai-integration")" class="dp-bento-link">@(isEn ? "Explore Area" : "Scopri l'Area") <span>→</span></a>
                </div>
            </div>

            <!-- Card 4: Software Engineering -->
            <div class="dp-bento-card dp-bc-sm-1" style="grid-column: span 4;">
