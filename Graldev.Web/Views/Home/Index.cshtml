@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}


@section Style {
    <style>
        .metal-v3-section {
            position: relative;
            overflow: hidden;
            isolation: isolate;
            background:
                radial-gradient(
                    circle at 52% 28%,
                    rgba(255, 255, 255, 0.97) 0%,
                    rgba(250, 246, 238, 0.95) 34%,
                    rgba(244, 237, 225, 0.99) 100%
                ) !important;
            --hero-metal-mx: 50%;
            --hero-metal-my: 40%;
        }

        .metal-v3-section::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background:
                radial-gradient(
                    circle at var(--hero-metal-mx) var(--hero-metal-my),
                    rgba(255, 255, 255, 0.34) 0%,
                    rgba(255, 239, 181, 0.13) 10%,
                    transparent 26%
                ),
                linear-gradient(
                    180deg,
                    rgba(255, 255, 255, 0.10),
                    rgba(245, 238, 226, 0.08)
                );
        }

        .metal-v3-section > .container {
            position: relative;
            z-index: 2;
        }

        .hero-metal-pattern-wrap {
            position: absolute;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
            contain: paint;
        }

        .hero-metal-pattern-svg {
            width: 100%;
            height: 100%;
            display: block;
        }

        .hero-metal-pattern-base,
        .hero-metal-pattern-shine,
        .hero-metal-pattern-soft {
            fill: none;
            vector-effect: non-scaling-stroke;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .hero-metal-pattern-base {
            stroke: url(#heroGoldBaseV3);
            stroke-width: 1.15;
            opacity: 0.83;
            filter: url(#heroEmbossV3);
        }

        .hero-metal-pattern-soft {
            stroke: rgba(255, 255, 255, 0.36);
            stroke-width: 0.55;
            transform: translateY(-1px);
        }

        .hero-metal-pattern-shine {
            stroke: url(#heroMetalHighlightV3);
            stroke-width: 2.8;
            opacity: 0.98;
            mask: url(#heroShineMaskV3);
            mix-blend-mode: screen;
        }

        .hero-metal-shine-circle {
            will-change: transform;
        }


        /* ---------------------------------------------------------
           PALE GREEN SECTIONS
           Distinguishes the former bg-cream bands from warm ivory.
           --------------------------------------------------------- */
        section.site-section.bg-cream {
            background:
                radial-gradient(
                    circle at 18% 12%,
                    rgba(255, 255, 255, 0.98) 0%,
                    rgba(247, 253, 249, 0.98) 30%,
                    rgba(236, 248, 241, 0.98) 72%,
                    rgba(230, 244, 236, 0.98) 100%
                ) !important;
            border-top: 1px solid rgba(17, 171, 100, 0.055);
            border-bottom: 1px solid rgba(17, 171, 100, 0.055);
        }

        /* ---------------------------------------------------------
           FROSTED GLASS + NEOMORPHISM
           One visual language for all card-like surfaces.
           --------------------------------------------------------- */
        :is(
            .hero-visual-card,
            .glass-panel,
            .bento-card,
            .premium-service-card,
            .pipeline-node,
            .case-card-large,
            .step-node,
            .waves-container
        ) {
            position: relative;
            isolation: isolate;
            overflow: hidden;

            background:
                linear-gradient(
                    145deg,
                    rgba(255, 255, 255, 0.68) 0%,
                    rgba(250, 253, 251, 0.54) 42%,
                    rgba(234, 244, 238, 0.42) 100%
                ) !important;

            border: 1px solid rgba(255, 255, 255, 0.78) !important;

            box-shadow:
                16px 18px 36px rgba(49, 73, 59, 0.10),
                -10px -10px 28px rgba(255, 255, 255, 0.82),
                inset 1px 1px 0 rgba(255, 255, 255, 0.94),
                inset -1px -1px 0 rgba(76, 108, 89, 0.055);

            -webkit-backdrop-filter: blur(18px) saturate(120%);
            backdrop-filter: blur(18px) saturate(120%);

            transition:
                transform 260ms cubic-bezier(.2,.75,.25,1),
                box-shadow 260ms ease,
                border-color 260ms ease,
                background 260ms ease;
        }

        :is(
            .hero-visual-card,
            .glass-panel,
            .bento-card,
            .premium-service-card,
            .pipeline-node,
            .case-card-large,
            .step-node,
            .waves-container
        )::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            pointer-events: none;

            background:
                linear-gradient(
                    135deg,
                    rgba(255, 255, 255, 0.48) 0%,
                    rgba(255, 255, 255, 0.11) 38%,
                    rgba(255, 255, 255, 0.02) 58%,
                    rgba(218, 236, 225, 0.12) 100%
                );
        }

        :is(
            .hero-visual-card,
            .glass-panel,
            .bento-card,
            .premium-service-card,
            .pipeline-node,
            .case-card-large,
            .step-node
        ):hover {
            transform: translateY(-3px);

            border-color: rgba(255, 255, 255, 0.94) !important;

            box-shadow:
                19px 22px 42px rgba(49, 73, 59, 0.125),
                -12px -12px 30px rgba(255, 255, 255, 0.88),
                inset 1px 1px 0 rgba(255, 255, 255, 1),
                inset -1px -1px 0 rgba(76, 108, 89, 0.065);
        }

        /* Slightly greener frosted glass on the pale-green bands. */
        .bg-cream :is(
            .hero-visual-card,
            .glass-panel,
            .bento-card,
            .premium-service-card,
            .pipeline-node,
            .case-card-large,
            .step-node,
            .waves-container
        ) {
            background:
                linear-gradient(
                    145deg,
                    rgba(255, 255, 255, 0.72) 0%,
                    rgba(245, 252, 248, 0.57) 46%,
                    rgba(224, 241, 231, 0.44) 100%
                ) !important;

            box-shadow:
                16px 18px 36px rgba(39, 91, 61, 0.085),
                -10px -10px 28px rgba(255, 255, 255, 0.88),
                inset 1px 1px 0 rgba(255, 255, 255, 0.96),
                inset -1px -1px 0 rgba(17, 120, 70, 0.045);
        }

        /* On the gold-pattern sections the glass stays warm-neutral
           so the metallic lines remain visible through the surface. */
        .metal-v3-section :is(
            .hero-visual-card,
            .glass-panel,
            .bento-card,
            .premium-service-card,
            .pipeline-node,
            .case-card-large,
            .step-node,
            .waves-container
        ) {
            background:
                linear-gradient(
                    145deg,
                    rgba(255, 255, 255, 0.65) 0%,
                    rgba(252, 249, 242, 0.52) 46%,
                    rgba(241, 236, 224, 0.40) 100%
                ) !important;

            box-shadow:
                16px 18px 36px rgba(89, 66, 29, 0.09),
                -10px -10px 28px rgba(255, 255, 255, 0.84),
                inset 1px 1px 0 rgba(255, 255, 255, 0.96),
                inset -1px -1px 0 rgba(134, 95, 26, 0.05);
        }

        /* Stepper items need a little surface area to read as glass cards. */
        .step-node {
            padding: 1.15rem 0.9rem;
            border-radius: 1.15rem;
        }

        /* Preserve readable content above the frosted surface. */
        :is(
            .hero-visual-card,
            .glass-panel,
            .bento-card,
            .premium-service-card,
            .pipeline-node,
            .case-card-large,
            .step-node,
            .waves-container
        ) > * {
            position: relative;
            z-index: 1;
        }

        /* Mobile: lighter blur/shadows for smoother scrolling. */
        @@media (max-width: 700px) {
            :is(
                .hero-visual-card,
                .glass-panel,
                .bento-card,
                .premium-service-card,
                .pipeline-node,
                .case-card-large,
                .step-node,
                .waves-container
            ) {
                -webkit-backdrop-filter: blur(12px) saturate(115%);
                backdrop-filter: blur(12px) saturate(115%);

                box-shadow:
                    10px 12px 25px rgba(49, 73, 59, 0.085),
                    -6px -6px 18px rgba(255, 255, 255, 0.78),
                    inset 1px 1px 0 rgba(255, 255, 255, 0.90),
                    inset -1px -1px 0 rgba(76, 108, 89, 0.045);
            }

            :is(
                .hero-visual-card,
                .glass-panel,
                .bento-card,
                .premium-service-card,
                .pipeline-node,
                .case-card-large,
                .step-node
            ):hover {
                transform: none;
            }
        }


        /* =========================================================
           PREMIUM FLOATING GLASS HEADER V5
           ========================================================= */
        .site-header {
            position: fixed !important;
            inset: 0 0 auto 0 !important;
            z-index: 1000 !important;
            padding: 14px 18px 0 !important;
            background: transparent !important;
            border: 0 !important;
            box-shadow: none !important;
            pointer-events: none;
            transition: padding 260ms ease;
        }

        .site-header .nav-container {
            position: relative;
            width: min(1480px, calc(100% - 12px)) !important;
            min-height: 76px;
            margin: 0 auto !important;
            padding: 0 25px !important;
            display: flex !important;
            align-items: center;
            justify-content: space-between;
            gap: 28px;
            border-radius: 25px;
            pointer-events: auto;
            overflow: visible !important;

            background:
                linear-gradient(
                    135deg,
                    rgba(255, 255, 255, .50) 0%,
                    rgba(249, 253, 251, .36) 36%,
                    rgba(231, 244, 236, .26) 100%
                ) !important;

            border:
                1px solid rgba(255, 255, 255, .68) !important;

            -webkit-backdrop-filter:
                blur(30px) saturate(145%);
            backdrop-filter:
                blur(30px) saturate(145%);

            box-shadow:
                0 18px 48px rgba(35, 66, 48, .075),
                0 4px 14px rgba(35, 66, 48, .035),
                inset 0 1px 0 rgba(255, 255, 255, .86),
                inset 0 -1px 0 rgba(61, 107, 79, .035);

            transition:
                min-height 260ms ease,
                background 260ms ease,
                border-color 260ms ease,
                box-shadow 260ms ease,
                transform 260ms ease;
        }

        .site-header .nav-container::before {
            content: "";
            position: absolute;
            inset: 1px 1px auto 1px;
            height: 45%;
            border-radius: 24px 24px 50% 50%;
            pointer-events: none;
            background:
                linear-gradient(
                    to bottom,
                    rgba(255, 255, 255, .32),
                    rgba(255, 255, 255, 0)
                );
            opacity: .78;
        }

        .site-header .nav-container::after {
            content: "";
            position: absolute;
            left: 11%;
            right: 11%;
            bottom: -20px;
            height: 30px;
            z-index: -1;
            pointer-events: none;
            border-radius: 50%;
            background: rgba(57, 94, 71, .10);
            filter: blur(24px);
            opacity: .32;
        }

        .site-header.scrolled {
            padding-top: 9px !important;
        }

        .site-header.scrolled .nav-container {
            min-height: 68px;
            background:
                linear-gradient(
                    135deg,
                    rgba(255, 255, 255, .67) 0%,
                    rgba(248, 253, 250, .54) 48%,
                    rgba(231, 244, 236, .42) 100%
                ) !important;
            border-color: rgba(255, 255, 255, .79) !important;

            box-shadow:
                0 18px 46px rgba(35, 66, 48, .095),
                0 5px 16px rgba(35, 66, 48, .045),
                inset 0 1px 0 rgba(255, 255, 255, .92);

            transform: translateY(-1px);
        }

        .site-header .logo-link {
            position: relative;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            flex: 0 0 auto;
            color: var(--brand-green-dark) !important;
            font-size: 1.08rem;
            font-weight: 830;
            letter-spacing: -.04em;
            white-space: nowrap;
        }

        .site-header .logo-link::before {
            content: "G";
            display: grid;
            place-items: center;
            width: 35px;
            height: 35px;
            border-radius: 12px;
            color: var(--brand-green-dark);
            font-size: .82rem;
            font-weight: 900;

            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.60),
                    rgba(235,246,239,.34)
                );

            border: 1px solid rgba(255,255,255,.76);

            -webkit-backdrop-filter: blur(16px);
            backdrop-filter: blur(16px);

            box-shadow:
                0 9px 24px rgba(42, 82, 57, .075),
                inset 1px 1px 0 rgba(255,255,255,.90),
                inset -1px -1px 0 rgba(42, 91, 59, .045);
        }

        .site-header .logo-accent {
            color: var(--brand-green) !important;
        }

        .site-header .main-nav {
            position: relative;
            z-index: 2;
            flex: 1 1 auto;
            min-width: 0;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 23px;
        }

        .site-header .main-nav > ul {
            flex: 0 1 auto;
            min-width: 0;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            margin: 0;
            padding: 0;
        }

        .site-header .main-nav > ul > li {
            flex: 0 0 auto;
        }

        .site-header .nav-item {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 40px;
            padding: 0 9px;
            border-radius: 12px;
            white-space: nowrap;

            color: rgba(46, 62, 53, .83) !important;
            font-size: .80rem;
            font-weight: 650;
            letter-spacing: .004em;

            background: transparent;
            border: 1px solid transparent;

            transition:
                color 180ms ease,
                background 180ms ease,
                border-color 180ms ease,
                box-shadow 180ms ease,
                transform 180ms ease;
        }

        .site-header .nav-item::after {
            content: "";
            position: absolute;
            left: 12px;
            right: 12px;
            bottom: 5px;
            height: 1px;
            border-radius: 999px;
            background:
                linear-gradient(
                    90deg,
                    transparent,
                    rgba(17,171,100,.55),
                    rgba(197,160,89,.40),
                    transparent
                );
            opacity: 0;
            transform: scaleX(.45);
            transition:
                opacity 180ms ease,
                transform 180ms ease;
        }

        .site-header .nav-item:hover,
        .site-header .has-dropdown:hover > .nav-item,
        .site-header .has-dropdown:focus-within > .nav-item {
            color: var(--brand-green-dark) !important;

            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.36),
                    rgba(255,255,255,.16)
                );

            border-color: rgba(255,255,255,.52);

            box-shadow:
                0 8px 20px rgba(45, 78, 57, .045),
                inset 1px 1px 0 rgba(255,255,255,.74);

            transform: translateY(-1px);
        }

        .site-header .nav-item:hover::after,
        .site-header .has-dropdown:hover > .nav-item::after,
        .site-header .has-dropdown:focus-within > .nav-item::after {
            opacity: .8;
            transform: scaleX(1);
        }

        .site-header .dropdown-arrow {
            font-size: .50rem;
            opacity: .44;
            transform: translateY(1px);
            transition:
                transform 180ms ease,
                opacity 180ms ease;
        }

        .site-header .has-dropdown:hover .dropdown-arrow,
        .site-header .has-dropdown:focus-within .dropdown-arrow {
            transform: translateY(1px) rotate(180deg);
            opacity: .72;
        }

        .site-header .has-dropdown {
            position: relative;
        }

        .site-header .dropdown-menu {
            top: calc(100% + 15px) !important;
            min-width: 286px;
            padding: 10px !important;
            border-radius: 21px !important;

            background:
                linear-gradient(
                    145deg,
                    rgba(255, 255, 255, .62),
                    rgba(240, 249, 244, .48)
                ) !important;

            border:
                1px solid rgba(255,255,255,.72) !important;

            -webkit-backdrop-filter:
                blur(32px) saturate(145%);
            backdrop-filter:
                blur(32px) saturate(145%);

            box-shadow:
                0 24px 58px rgba(31, 65, 44, .14),
                0 6px 16px rgba(31, 65, 44, .05),
                inset 0 1px 0 rgba(255,255,255,.88) !important;
        }

        .site-header .dropdown-menu::before {
            content: "";
            position: absolute;
            left: 24px;
            top: -7px;
            width: 14px;
            height: 14px;
            transform: rotate(45deg);

            background: rgba(250, 253, 251, .62);
            border-left: 1px solid rgba(255,255,255,.72);
            border-top: 1px solid rgba(255,255,255,.72);

            -webkit-backdrop-filter: blur(20px);
            backdrop-filter: blur(20px);
        }

        .site-header .dropdown-menu a {
            position: relative;
            z-index: 1;
            min-height: 38px;
            display: flex;
            align-items: center;
            padding: 8px 11px !important;
            border-radius: 12px;

            color: rgba(55, 70, 61, .78) !important;
            font-size: .80rem;
            font-weight: 570;
            line-height: 1.25;

            transition:
                background 160ms ease,
                color 160ms ease,
                transform 160ms ease,
                box-shadow 160ms ease;
        }

        .site-header .dropdown-menu a:hover {
            color: var(--brand-green-dark) !important;

            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.46),
                    rgba(226,243,233,.28)
                );

            box-shadow:
                inset 1px 1px 0 rgba(255,255,255,.72);

            transform: translateX(3px);
        }

        .site-header .lang-selector {
            position: relative;
            flex: 0 0 auto;
            display: flex;
            align-items: center;
            gap: 2px;
            padding: 4px;
            margin-left: 2px;
            border-radius: 11px;

            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.30),
                    rgba(237,247,241,.20)
                );

            border: 1px solid rgba(255,255,255,.44);

            box-shadow:
                inset 1px 1px 0 rgba(255,255,255,.66);
        }

        .site-header .lang-selector::before {
            content: "";
            position: absolute;
            left: -13px;
            top: 6px;
            bottom: 6px;
            width: 1px;
            background:
                linear-gradient(
                    to bottom,
                    transparent,
                    rgba(75, 105, 87, .13),
                    transparent
                );
        }

        .site-header .lang-link {
            display: grid;
            place-items: center;
            min-width: 30px;
            height: 29px;
            border-radius: 8px;

            color: rgba(68, 84, 74, .58);
            font-size: .69rem;
            font-weight: 790;

            transition:
                color 160ms ease,
                background 160ms ease,
                box-shadow 160ms ease;
        }

        .site-header .lang-link:hover {
            color: var(--brand-green-dark);
        }

        .site-header .lang-link.active {
            color: var(--brand-green-dark);

            background:
                rgba(255,255,255,.49);

            box-shadow:
                0 5px 13px rgba(43, 78, 57, .045),
                inset 1px 1px 0 rgba(255,255,255,.76);
        }

        .site-header .header-cta {
            flex: 0 0 auto;
            min-height: 42px;
            padding: 0 15px !important;
            border-radius: 13px !important;
            white-space: nowrap;

            color: var(--brand-green-dark) !important;
            font-size: .76rem !important;
            font-weight: 760 !important;

            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.43),
                    rgba(223,242,230,.28)
                ) !important;

            border:
                1px solid rgba(255,255,255,.62) !important;

            -webkit-backdrop-filter: blur(18px);
            backdrop-filter: blur(18px);

            box-shadow:
                0 9px 22px rgba(38, 77, 53, .055),
                inset 1px 1px 0 rgba(255,255,255,.82),
                inset -1px -1px 0 rgba(17, 119, 69, .035) !important;

            transition:
                transform 180ms ease,
                background 180ms ease,
                box-shadow 180ms ease;
        }

        .site-header .header-cta:hover {
            transform: translateY(-2px);

            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.58),
                    rgba(218,241,226,.38)
                ) !important;

            box-shadow:
                0 13px 28px rgba(38, 77, 53, .075),
                inset 1px 1px 0 rgba(255,255,255,.92) !important;
        }

        .site-header .hamburger {
            position: relative;
            z-index: 2;
            width: 42px;
            height: 42px;
            padding: 0 !important;
            border-radius: 13px;
            border: 1px solid rgba(255,255,255,.60);
            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.42),
                    rgba(234,246,238,.28)
                );
            -webkit-backdrop-filter: blur(18px);
            backdrop-filter: blur(18px);
            box-shadow:
                0 8px 20px rgba(43,78,57,.055),
                inset 1px 1px 0 rgba(255,255,255,.80);
        }

        .site-header .hamburger span {
            width: 18px;
            height: 1.5px;
            border-radius: 999px;
            background: var(--brand-green-dark);
        }

        .hero-section {
            padding-top: 9rem !important;
        }

        /* Intermediate desktop: preserve breathing room before mobile layout. */
        @@media (max-width: 1240px) and (min-width: 993px) {
            .site-header {
                padding-inline: 10px !important;
            }

            .site-header .nav-container {
                width: calc(100% - 4px) !important;
                padding-inline: 17px !important;
                gap: 18px;
            }

            .site-header .main-nav {
                gap: 14px;
            }

            .site-header .main-nav > ul {
                gap: 3px;
            }

            .site-header .nav-item {
                padding-inline: 6px;
                font-size: .74rem;
            }

            .site-header .header-cta {
                padding-inline: 10px !important;
                font-size: .70rem !important;
            }

            .site-header .lang-selector {
                margin-left: 0;
            }

            .site-header .lang-selector::before {
                display: none;
            }
        }

        /* =========================================================
           SOFT BACKGROUND TRANSITIONS
           A translucent memory of the previous band fades away.
           ========================================================= */
        .site-section.soft-transition {
            position: relative;
            isolation: isolate;
        }

        .site-section.soft-transition > .container {
            position: relative;
            z-index: 3;
        }

        .site-section.soft-transition::before {
            content: "";
            position: absolute;
            top: -1px;
            left: 0;
            right: 0;
            height: 104px;
            z-index: 2;
            pointer-events: none;
            background: var(--section-blend-top);
        }

        .transition-from-warm {
            --section-blend-top:
                linear-gradient(
                    to bottom,
                    rgba(247,241,231,.96) 0%,
                    rgba(247,241,231,.58) 32%,
                    rgba(247,241,231,0) 100%
                );
        }

        .transition-from-green {
            --section-blend-top:
                linear-gradient(
                    to bottom,
                    rgba(232,247,239,.96) 0%,
                    rgba(236,248,241,.55) 34%,
                    rgba(236,248,241,0) 100%
                );
        }

        .transition-from-stone {
            --section-blend-top:
                linear-gradient(
                    to bottom,
                    rgba(239,236,229,.95) 0%,
