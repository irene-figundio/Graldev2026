@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

<!-- 01 HERO SECTION: Premium Visual-First Design -->
<section class="site-section hero-section" style="padding: 6rem 0 4rem 0; background: radial-gradient(circle at 75% 30%, var(--bg-cream) 0%, var(--bg-warm-ivory) 70%);">
    <div class="container split-grid-50">
        <!-- Hero Left: 35-40% Copy -->
        <div style="z-index: 5;">
            <div class="eyebrow-pill">
                <span>✦</span>
                @(isEn ? "Technology Consulting & Integration" : "Consulenza Informatica & Integration Partner")
            </div>
            <h1 style="color: var(--brand-green-dark); margin-bottom: 1.25rem; font-weight: 800; line-height: 1.1;">
                @(isEn ? "We orchestrate technology to solve your operational bottlenecks." : "Orchestriamo la tecnologia per risolvere i tuoi colli di bottiglia operativi.")
            </h1>
            <p class="lead" style="color: var(--text-soft); margin-bottom: 2rem;">
                @(isEn ? "Connecting fragmented applications, automating workflows, and embedding secure AI inside enterprise pipelines. No buzzwords, just engineered systems that work." : "Connettiamo applicativi isolati, automatizziamo processi e integriamo l'AI nei flussi aziendali. Nessun termine altisonante, solo sistemi ingegnerizzati che funzionano.")
            </p>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <a href="@(isEn ? "/en/contact" : "/contatti")" class="btn btn-primary">
                    @(isEn ? "Let's talk about your needs" : "Parliamo della tua esigenza")
                </a>
                <a href="#servizi" class="btn btn-secondary">
                    @(isEn ? "Explore Services" : "Scopri i servizi")
                </a>
            </div>
        </div>

        <!-- Hero Right: 60-65% High-Fidelity Visual -->
        <div class="hero-visual-card glass-panel" style="border-color: rgba(197,160,89,0.25);">
            <div class="diagram-canvas-wrap">
                <svg viewBox="0 0 500 500" class="hero-svg-canvas" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <radialGradient id="greenNodeGlow" cx="50%" cy="50%" r="50%">
                            <stop offset="0%" stop-color="var(--brand-green)" stop-opacity="0.25" />
                            <stop offset="100%" stop-color="var(--brand-green)" stop-opacity="0" />
                        </radialGradient>
                    </defs>

                    <!-- Connecting Pulses Lines -->
                    <line class="pulse-line" x1="250" y1="250" x2="110" y2="120" stroke="var(--champagne-gold)" stroke-width="2" />
                    <line class="pulse-line" x1="250" y1="250" x2="390" y2="120" stroke="var(--champagne-gold)" stroke-width="2" />
                    <line class="pulse-line" x1="250" y1="250" x2="110" y2="380" stroke="var(--champagne-gold)" stroke-width="2" />
                    <line class="pulse-line" x1="250" y1="250" x2="390" y2="380" stroke="var(--champagne-gold)" stroke-width="2" />
                    <line class="pulse-line" x1="250" y1="250" x2="250" y2="55" stroke="var(--brand-green)" stroke-width="2" />
                    <line class="pulse-line" x1="250" y1="250" x2="250" y2="445" stroke="var(--brand-green)" stroke-width="2" />

                    <!-- Center Graldev Node -->
                    <circle class="pulse-node-ring" cx="250" cy="250" r="16" fill="none" stroke="var(--brand-green)" stroke-width="2" />
                    <circle cx="250" cy="250" r="24" fill="var(--brand-green)" />
                    <circle cx="250" cy="250" r="18" fill="var(--brand-green-dark)" />
                    <text x="250" y="254" font-size="11" font-weight="800" fill="white" text-anchor="middle">GD</text>

                    <!-- Outer Technology Interactive Nodes -->
                    <!-- ERP -->
                    <g transform="translate(110, 120)" class="diagram-node" style="cursor: pointer;">
                        <circle cx="0" cy="0" r="28" fill="var(--bg-cream)" stroke="var(--border)" stroke-width="2" />
                        <text x="0" y="4" font-size="10" font-weight="800" fill="var(--brand-green-dark)" text-anchor="middle" class="node-text-label">ERP</text>
                    </g>

                    <!-- CRM -->
                    <g transform="translate(390, 120)" class="diagram-node" style="cursor: pointer;">
                        <circle cx="0" cy="0" r="28" fill="var(--bg-cream)" stroke="var(--border)" stroke-width="2" />
                        <text x="0" y="4" font-size="10" font-weight="800" fill="var(--brand-green-dark)" text-anchor="middle" class="node-text-label">CRM</text>
                    </g>

                    <!-- API -->
                    <g transform="translate(110, 380)" class="diagram-node" style="cursor: pointer;">
                        <circle cx="0" cy="0" r="28" fill="var(--bg-cream)" stroke="var(--border)" stroke-width="2" />
                        <text x="0" y="4" font-size="10" font-weight="800" fill="var(--brand-green-dark)" text-anchor="middle" class="node-text-label">API</text>
                    </g>

                    <!-- DATA -->
                    <g transform="translate(390, 380)" class="diagram-node" style="cursor: pointer;">
                        <circle cx="0" cy="0" r="28" fill="var(--bg-cream)" stroke="var(--border)" stroke-width="2" />
                        <text x="0" y="4" font-size="10" font-weight="800" fill="var(--brand-green-dark)" text-anchor="middle" class="node-text-label">DATA</text>
                    </g>

                    <!-- AI -->
                    <g transform="translate(250, 55)" class="diagram-node" style="cursor: pointer;">
                        <circle cx="0" cy="0" r="28" fill="var(--bg-very-light-green)" stroke="var(--brand-green)" stroke-width="2" />
                        <text x="0" y="4" font-size="10" font-weight="800" fill="var(--brand-green-dark)" text-anchor="middle" class="node-text-label">AI</text>
                    </g>

                    <!-- CLOUD -->
                    <g transform="translate(250, 445)" class="diagram-node" style="cursor: pointer;">
                        <circle cx="0" cy="0" r="28" fill="var(--bg-very-light-green)" stroke="var(--brand-green)" stroke-width="2" />
                        <text x="0" y="4" font-size="10" font-weight="800" fill="var(--brand-green-dark)" text-anchor="middle" class="node-text-label">CLOUD</text>
                    </g>
                </svg>
            </div>
            <!-- Microinteraction status footer -->
            <div style="display: flex; justify-content: space-around; font-size: 0.75rem; font-weight: 700; color: var(--brand-green-dark); border-top: 1px solid var(--border); padding-top: 1rem; text-transform: uppercase; margin-top: 1rem; letter-spacing: 0.05em;">
                <span style="display: flex; align-items: center; gap: 6px;"><span class="data-pulse" style="width: 8px; height: 8px; background: var(--brand-green); border-radius: 50%; display: inline-block;"></span> @(isEn ? "ORCHESTRATED" : "ORCHESTRATO")</span>
                <span style="display: flex; align-items: center; gap: 6px;"><span class="data-pulse" style="width: 8px; height: 8px; background: var(--champagne-gold); border-radius: 50%; display: inline-block; animation-delay: 1s;"></span> @(isEn ? "SYNCHRONIZED" : "SINCRONIZZATO")</span>
                <span style="display: flex; align-items: center; gap: 6px;"><span class="data-pulse" style="width: 8px; height: 8px; background: var(--brand-green); border-radius: 50%; display: inline-block; animation-delay: 2s;"></span> @(isEn ? "SECURED" : "PROTETTO")</span>
            </div>
        </div>
    </div>
</section>

<!-- 02 PROBLEMS: Asymmetric Bento Visual Grid -->
<section id="problemi" class="site-section bg-cream" style="padding: 5rem 0;">
    <div class="container">
        <div style="text-align: center; max-width: 750px; margin: 0 auto 3.5rem auto;">
            <div class="eyebrow-pill">OPERATIONAL FRICTIONS</div>
            <h2 style="font-weight: 800; margin-bottom: 1rem;">
                @(isEn ? "When standard software turns into a manual bottleneck." : "Quando la tecnologia standard si trasforma in un collo di bottiglia manuale.")
            </h2>
            <p style="color: var(--text-soft); font-size: 1.1rem;">
                @(isEn ? "We step in when generic box software falls short and business operations require elegant architectural connections." : "Interveniamo quando le applicazioni generiche mostrano i propri limiti e le operazioni richiedono connessioni stabili.")
            </p>
        </div>

        <div class="bento-grid">
            <!-- Box 1: Disconnected Systems -->
            <div class="bento-card col-span-8">
                <div>
                    <div class="icon-neo-wrap">⛓️</div>
                    <h3 style="margin-bottom: 0.5rem; color: var(--brand-green-dark);">@(isEn ? "Isolated Island Systems" : "Sistemi e applicativi isolati")</h3>
                    <p style="font-size: 0.95rem; line-height: 1.6; max-width: 580px;">
                        @(isEn ? "Your ERP doesn't speak with your CRM, databases remain locked, and invoices stay separated. We bridge custom API endpoints and build solid middle layers to sync data automatically." : "I gestionali non parlano con i CRM, i database restano sigillati e le informazioni vitali rimangono separate. Disegniamo middleware per connettere qualsiasi endpoint e sincronizzare i flussi.")
                    </p>
                </div>
                <div style="margin-top: 1.5rem; display: flex; align-items: center; justify-content: space-between;">
                    <span style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--champagne-gold); font-weight: 700;">SYSTEM ARCHITECTURE</span>
                    <span class="pill-neomorphic" style="font-size: 0.75rem;">API & Integration</span>
                </div>
            </div>

            <!-- Box 2: Manual Copy Paste -->
            <div class="bento-card col-span-4">
                <div>
                    <div class="icon-neo-wrap">📋</div>
                    <h3 style="margin-bottom: 0.5rem; color: var(--brand-green-dark);">@(isEn ? "Manual Data Entry Inefficiencies" : "Trascrizioni manuali ripetitive")</h3>
                    <p style="font-size: 0.95rem; line-height: 1.5;">
                        @(isEn ? "Employees waste hours transcriptioning orders, catalogs, or emails across different systems. We automate workflows to completely remove manual errors." : "Il tuo team spreca ore preziose trascrivendo ordini, anagrafiche o preventivi tra piattaforme non comunicanti. Automatizziamo i flussi cancellando l'errore umano.")
                    </p>
                </div>
                <div style="margin-top: 1.5rem; display: flex; align-items: center; justify-content: space-between;">
                    <span class="pill-neomorphic" style="font-size: 0.75rem;">100% Automated</span>
                </div>
            </div>

            <!-- Box 3: Excel Trap -->
            <div class="bento-card col-span-4">
                <div>
                    <div class="icon-neo-wrap">📊</div>
                    <h3 style="margin-bottom: 0.5rem; color: var(--brand-green-dark);">@(isEn ? "The Fragile Excel Trap" : "La trappola degli Excel fragili")</h3>
                    <p style="font-size: 0.95rem; line-height: 1.5;">
                        @(isEn ? "Critical business decisions and calculations rely on heavy, fragile Excel files that break at any key mistake. We consolidate data into robust web solutions." : "Processi e calcoli cruciali poggiano su file Excel pesanti e fragili che rischiano di corrompersi ad ogni modifica. Consolidiamo i dati in applicazioni web stabili.")
                    </p>
                </div>
                <div style="margin-top: 1.5rem; display: flex; align-items: center; justify-content: space-between;">
                    <span class="pill-neomorphic" style="font-size: 0.75rem;">Reliability First</span>
                </div>
            </div>

            <!-- Box 4: Obsolete Legacy -->
            <div class="bento-card col-span-8">
                <div>
                    <div class="icon-neo-wrap">⚙️</div>
                    <h3 style="margin-bottom: 0.5rem; color: var(--brand-green-dark);">@(isEn ? "Legacy Software Holding Back Evolution" : "Software obsoleto che frena la crescita")</h3>
                    <p style="font-size: 0.95rem; line-height: 1.6; max-width: 580px;">
                        @(isEn ? "Older on-premise components or isolated tools cannot scale to modern standards. We modernize and secure legacy databases safely while keeping your active business operations running." : "I vecchi programmi gestionali faticano ad evolvere e restano disconnessi dal Cloud. Modernizziamo sistemi obsoleti inserendoli in ecosistemi sicuri senza interrompere l'operatività.")
                    </p>
                </div>
                <div style="margin-top: 1.5rem; display: flex; align-items: center; justify-content: space-between;">
                    <span style="font-size: 0.75rem; font-family: var(--font-mono); color: var(--champagne-gold); font-weight: 700;">LEGACY EVOLUTION</span>
                    <span class="pill-neomorphic" style="font-size: 0.75rem;">Cloud Migration</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 03 SERVICES: Vertical Ivory Masonry Card Layout -->
<section id="servizi" class="site-section bg-warm-ivory" style="padding: 5rem 0;">
    <div class="container">
        <div style="text-align: center; max-width: 750px; margin: 0 auto 4rem auto;">
            <div class="eyebrow-pill">CORE CAPABILITIES</div>
            <h2 style="font-weight: 800; margin-bottom: 1rem;">
                @(isEn ? "Our areas of technology expertise." : "Le nostre aree di intervento.")
            </h2>
            <p style="color: var(--text-soft); font-size: 1.1rem;">
                @(isEn ? "We analyze, build, and connect systems. No generic code, just tailored technological engineering." : "Analizziamo, sviluppiamo e connettiamo sistemi complessi. Nessuna soluzione preconfezionata, solo ingegneria tecnologica su misura.")
            </p>
        </div>

        <div class="service-masonry-grid">
            <!-- Cap 1: Consulenza -->
            <div class="premium-service-card">
                <div>
                    <span class="premium-service-icon">🧠</span>
                    <h3 class="premium-service-title">@(isEn ? "IT Consulting & Roadmap" : "Consulenza Informatica")</h3>
                    <p class="premium-service-text">
                        @(isEn ? "Analyzing configurations, evaluating custom database options, and planning scalable architectural layouts before writing code." : "Analisi di sistemi, software audit, fattibilità tecnologica e stesura di roadmap d'integrazione solide prima di avviare lo sviluppo.")
                    </p>
                </div>
                <a href="@(isEn ? "/en/it-consulting" : "/consulenza-informatica")" class="premium-service-link">@(isEn ? "Explore Area" : "Scopri l'area")</a>
            </div>

            <!-- Cap 2: System Integration -->
            <div class="premium-service-card">
                <div>
                    <span class="premium-service-icon">🔗</span>
                    <h3 class="premium-service-title">System Integration</h3>
                    <p class="premium-service-text">
                        @(isEn ? "Synchronizing isolated ERP, CRM, digital commerce tools and databases through resilient APIs and unified middleware." : "Uniamo applicativi eterogenei per scambiare informazioni e allineare database aziendali in modo sicuro e senza intoppi.")
                    </p>
                </div>
                <a href="@(isEn ? "/en/services/system-integration" : "/servizi/system-integration")" class="premium-service-link">@(isEn ? "Explore Area" : "Explore area")</a>
            </div>

            <!-- Cap 3: AI Integration & Automation -->
            <div class="premium-service-card">
                <div>
                    <span class="premium-service-icon">🤖</span>
                    <h3 class="premium-service-title">@(isEn ? "AI Integration & Automation" : "AI & Automation")</h3>
                    <p class="premium-service-text">
                        @(isEn ? "Embedding private Large Language Models (LLM), semantic classification agents, and RAG search directly into database pipelines." : "Portiamo l'Intelligenza Artificiale dentro i flussi informativi per classificare email, estrarre dati da file ed elaborare risposte intelligenti.")
                    </p>
                </div>
                <a href="@(isEn ? "/en/services/ai-integration" : "/servizi/ai-integration")" class="premium-service-link">@(isEn ? "Explore Area" : "Scopri l'area")</a>
            </div>

            <!-- Cap 4: Software Engineering -->
            <div class="premium-service-card">
                <div>
                    <span class="premium-service-icon">💻</span>
                    <h3 class="premium-service-title">Software Engineering</h3>
                    <p class="premium-service-text">
                        @(isEn ? "Building robust backends, customized integrations, secure connectors, and web environments when box applications fall short." : "Sviluppiamo codice ad alte prestazioni, portali complessi, middleware e connettori stabili strutturati per durare nel tempo.")
                    </p>
                </div>
                <a href="@(isEn ? "/en/services/software-engineering" : "/servizi/software-engineering")" class="premium-service-link">@(isEn ? "Explore Area" : "Scopri l'area")</a>
            </div>

            <!-- Cap 5: API & Data Integration -->
            <div class="premium-service-card">
                <div>
                    <span class="premium-service-icon">📊</span>
                    <h3 class="premium-service-title">API & Data Integration</h3>
                    <p class="premium-service-text">
                        @(isEn ? "Designing clean, secure, high-availability API architectures, webhooks systems, and real-time data sync paths." : "Sviluppo di API REST/SOAP stabili e flussi di dati (ETL) per spostare in sicurezza i database aziendali dove serve.")
                    </p>
                </div>
                <a href="@(isEn ? "/en/services/api-data-integration" : "/servizi/api-data-integration")" class="premium-service-link">@(isEn ? "Explore Area" : "Scopri l'area")</a>
            </div>

            <!-- Cap 6: Cloud & Architecture -->
            <div class="premium-service-card">
                <div>
                    <span class="premium-service-icon">☁️</span>
                    <h3 class="premium-service-title">Cloud & Architecture</h3>
                    <p class="premium-service-text">
                        @(isEn ? "Migrating environments to secure clouds, designing high-availability layouts, and streamlining computing performance." : "Progettazione di infrastrutture Cloud resilienti, scalabili, conformi alle normative e ottimizzate nei consumi computazionali.")
                    </p>
                </div>
                <a href="@(isEn ? "/en/services/cloud-architecture" : "/servizi/cloud-architecture")" class="premium-service-link">@(isEn ? "Explore Area" : "Scopri l'area")</a>
            </div>
        </div>
    </div>
</section>

<!-- 04 TECHNOLOGY VISUAL: Slow Waves representation -->
<section class="site-section bg-stone" style="padding: 4rem 0;">
    <div class="container" style="text-align: center;">
        <div style="max-width: 650px; margin: 0 auto 2.5rem auto;">
            <div class="eyebrow-pill" style="background-color: var(--bg-warm-white);">STEADY DATA STREAM</div>
            <h3 style="color: var(--brand-green-dark); margin-bottom: 0.5rem; font-weight: 800;">@(isEn ? "The natural, continuous flow of orchestrated data." : "Il flusso armonioso di dati orchestrati.")</h3>
            <p style="font-size: 0.95rem; margin-bottom: 0;">
                @(isEn ? "When infrastructure is integrated correctly, information flows without friction, obstacles or interruptions." : "Quando l'architettura è connessa, le informazioni scorrono in modo sicuro senza inefficienze o attriti.")
            </p>
        </div>
        <!-- Animated visual wave card -->
        <div class="waves-container">
            <div class="wave-layer wave-1"></div>
            <div class="wave-layer wave-2"></div>
            <div class="wave-layer wave-3"></div>
        </div>
    </div>
</section>

<!-- 05 WORKFLOW: Responsive Animated consulting Stepper -->
<section id="metodo-work" class="site-section bg-warm-white" style="padding: 5rem 0;">
    <div class="container">
        <div style="text-align: center; max-width: 750px; margin: 0 auto 4rem auto;">
            <div class="eyebrow-pill">OUR WORKFLOW</div>
            <h2 style="font-weight: 800; margin-bottom: 1rem;">
                @(isEn ? "From initial bottleneck to engineered solution." : "Dalla comprensione alla stabilità operativa.")
            </h2>
            <p style="color: var(--text-soft); font-size: 1.1rem;">
                @(isEn ? "We do not sell pre-boxed licenses. We inspect, design, deploy, and monitor robust setups tailored to your goals." : "Non vendiamo pacchetti chiusi. Analizziamo i flussi attuali, ingegnerizziamo l'architettura e la manteniamo performante.")
            </p>
        </div>

        <!-- Horizontal Stepper (Responsive to Vertical on Mobile) -->
        <div class="stepper-container">
            <!-- Step 1 -->
            <div class="step-node">
                <div class="step-circle">01</div>
                <div class="step-title">@(isEn ? "Ascolto" : "Ascolto")</div>
                <div class="step-desc">@(isEn ? "Mapping operational goals." : "Comprensione delle inefficienze e degli obiettivi.")</div>
            </div>
            <!-- Step 2 -->
            <div class="step-node">
                <div class="step-circle">02</div>
                <div class="step-title">@(isEn ? "Assessment" : "Assessment")</div>
                <div class="step-desc">@(isEn ? "Inspecting databases and systems." : "Analisi accurata del software e dei flussi dati.")</div>
            </div>
            <!-- Step 3 -->
            <div class="step-node">
                <div class="step-circle">03</div>
                <div class="step-title">@(isEn ? "Architettura" : "Architettura")</div>
                <div class="step-desc">@(isEn ? "Structuring optimal pathways." : "Ingegnerizzazione del layout d'integrazione.")</div>
            </div>
            <!-- Step 4 -->
            <div class="step-node">
                <div class="step-circle">04</div>
                <div class="step-title">@(isEn ? "Integrazione" : "Integrazione")</div>
                <div class="step-desc">@(isEn ? "Connecting and custom coding." : "Connessione stabili tra gli applicativi aziendali.")</div>
            </div>
            <!-- Step 5 -->
            <div class="step-node">
                <div class="step-circle">05</div>
                <div class="step-title">@(isEn ? "Validazione" : "Validazione")</div>
                <div class="step-desc">@(isEn ? "Verifying complete functionality." : "Fase intensiva di testing funzionale e di carico.")</div>
            </div>
            <!-- Step 6 -->
            <div class="step-node">
                <div class="step-circle">06</div>
                <div class="step-title">@(isEn ? "Rilascio" : "Rilascio")</div>
                <div class="step-desc">@(isEn ? "Deploying without interruptions." : "Attivazione controllata senza bloccare le attività.")</div>
            </div>
            <!-- Step 7 -->
            <div class="step-node">
                <div class="step-circle">07</div>
                <div class="step-title">@(isEn ? "Evoluzione" : "Evoluzione")</div>
                <div class="step-desc">@(isEn ? "Continuous proactive monitoring." : "Monitoring continuo, assistenza ed espansione.")</div>
            </div>
        </div>
    </div>
</section>

<!-- 06 SYSTEM INTEGRATION: Unified Business Flow Visual Storytelling -->
<section class="site-section bg-cream" style="padding: 5rem 0;">
    <div class="container">
        <div class="split-grid-50">
            <!-- Left Info -->
            <div>
                <div class="eyebrow-pill">CONNECTIVITY LAYER</div>
                <h2 style="font-weight: 800; margin-bottom: 1.25rem;">
                    @(isEn ? "Synchronizing ERP, CRM, and Databases." : "L'unificazione dei tuoi canali informativi.")
                </h2>
                <p style="color: var(--text-soft); line-height: 1.7; margin-bottom: 1.5rem;">
                    @(isEn ? "We eliminate manual updates. Information is shared instantly across all platforms via the Graldev Integration Layer, creating a unified business flow." : "Basta trascrizioni. Quando un ordine entra nell'eCommerce, l'anagrafica viene inviata al CRM, le scorte scalate sull'ERP e la fatturazione avviata all'istante.")
                </p>
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                    <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; color: var(--brand-green-dark);">
                        <span style="color: var(--brand-green);">✔</span> @(isEn ? "Zero Manual Sync Mistakes" : "Eliminazione totale di errori manuali")
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; color: var(--brand-green-dark);">
                        <span style="color: var(--brand-green);">✔</span> @(isEn ? "Real-time Database Harmonization" : "Database perfettamente allineati in tempo reale")
                    </div>
                </div>
            </div>

            <!-- Right Interactive Pulse Infographic -->
            <div class="glass-panel" style="padding: 2.5rem; border-color: rgba(197, 160, 89, 0.2);">
                <div class="integration-stage">
                    <div class="integration-left">ERP (Enterprise)</div>
                    <div class="integration-line-flow"><div class="integration-pulse"></div></div>
                    <div class="integration-right">SAP, Dynamics, custom platforms</div>
                </div>
                <div class="integration-stage">
                    <div class="integration-left">CRM & Contacts</div>
                    <div class="integration-line-flow"><div class="integration-pulse" style="animation-delay: 1.2s;"></div></div>
                    <div class="integration-right">Salesforce, Hubspot, active directory</div>
                </div>
