                <div class="dp-bento-card-footer">
                    <a href="@(isEn ? "/en/services/api-data-integration" : "/servizi/api-data-integration")" class="dp-bento-link">@(isEn ? "Explore Area" : "Scopri l'Area") <span>→</span></a>
