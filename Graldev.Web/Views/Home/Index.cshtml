    <div class="container">
        <span class="section-eyebrow">@(isEn ? "COMPETENCE AREAS" : "AREE DI COMPETENZA")</span>
        <h2 class="section-title">@(isEn ? "Our core business consulting areas" : "Le nostre aree di competenza consulenziale")</h2>

        <div class="grid-3" style="margin-top: 3rem;">
