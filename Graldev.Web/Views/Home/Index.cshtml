@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container split-layout">
        <div class="split-left" style="position: relative; z-index: 3;">
            <span class="card-neomorphic" style="font-size: 0.8rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--brand-green); padding: 0.4rem 0.8rem; display: inline-block; margin-bottom: 1.5rem;">
                @(isEn ? "IT CONSULTING · SYSTEM INTEGRATION · AI · SOFTWARE ENGINEERING" : "CONSULENZA INFORMATICA · SYSTEM INTEGRATION · AI · SOFTWARE ENGINEERING")
            </span>
            <h1 class="section-title" style="margin-top: 0.5rem; color: var(--brand-green-dark); font-weight: 900;">
                @(isEn ? "We transform complex IT issues into systems that work better." : "Trasformiamo problemi tecnologici complessi in sistemi che funzionano meglio.")
            </h1>
            <p class="section-subtitle" style="font-size: 1.2rem; color: var(--text-soft); line-height: 1.7; margin-bottom: 2rem;">
                @if (isEn)
                {
                    <text>Graldev partners with enterprises in the analysis, design, and implementation of integrated IT solutions. We connect software, data, infrastructures, and AI to simplify processes, eliminate inefficiencies, and support business evolution.</text>
                }
                else
                {
                    <text>Graldev affianca le aziende nell'analisi, progettazione e realizzazione di soluzioni IT integrate. Connettiamo software, dati, infrastrutture e AI per semplificare processi, eliminare inefficienze e supportare l'evoluzione del business.</text>
                }
            </p>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem;">
                <a href="@(isEn ? "/en/contact" : "/contatti")" class="btn btn-primary">
                    @(isEn ? "Let's talk about your needs" : "Parliamo della tua esigenza")
                </a>
                <a href="#metodo" class="btn btn-secondary">
                    @(isEn ? "How we work" : "Scopri come lavoriamo")
                </a>
                <a href="@(isEn ? "/en/case-studies" : "/case-study")" class="btn btn-outline">
                    @(isEn ? "Explore Case Studies" : "Esplora i case study")
                </a>
            </div>
        </div>

        <div class="split-right hero-visual-wrapper">
            <div class="card-glass" style="width: 100%; max-width: 480px; padding: var(--spacing-sm); border-radius: var(--radius-xl); position: relative;">
                <!-- Animated SVG showing converging nodes to central Graldev node -->
                <svg class="hero-svg-canvas" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg" style="z-index: 2; position: relative;">
                    <!-- Lines radiating from center to nodes -->
                    <line class="link-line" x1="250" y1="250" x2="100" y2="100" />
                    <line class="link-line" x1="250" y1="250" x2="400" y2="100" />
                    <line class="link-line" x1="250" y1="250" x2="100" y2="400" />
                    <line class="link-line" x1="250" y1="250" x2="400" y2="400" />
                    <line class="link-line" x1="250" y1="250" x2="250" y2="60" />
                    <line class="link-line" x1="250" y1="250" x2="250" y2="440" />
                    <line class="link-line" x1="250" y1="250" x2="60" y2="250" />
                    <line class="link-line" x1="250" y1="250" x2="440" y2="250" />

                    <!-- Center node: Graldev Layer -->
                    <circle class="center-node pulse-circle" cx="250" cy="250" r="24" />
                    <circle class="center-node" cx="250" cy="250" r="18" />
                    <text x="250" y="254" font-size="11" font-weight="900" fill="white" text-anchor="middle">GD</text>

                    <!-- Surrounding technology nodes with soft neomorphism in the SVG style -->
                    <!-- ERP Node -->
                    <circle class="node" cx="100" cy="100" r="28" />
                    <text x="100" y="104" font-size="10" font-weight="800" fill="var(--brand-green-dark)" text-anchor="middle">ERP</text>

                    <!-- CRM Node -->
                    <circle class="node" cx="400" cy="100" r="28" />
                    <text x="400" y="104" font-size="10" font-weight="800" fill="var(--brand-green-dark)" text-anchor="middle">CRM</text>

                    <!-- API Node -->
                    <circle class="node" cx="100" cy="400" r="28" />
                    <text x="100" y="404" font-size="10" font-weight="800" fill="var(--brand-green-dark)" text-anchor="middle">API</text>

                    <!-- DATABASE Node -->
                    <circle class="node" cx="400" cy="400" r="28" />
                    <text x="400" y="404" font-size="10" font-weight="800" fill="var(--brand-green-dark)" text-anchor="middle">DATA</text>

                    <!-- AI Node -->
                    <circle class="node" cx="250" cy="60" r="24" />
                    <text x="250" y="64" font-size="10" font-weight="800" fill="var(--brand-green-dark)" text-anchor="middle">AI</text>

                    <!-- CLOUD Node -->
                    <circle class="node" cx="250" cy="440" r="24" />
                    <text x="250" y="444" font-size="10" font-weight="800" fill="var(--brand-green-dark)" text-anchor="middle">CLOUD</text>

                    <!-- ECOMMERCE Node -->
                    <circle class="node" cx="60" cy="250" r="24" />
                    <text x="60" y="254" font-size="9" font-weight="800" fill="var(--brand-green-dark)" text-anchor="middle">E-COM</text>

                    <!-- APP Node -->
                    <circle class="node" cx="440" cy="250" r="24" />
                    <text x="440" y="254" font-size="10" font-weight="800" fill="var(--brand-green-dark)" text-anchor="middle">APP</text>
                </svg>
            </div>
        </div>
    </div>
</section>

<!-- When to Involve Graldev Section (Alternating to alt-section) -->
<section id="involvere" class="alt-section">
    <div class="container">
        <div style="text-align: center; margin-bottom: 3.5rem;">
            <span class="section-eyebrow">@(isEn ? "SITUATIONS" : "CONTESTO")</span>
            <h2 class="section-title" style="margin: 0 auto 1rem auto;">@(isEn ? "When it makes sense to involve Graldev" : "Quando ha senso coinvolgere Graldev")</h2>
            <p class="section-subtitle" style="margin: 0 auto;">
                @(isEn ? "We address actual friction points inside your company operations, systems, and data flow:" : "Interveniamo su problemi operativi concreti che rallentano la tua azienda:")
            </p>
        </div>

        <div class="involve-items">
            <div class="involve-item">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text">@(isEn ? "Your systems do not communicate with each other." : "I tuoi sistemi non comunicano tra loro.")</span>
            </div>
            <div class="involve-item">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text">@(isEn ? "The same data is typed manually into multiple platforms." : "Lo stesso dato viene inserito manualmente in più piattaforme.")</span>
            </div>
            <div class="involve-item">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text">@(isEn ? "Many operational workflows still depend heavily on Excel." : "Molti processi dipendono ancora da Excel.")</span>
            </div>
            <div class="involve-item">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text">@(isEn ? "ERP, CRM and eCommerce are completely out of sync." : "ERP, CRM ed eCommerce non sono sincronizzati.")</span>
            </div>
            <div class="involve-item">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text">@(isEn ? "The existing software no longer supports company growth." : "Il software esistente non supporta più l'evoluzione dell'azienda.")</span>
            </div>
            <div class="involve-item">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text">@(isEn ? "You have legacy applications that are complex and expensive to maintain." : "Hai applicazioni legacy difficili e costose da mantenere.")</span>
            </div>
            <div class="involve-item">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text">@(isEn ? "You want to adopt AI but don't know where it actually generates business value." : "Vuoi introdurre l'AI ma non sai dove genererebbe realmente valore per il business.")</span>
            </div>
            <div class="involve-item">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text">@(isEn ? "You have many data points but they are distributed across disconnected systems." : "Hai molti dati ma sono distribuiti in sistemi differenti.")</span>
            </div>
            <div class="involve-item">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text">@(isEn ? "You need to decide whether to buy a platform or build a custom software solution." : "Devi decidere se acquistare una piattaforma esistente o sviluppare una soluzione custom.")</span>
            </div>
            <div class="involve-item">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text">@(isEn ? "You need to modernize your infrastructure without blocking operations." : "Devi modernizzare un'infrastruttura senza bloccare l'operatività.")</span>
            </div>
        </div>

        <div style="text-align: center; margin-top: 3.5rem;">
            <a href="@(isEn ? "/en/contact" : "/contatti")" class="btn btn-primary">
                @(isEn ? "Tell us about your problem" : "Raccontaci il problema")
            </a>
        </div>
    </div>
</section>

<!-- Method: How We Work Section (Alternating to white-section) -->
<section id="metodo" class="white-section">
    <div class="container">
        <span class="section-eyebrow">@(isEn ? "OUR METHOD" : "IL NOSTRO METODO")</span>
        <h2 class="section-title">@(isEn ? "From complexity to solution" : "Dalla complessità alla soluzione")</h2>
        <p class="section-subtitle">
            @if (isEn)
            {
                <text>We do not start from tech stacks. We start from understanding your workflows, existing infrastructures, and business bottlenecks first.</text>
            }
            else
            {
                <text>Non partiamo mai dalla tecnologia. Partiamo dalla comprensione dei vostri workflow, dei sistemi esistenti e dei colli di bottiglia operativi.</text>
            }
        </p>

        <div class="method-steps">
            <div class="method-step">
                <div class="method-num">01</div>
                <div class="method-name">@(isEn ? "LISTENING" : "ASCOLTO")</div>
                <div class="method-desc">@(isEn ? "Understanding the core issue, process and business objectives." : "Comprensione del problema, del processo e degli obiettivi.")</div>
            </div>
            <div class="method-step">
                <div class="method-num">02</div>
                <div class="method-name">@(isEn ? "ASSESSMENT" : "ASSESSMENT")</div>
                <div class="method-desc">@(isEn ? "Analysis of current systems, data structures, dependencies and bottlenecks." : "Analisi di sistemi, dati, infrastrutture, dipendenze e criticità.")</div>
            </div>
            <div class="method-step">
                <div class="method-num">03</div>
                <div class="method-name">@(isEn ? "ARCHITECTURE" : "ARCHITETTURA")</div>
                <div class="method-desc">@(isEn ? "Designing the most appropriate and sustainable tech architecture." : "Disegno della soluzione e dell'infrastruttura più appropriata.")</div>
            </div>
            <div class="method-step">
                <div class="method-num">04</div>
                <div class="method-name">@(isEn ? "INTEGRATION" : "INTEGRAZIONE")</div>
                <div class="method-desc">@(isEn ? "Implementation using legacy platforms and custom middleware components." : "Implementazione connettendo sistemi esistenti e scrivendo codice custom.")</div>
            </div>
            <div class="method-step">
                <div class="method-num">05</div>
                <div class="method-name">@(isEn ? "VALIDATION" : "VALIDAZIONE")</div>
                <div class="method-desc">@(isEn ? "Rigorous technical and operational integration testing." : "Testing tecnico, prestazionale e funzionale completo.")</div>
            </div>
            <div class="method-step">
                <div class="method-num">06</div>
                <div class="method-name">@(isEn ? "DEPLOYMENT" : "RILASCIO")</div>
                <div class="method-desc">@(isEn ? "Progressive production deployment to secure business continuity." : "Deployment progressivo per non interrompere mai l'operatività.")</div>
            </div>
            <div class="method-step">
                <div class="method-num">07</div>
                <div class="method-name">@(isEn ? "EVOLUTION" : "EVOLUZIONE")</div>
                <div class="method-desc">@(isEn ? "Continuous monitoring, proactive support and systems improvement." : "Monitoring continuo, supporto e miglioramento incrementale dei sistemi.")</div>
            </div>
        </div>
    </div>
</section>

<!-- Competence Areas Cards Section (Alternating to light-green-section) -->
