@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

<!-- Premium Warm Minimalist Hero Section with 3D Layers -->
<section class="hero-section" style="padding: var(--spacing-xl) 0 var(--spacing-lg) 0; overflow: hidden; background-color: var(--bg-warm-ivory); position: relative;">
    <div class="dp-floating-blob dp-blob-green"></div>
    <div class="dp-floating-blob dp-blob-warm"></div>

    <div class="container split-layout" style="align-items: center; position: relative; z-index: 5; gap: var(--spacing-md);">
        <div class="split-left" style="max-width: 600px;">
            <span class="dp-hero-eyebrow" style="color: var(--brand-green); font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.2em; display: inline-block; margin-bottom: 1rem;">
                @(isEn ? "IT CONSULTING · SYSTEM INTEGRATION · AI · SOFTWARE ENGINEERING" : "CONSULENZA INFORMATICA · SYSTEM INTEGRATION · AI · SOFTWARE ENGINEERING")
            </span>
            <h1 class="dp-hero-title" style="font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.1; font-weight: 800; letter-spacing: -0.04em; color: var(--brand-green-dark); margin-bottom: 1.5rem;">
                @(isEn ? "We transform complex IT issues into systems that work better." : "Trasformiamo problemi tecnologici complessi in sistemi che funzionano meglio.")
            </h1>
            <p class="dp-hero-desc" style="font-size: 1.1rem; line-height: 1.6; color: var(--text-soft); margin-bottom: 2.5rem;">
                @(isEn ? "Graldev partners with enterprises to analyze, design, and implement integrated IT solutions. We connect software, data, infrastructures, and AI to streamline processes and eliminate inefficiencies." : "Graldev affianca le aziende nell'analisi, progettazione e realizzazione di soluzioni IT integrate. Connettiamo software, dati, infrastrutture e AI per semplificare processi, eliminare inefficienze e supportare l'evoluzione del business.")
            </p>
            <div class="dp-hero-actions" style="display: flex; gap: 16px; flex-wrap: wrap;">
                <a href="@(isEn ? "/en/contact" : "/contatti")" class="dp-btn dp-btn-primary">
                    @(isEn ? "Let's talk about your needs" : "Parliamo della tua esigenza")
                </a>
                <a href="#metodo" class="dp-btn dp-btn-secondary">
                    @(isEn ? "How we work" : "Scopri come lavoriamo")
                </a>
            </div>
        </div>

        <div class="split-right dp-hero-visual" style="height: 520px; background-color: var(--bg-cream); border-radius: var(--radius-lg); border: 1.5px solid var(--border-warm); box-shadow: var(--shadow-soft-depth); overflow: hidden; display: flex; justify-content: center; align-items: center; position: relative;">
            <div class="dp-visual-scene" id="interactive-scene">
                <!-- Floating badging -->
                <div class="dp-floating-node dp-fn-1" style="transform: translateZ(30px);">
                    <span style="font-size: 1.2rem;">🔗</span> System Integration
                </div>
                <div class="dp-floating-node dp-fn-2" style="transform: translateZ(50px);">
                    <span style="font-size: 1.2rem;">🤖</span> AI Integration
                </div>
                <div class="dp-floating-node dp-fn-3" style="transform: translateZ(40px);">
                    <span style="font-size: 1.2rem;">🧠</span> IT Consulting
                </div>

                <!-- Three dimensional plates representing systemic convergence -->
                <div class="dp-glass-plate dp-glass-plate-1" style="transform: rotateY(-32deg) rotateX(15deg) translateZ(100px) translateX(-110px);">
                    <div class="dp-glass-plate-bg" style="background-color: var(--brand-green); opacity: 0.05;"></div>
                    <div style="font-weight: 800; font-size: 0.8rem; color: var(--brand-green); text-transform: uppercase;">ERP & CRM Data</div>
                    <div style="font-size: 1.3rem; font-weight: 800; color: var(--brand-green-dark); line-height: 1.2;">Enterprise Systems</div>
                    <div style="font-size: 0.8rem; color: var(--text-soft);">Core repositories synchronized.</div>
                </div>

                <div class="dp-glass-plate dp-glass-plate-2" style="transform: rotateY(-32deg) rotateX(15deg) translateZ(20px) translateX(0px);">
                    <div class="dp-glass-plate-bg" style="background-color: var(--brand-green-dark); opacity: 0.15;"></div>
                    <div style="font-weight: 800; font-size: 0.8rem; color: var(--green-300); text-transform: uppercase;">Graldev Layer</div>
                    <div style="font-size: 1.3rem; font-weight: 800; color: white; line-height: 1.2;">Integration & Consulting</div>
                    <div style="font-size: 0.8rem; color: var(--text-inverse-soft);">The orchestrator.</div>
                </div>

                <div class="dp-glass-plate dp-glass-plate-3" style="transform: rotateY(-32deg) rotateX(15deg) translateZ(-80px) translateX(110px);">
                    <div class="dp-glass-plate-bg" style="background-color: var(--bg-stone); opacity: 0.25;"></div>
                    <div style="font-weight: 800; font-size: 0.8rem; color: var(--brand-green); text-transform: uppercase;">Cognitive AI</div>
                    <div style="font-size: 1.3rem; font-weight: 800; color: var(--brand-green-dark); line-height: 1.2;">Autonomous Flow</div>
                    <div style="font-size: 0.8rem; color: var(--text-soft);">Intelligent agents orchestrating.</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Scannable Problem Grid: When to involve Graldev -->
<section id="involvere" class="alt-section" style="padding: 4rem 0;">
    <div class="container">
        <div style="text-align: center; margin-bottom: 2.5rem;">
            <span class="section-eyebrow">@(isEn ? "SITUATIONS" : "CONTESTO")</span>
            <h2 class="section-title" style="margin: 0 auto 0.75rem auto; font-weight: 900;">@(isEn ? "When it makes sense to involve Graldev" : "Quando ha senso coinvolgere Graldev")</h2>
            <p class="section-subtitle" style="margin: 0 auto; max-width: 600px; font-size: 1.05rem;">
                @(isEn ? "Concrete friction points we solve inside your operational systems and data workflows:" : "Frizioni operative reali che eliminiamo dai tuoi processi e sistemi:")
            </p>
        </div>

        <div class="involve-items" style="gap: 1rem;">
            <div class="involve-item" style="padding: 1rem;">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text" style="font-size: 0.95rem;">@(isEn ? "Systems are disconnected." : "I tuoi sistemi non comunicano tra loro.")</span>
            </div>
            <div class="involve-item" style="padding: 1rem;">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text" style="font-size: 0.95rem;">@(isEn ? "Manual copy-paste entry." : "Lo stesso dato viene inserito in più piattaforme.")</span>
            </div>
            <div class="involve-item" style="padding: 1rem;">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text" style="font-size: 0.95rem;">@(isEn ? "Workflows stuck in Excel." : "Troppi processi vitali dipendono da fogli Excel.")</span>
            </div>
            <div class="involve-item" style="padding: 1rem;">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text" style="font-size: 0.95rem;">@(isEn ? "ERP/CRM/eCommerce out of sync." : "I cataloghi e ordini non si aggiornano da soli.")</span>
            </div>
            <div class="involve-item" style="padding: 1rem;">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text" style="font-size: 0.95rem;">@(isEn ? "Legacy systems hold back growth." : "Il software esistente frena l'evoluzione aziendale.")</span>
            </div>
            <div class="involve-item" style="padding: 1rem;">
                <span class="involve-item-icon">✓</span>
                <span class="involve-item-text" style="font-size: 0.95rem;">@(isEn ? "Adopting AI without clear ROI." : "Vuoi usare l'AI ma non sai dove generi reale valore.")</span>
            </div>
        </div>

        <div style="text-align: center; margin-top: 2.5rem;">
            <a href="@(isEn ? "/en/contact" : "/contatti")" class="btn btn-primary" style="padding: 0.75rem 1.75rem;">
                @(isEn ? "Tell us your problem" : "Raccontaci il problema")
            </a>
        </div>
    </div>
</section>

<!-- Method Redesign: Scannable Consulting Timeline with Neomorphic Icon Boxes -->
<section id="metodo" class="white-section" style="padding: 6rem 0; background-color: var(--bg-cream);">
    <div class="container">
        <div style="text-align: center; margin-bottom: 4rem;">
            <span class="dp-section-eyebrow">@(isEn ? "OUR METHOD" : "IL NOSTRO METODO")</span>
            <h2 class="dp-section-title" style="margin: 0 auto 1rem auto;">@(isEn ? "Dalla complessità alla soluzione." : "Dalla complessità alla soluzione.")</h2>
            <p class="dp-section-desc" style="margin: 0 auto; max-width: 680px;">
                @(isEn ? "We do not sell boxed software. We analyze your infrastructure, map data, and engineer appropriate solutions." : "Non vendiamo software a scatola chiusa. Analizziamo i flussi dati e disegniamo l'architettura d'integrazione corretta.")
            </p>
        </div>

        <div class="dp-workflow-timeline" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; position: relative;">
            <div class="dp-workflow-step">
                <div class="dp-workflow-icon-box">👂</div>
                <div class="dp-workflow-num">01 · ASCOLTO</div>
                <div class="dp-workflow-name" style="font-size: 1.15rem;">@(isEn ? "Ascolto" : "Ascolto")</div>
                <div class="dp-workflow-desc">@(isEn ? "Comprensione del problema e degli obiettivi." : "Comprensione del problema e degli obiettivi.")</div>
            </div>
            <div class="dp-workflow-step">
                <div class="dp-workflow-icon-box">🔍</div>
                <div class="dp-workflow-num">02 · ASSESSMENT</div>
                <div class="dp-workflow-name" style="font-size: 1.15rem;">@(isEn ? "Assessment" : "Assessment")</div>
                <div class="dp-workflow-desc">@(isEn ? "Analisi di sistemi, dati e infrastruttura." : "Analisi di sistemi, dati e infrastruttura.")</div>
            </div>
            <div class="dp-workflow-step">
                <div class="dp-workflow-icon-box">📐</div>
                <div class="dp-workflow-num">03 · ARCHITETTURA</div>
                <div class="dp-workflow-name" style="font-size: 1.15rem;">@(isEn ? "Architettura" : "Architettura")</div>
                <div class="dp-workflow-desc">@(isEn ? "Disegno della soluzione più appropriata." : "Disegno della soluzione più appropriata.")</div>
            </div>
            <div class="dp-workflow-step">
                <div class="dp-workflow-icon-box">🛠️</div>
                <div class="dp-workflow-num">04 · INTEGRATION</div>
                <div class="dp-workflow-name" style="font-size: 1.15rem;">@(isEn ? "Integrazione" : "Integrazione / Sviluppo")</div>
                <div class="dp-workflow-desc">@(isEn ? "Connessione sistemi esistenti e sviluppo." : "Connessione sistemi esistenti e sviluppo.")</div>
            </div>
            <div class="dp-workflow-step">
                <div class="dp-workflow-icon-box">📈</div>
                <div class="dp-workflow-num">05 · EVOLUTION</div>
                <div class="dp-workflow-name" style="font-size: 1.15rem;">@(isEn ? "Evoluzione" : "Evoluzione")</div>
                <div class="dp-workflow-desc">@(isEn ? "Monitoring, supporto e miglioramenti." : "Monitoring, supporto e miglioramenti.")</div>
            </div>
        </div>
    </div>
</section>

<!-- Visual Capabilities Bento Cards Section (Bento Grid Redesign) -->
