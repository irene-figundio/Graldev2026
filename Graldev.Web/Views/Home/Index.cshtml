                    <span class="dp-bento-card-eyebrow">Custom Solutions</span>
                    <h3 class="dp-bento-card-title">Software Engineering</h3>
                    <p class="dp-bento-card-desc">
                        @(isEn ? "Sviluppiamo componenti e middleware robusti solo quando le piattaforme standard non bastano." : "Sviluppiamo componenti e middleware robusti solo quando le piattaforme standard non bastano.")
                    </p>
                </div>
                <div class="dp-bento-card-footer">
                    <a href="@(isEn ? "/en/services/software-engineering" : "/servizi/software-engineering")" class="dp-bento-link">@(isEn ? "Explore Area" : "Scopri l'Area") <span>→</span></a>
                </div>
            </div>

            <!-- Card 5: API & Cloud (Bento Large) -->
            <div class="dp-bento-card dp-bc-lg-2" style="grid-column: span 8; display: flex; flex-direction: column; justify-content: space-between;">
                <div class="dp-bento-card-header">
                    <span class="dp-bento-card-eyebrow">Data Synchronization</span>
                    <h3 class="dp-bento-card-title">API & Data Integration</h3>
                    <p class="dp-bento-card-desc" style="max-width: 450px;">
                        @(isEn ? "ETL pipelines, webhook integrations, and cloud migration architecture assessments." : "Sincronizzazione in tempo reale e data flow affidabili tra tutti i software e servizi esterni, con particolare focus su architetture cloud sicure e resilienti.")
