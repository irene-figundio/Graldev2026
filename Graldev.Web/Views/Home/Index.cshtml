   ========================================================= */

@@media (min-width: 993px) {

    /* Ogni dropdown diventa il proprio riferimento geometrico. */
    .site-header .main-nav > ul > li.has-dropdown {
        position: relative !important;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /*
       Il pannello viene centrato ESATTAMENTE sotto la voce padre.
       Reset esplicito di left/right/margin/transform evita conflitti
       con eventuali regole presenti in site.css.
    */
    .site-header .main-nav > ul > li.has-dropdown > .dropdown-menu {
        position: absolute !important;

        top: calc(100% + 14px) !important;
        left: 50% !important;
        right: auto !important;

        width: max-content;
        min-width: 286px;
        max-width: min(340px, calc(100vw - 32px));

        margin: 0 !important;

        transform:
            translateX(-50%)
            translateY(8px) !important;

        transform-origin: 50% 0;

        opacity: 0;
        visibility: hidden;
        pointer-events: none;

        padding: 10px !important;
        border-radius: 21px !important;

        background:
            linear-gradient(
                145deg,
                rgba(255, 255, 255, .60),
                rgba(240, 249, 244, .44)
            ) !important;

        border:
            1px solid rgba(255, 255, 255, .74) !important;

        -webkit-backdrop-filter:
            blur(32px) saturate(150%);
        backdrop-filter:
            blur(32px) saturate(150%);

        box-shadow:
            0 26px 64px rgba(31, 65, 44, .13),
            0 8px 20px rgba(31, 65, 44, .045),
            inset 0 1px 0 rgba(255, 255, 255, .90) !important;

        transition:
            opacity 180ms ease,
            transform 220ms cubic-bezier(.2, .75, .25, 1),
            visibility 180ms ease;
    }

    /*
       Hover e tastiera: stessa posizione, senza salti laterali.
    */
    .site-header .main-nav > ul > li.has-dropdown:hover > .dropdown-menu,
    .site-header .main-nav > ul > li.has-dropdown:focus-within > .dropdown-menu {
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;

        transform:
            translateX(-50%)
            translateY(0) !important;
    }

    /*
       Piccolo ponte trasparente tra voce e pannello.
       Evita che il dropdown si chiuda mentre il mouse attraversa
       i 14px di spazio.
    */
    .site-header .main-nav > ul > li.has-dropdown::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        height: 18px;
        pointer-events: auto;
    }

    /*
       La freccia/diamante del pannello è centrata rispetto
       ALLA VOCE, non più fissata a 24px dal bordo sinistro.
    */
    .site-header .main-nav > ul > li.has-dropdown > .dropdown-menu::before {
        content: "";
        position: absolute;

        top: -7px !important;
        left: 50% !important;
        right: auto !important;

        width: 14px;
        height: 14px;

        margin: 0 !important;

        transform:
            translateX(-50%)
            rotate(45deg) !important;

        background:
            rgba(250, 253, 251, .66);

        border-left:
            1px solid rgba(255, 255, 255, .76);
        border-top:
            1px solid rgba(255, 255, 255, .76);

        box-shadow:
            -4px -4px 12px rgba(255, 255, 255, .10);

        -webkit-backdrop-filter: blur(20px);
        backdrop-filter: blur(20px);

        pointer-events: none;
    }

    /*
       Le voci hanno larghezza naturale.
       Evita che il parent del dropdown erediti larghezze anomale.
    */
    .site-header .main-nav > ul > li.has-dropdown > .nav-item {
        width: auto !important;
        margin: 0 !important;
    }

    /*
       Servizi ha più contenuti: leggermente più largo.
       Settori resta più compatto.
    */
    .site-header .main-nav > ul > li.has-dropdown:nth-child(2) > .dropdown-menu {
        min-width: 310px;
        max-width: 340px;
    }

    .site-header .main-nav > ul > li.has-dropdown:nth-child(3) > .dropdown-menu {
        min-width: 286px;
        max-width: 310px;
    }

    /*
       Se il menu è vicino ai bordi del viewport, il pannello non deve
       mai uscire dallo schermo. Queste due regole sono una rete di
       sicurezza per viewport desktop più stretti.
    */
    @@media (max-width: 1120px) {
        .site-header .main-nav > ul > li.has-dropdown > .dropdown-menu {
            min-width: 260px;
            max-width: 290px;
        }
    }
}
    </style>
