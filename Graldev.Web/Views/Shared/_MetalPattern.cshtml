@model string

@{
    string id = string.IsNullOrWhiteSpace(Model)
        ? "default"
        : Model.ToLowerInvariant().Replace(" ", "-");

    string goldBase = $"metalGoldBase-{id}";
    string highlight = $"metalHighlight-{id}";
    string maskGradient = $"metalMaskGradient-{id}";
    string mask = $"metalMask-{id}";
    string emboss = $"metalEmboss-{id}";
    string motif = $"metalMotif-{id}";
}

<div class="hero-metal-pattern-wrap"
     aria-hidden="true">

    <svg class="hero-metal-pattern-svg"
         viewBox="0 0 1600 1000"
         preserveAspectRatio="xMidYMid slice"
         focusable="false"
         xmlns="http://www.w3.org/2000/svg">

        <defs>

            <linearGradient id="@goldBase"
                            x1="0"
                            y1="0"
                            x2="1600"
                            y2="1000"
                            gradientUnits="userSpaceOnUse">

                <stop offset="0%" stop-color="#8f651c" />
                <stop offset="18%" stop-color="#d4a93d" />
                <stop offset="34%" stop-color="#fff0a8" />
                <stop offset="46%" stop-color="#b77d16" />
                <stop offset="62%" stop-color="#f5d56d" />
                <stop offset="79%" stop-color="#9e6b16" />
                <stop offset="100%" stop-color="#e1b84d" />

            </linearGradient>

            <linearGradient id="@highlight"
                            x1="0"
                            y1="0"
                            x2="1"
                            y2="1">

                <stop offset="0%" stop-color="#c68c19" />
                <stop offset="28%" stop-color="#ffe793" />
                <stop offset="46%" stop-color="#ffffff" />
                <stop offset="58%" stop-color="#fff0ad" />
                <stop offset="78%" stop-color="#d8a42d" />
                <stop offset="100%" stop-color="#a26a12" />

            </linearGradient>

            <radialGradient id="@maskGradient">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                <stop offset="38%" stop-color="#ffffff" stop-opacity=".98" />
                <stop offset="68%" stop-color="#ffffff" stop-opacity=".42" />
                <stop offset="100%" stop-color="#000000" stop-opacity="0" />
            </radialGradient>

            <mask id="@mask"
                  maskUnits="userSpaceOnUse"
                  x="0"
                  y="0"
                  width="1600"
                  height="1000">

                <rect width="1600"
                      height="1000"
                      fill="#000000" />

                <circle class="hero-metal-shine-circle"
                        cx="800"
                        cy="350"
                        r="280"
                        fill="url(#@maskGradient)" />

            </mask>

            <filter id="@emboss"
                    x="-20%"
                    y="-20%"
                    width="140%"
                    height="140%">

                <feDropShadow dx="0"
                              dy="1"
                              stdDeviation=".7"
                              flood-color="#ffffff"
                              flood-opacity=".72" />

                <feDropShadow dx="0"
                              dy="2"
                              stdDeviation="1.6"
                              flood-color="#7c5517"
                              flood-opacity=".14" />

            </filter>

            <symbol id="@motif"
                    viewBox="0 0 520 520">

                <path d="
                M260 0 L520 155 L520 390 L260 520 L0 390 L0 155 Z
                M260 92 L392 170 L392 334 L260 412 L128 334 L128 170 Z
                M260 166 L326 205 L326 286 L260 326 L194 286 L194 205 Z
                M260 0 L260 92
                M0 155 L128 232
                M520 155 L392 232
                M0 390 L128 313
                M520 390 L392 313
                M260 412 L260 520
                " />

            </symbol>

        </defs>

        <g class="hero-metal-pattern-soft">
            <use href="#@motif" x="-20" y="-110" width="540" height="540" />
            <use href="#@motif" x="520" y="-110" width="540" height="540" />
            <use href="#@motif" x="1060" y="-110" width="540" height="540" />
            <use href="#@motif" x="250" y="380" width="540" height="540" />
            <use href="#@motif" x="790" y="380" width="540" height="540" />
        </g>

        <g class="hero-metal-pattern-base"
           style="stroke:url(#@goldBase);filter:url(#@emboss);">

            <use href="#@motif" x="-20" y="-110" width="540" height="540" />
            <use href="#@motif" x="520" y="-110" width="540" height="540" />
            <use href="#@motif" x="1060" y="-110" width="540" height="540" />
            <use href="#@motif" x="250" y="380" width="540" height="540" />
            <use href="#@motif" x="790" y="380" width="540" height="540" />

        </g>

        <g class="hero-metal-pattern-shine"
           style="stroke:url(#@highlight);mask:url(#@mask);">

            <use href="#@motif" x="-20" y="-110" width="540" height="540" />
            <use href="#@motif" x="520" y="-110" width="540" height="540" />
            <use href="#@motif" x="1060" y="-110" width="540" height="540" />
            <use href="#@motif" x="250" y="380" width="540" height="540" />
            <use href="#@motif" x="790" y="380" width="540" height="540" />

        </g>

    </svg>

</div>