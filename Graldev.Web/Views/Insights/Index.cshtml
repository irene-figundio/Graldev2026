@model IEnumerable<Graldev.Web.Controllers.InsightArticle>
@using Graldev.Web.Models

@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

@section Style {
    <style>
        .insights-page {
            --insights-copy: 760px;
        }

        /* =========================================================
                           INSIGHTS SECTION
                           ========================================================= */

        .insights-section {
            position: relative;
            padding: 7rem 0 7.5rem;
        }

        .insights-heading {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(300px, .55fr);
            gap: 3rem;
            align-items: end;
            margin-bottom: 3.5rem;
        }

            .insights-heading h2 {
                max-width: 760px;
                margin: 0;
                color: var(--brand-green-dark);
                font-size: clamp(2.15rem, 4vw, 3.5rem);
                line-height: 1.03;
                letter-spacing: -.045em;
            }

            .insights-heading p {
                max-width: 480px;
                margin: 0;
                color: var(--text-soft);
                font-size: .98rem;
                line-height: 1.72;
            }

        /* =========================================================
                           GRID
                           ========================================================= */

        .insights-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.25rem;
        }

        .insight-card {
            position: relative;
            min-height: 390px;
            padding: 2rem;
            border-radius: 27px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .insight-card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
        }

        .insight-index {
            color: var(--champagne-gold);
            font-size: .7rem;
            font-weight: 850;
            letter-spacing: .08em;
        }

        .insight-category {
            padding: .42rem .68rem;
            border-radius: 999px;
            color: var(--brand-green);
            background: rgba(17,171,100,.055);
            border: 1px solid rgba(17,171,100,.08);
            font-size: .63rem;
            font-weight: 800;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .insight-meta {
            display: block;
            margin: 2.5rem 0 .75rem;
            color: var(--champagne-gold);
            font-size: .69rem;
            font-weight: 780;
            letter-spacing: .065em;
            text-transform: uppercase;
        }

        .insight-card h3 {
            margin: 0 0 1rem;
            color: var(--brand-green-dark);
            font-size: clamp(1.45rem, 2.6vw, 2rem);
            line-height: 1.12;
            letter-spacing: -.035em;
        }

        .insight-card p {
            margin: 0;
            color: var(--text-soft);
            font-size: .92rem;
            line-height: 1.7;
        }

        /* =========================================================
                           LINK
                           ========================================================= */

        .insight-link {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            margin-top: 1.8rem;
            color: var(--brand-green-dark);
            font-size: .82rem;
            font-weight: 780;
            text-decoration: none;
        }

            .insight-link::after {
                content: "↗";
                color: var(--champagne-gold);
                transition: transform 180ms ease;
            }

            .insight-link:hover::after {
                transform: translate(2px, -2px);
            }

        /* =========================================================
                           EMPTY STATE
                           ========================================================= */

        .insights-empty {
            padding: 3rem;
            border-radius: 28px;
            text-align: center;
        }

            .insights-empty h3 {
                margin: 0 0 .8rem;
                color: var(--brand-green-dark);
                font-size: 1.5rem;
                letter-spacing: -.03em;
            }

            .insights-empty p {
                max-width: 560px;
                margin: 0 auto;
                color: var(--text-soft);
                line-height: 1.7;
            }

        /* =========================================================
                           CLOSING
                           ========================================================= */

        .insights-closing-section {
            padding: 0 0 7rem;
        }

        .insights-closing {
            position: relative;
            overflow: hidden;
            padding: clamp(2.8rem, 6vw, 5rem);
            border-radius: 32px;
            text-align: center;
            background: radial-gradient( circle at 50% 0%, rgba(255,255,255,.88), rgba(243,250,246,.72) 42%, rgba(230,244,236,.72) );
            border: 1px solid rgba(255,255,255,.82);
            box-shadow: 19px 24px 52px rgba(49,73,59,.09), inset 1px 1px 0 rgba(255,255,255,.96);
        }

            .insights-closing h2 {
                max-width: 820px;
                margin: 0 auto 1rem;
                color: var(--brand-green-dark);
                font-size: clamp(2rem, 4vw, 3.5rem);
                line-height: 1.04;
                letter-spacing: -.045em;
            }

            .insights-closing p {
                max-width: 650px;
                margin: 0 auto;
                color: var(--text-soft);
                line-height: 1.72;
            }

        /* =========================================================
                           RESPONSIVE
                           ========================================================= */

        @@media (max-width: 1100px) {
            .insights-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 900px) {
            .insights-heading {
                grid-template-columns: 1fr;
                gap: 1.2rem;
            }
        }

        @@media (max-width: 700px) {
            .insights-section {
                padding: 5.5rem 0;
            }

            .insights-grid {
                grid-template-columns: 1fr;
            }

            .insight-card {
                min-height: 320px;
            }
        }

        @@media (max-width: 520px) {
            .insight-card {
                padding: 1.5rem;
                border-radius: 23px;
            }

            .insights-closing {
                padding: 3rem 1.35rem;
                border-radius: 26px;
            }
        }
    </style>
}

<div class="insights-page">

    @await Html.PartialAsync(
        "_MetalHero",
        new MetalHeroViewModel
        {
            Id = "insights",

            Size = "large",

            Eyebrow = isEn
                ? "INSIGHTS · GUIDES · STRATEGY"
                : "INSIGHTS · GUIDE · STRATEGIA",

            Title = isEn
                ? "Technical insight. Clear business decisions."
                : "Competenza tecnologica. Decisioni più chiare.",

            Subtitle = isEn
                ? "Guides and strategic analyses from Graldev consultants on system integration, enterprise AI, software modernization and digital architecture."
                : "Guide e analisi strategiche curate dai consulenti Graldev su system integration, AI enterprise, modernizzazione software e architetture digitali.",

            Breadcrumbs = new List<MetalHeroBreadcrumbItem>
            {
                new()
                {
                    Label = "Home",
                    Url = isEn ? "/en" : "/"
                },
                new()
                {
                    Label = "Insights",
                    IsCurrent = true
                }
            }
        }
    )


    <!-- ==========================================================
         INSIGHTS LIBRARY
         ========================================================== -->
    <section class="insights-section premium-pale-green soft-transition transition-from-warm">

        <div class="container">

            <div class="insights-heading">

                <div>

                    <span class="section-eyebrow">
                        @(isEn
                            ? "KNOWLEDGE LIBRARY"
                            : "KNOWLEDGE LIBRARY")
                    </span>

                    <h2>
                        @(isEn
                            ? "Technology explained from an operational perspective."
                            : "Tecnologia spiegata dal punto di vista operativo.")
                    </h2>

                </div>

                <p>
                    @(isEn
                        ? "Our insights focus on the decisions behind architectures, integrations and automation — not on buzzwords."
                        : "I nostri approfondimenti si concentrano sulle decisioni che stanno dietro architetture, integrazioni e automazione, non sui buzzword.")
                </p>

            </div>


            @if (Model != null && Model.Any())
            {
                <div class="insights-grid">

                    @{
                        int articleIndex = 1;
                    }

                    @foreach (var article in Model)
                    {
                        string motif = "architecture";

                        if (!string.IsNullOrWhiteSpace(article.Category))
                        {
                            var category = article.Category.ToLowerInvariant();

                            if (category.Contains("ai"))
                            {
                                motif = "ai";
                            }
                            else if (category.Contains("data"))
                            {
                                motif = "data";
                            }
                            else if (category.Contains("integration"))
                            {
                                motif = "network";
                            }
                            else if (category.Contains("cloud"))
                            {
                                motif = "cloud";
                            }
                        }


                        <article class="premium-card insight-card"
                                 data-motif="@motif">

                            <div>

                                <div class="insight-card-top">

                                    <span class="insight-index">
                                        @articleIndex.ToString("00")
                                    </span>

                                    <span class="insight-category">
                                        @article.Category
                                    </span>

                                </div>

                                <span class="insight-meta">
                                    @article.PublishedAt
                                </span>

                                <h3>
                                    @article.Title
                                </h3>

                                <p>
                                    @article.Excerpt
                                </p>

                            </div>

                            <a href="@(isEn
                                                           ? $"/en/insights/{article.Slug}"
                                                           : $"/insights/{article.Slug}")"
                               class="insight-link">

                                @(isEn
                                    ? "Read article"
                                    : "Leggi l'articolo")

                            </a>

                        </article>

                        articleIndex++;
                    }

                </div>
            }
            else
            {
                <div class="premium-card insights-empty"
                     data-motif="architecture">

                    <h3>
                        @(isEn
                            ? "New insights are coming."
                            : "Nuovi approfondimenti in arrivo.")
                    </h3>

                    <p>
                        @(isEn
                            ? "We are preparing new technical guides and strategic analyses."
                            : "Stiamo preparando nuove guide tecniche e analisi strategiche.")
                    </p>

                </div>
            }
        </div>

    </section>


    <!-- ==========================================================
         CLOSING
         ========================================================== -->
    <section class="insights-closing-section bg-warm-white soft-transition transition-from-green">

        <div class="container">

            <div class="insights-closing">

                <span class="section-eyebrow">
                    @(isEn
                        ? "FROM TECHNOLOGY TO DECISIONS"
                        : "DALLA TECNOLOGIA ALLE DECISIONI")
                </span>

                <h2>
                    @(isEn
                        ? "Understand the architecture before choosing the technology."
                        : "Comprendere l'architettura prima di scegliere la tecnologia.")
                </h2>

                <p>
                    @(isEn
                        ? "The goal of our insights is to make complex technical choices easier to evaluate in terms of operations, maintainability and business value."
                        : "L'obiettivo dei nostri insights è rendere le scelte tecnologiche complesse più facili da valutare in termini di operatività, manutenibilità e valore per il business.")
                </p>

            </div>

        </div>

    </section>

</div>