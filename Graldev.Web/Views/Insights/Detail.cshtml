@model Graldev.Web.Controllers.InsightArticle
@using Graldev.Web.Models

@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

@section Style {
    <style>
        .insight-detail-page {
            --insight-width: 900px;
        }

            /* =========================================================
                   HERO OVERRIDES
                   ========================================================= */

            .insight-detail-page .metal-hero-compact .section-title {
                max-width: 900px;
                font-size: clamp(2.6rem, 5vw, 4.5rem);
                line-height: 1.03;
            }

            .insight-detail-page .metal-hero-compact .section-subtitle {
                max-width: 780px;
                font-size: clamp(1.05rem, 1.5vw, 1.18rem);
                line-height: 1.7;
            }

        /* =========================================================
                   ARTICLE META
                   ========================================================= */

        .insight-meta-section {
            position: relative;
            padding: 0;
        }

        .insight-meta-shell {
            position: relative;
            z-index: 5;
            width: min(var(--insight-width), 100%);
            margin-top: -2rem;
        }

        .insight-meta-card {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            overflow: hidden;
            border-radius: 24px;
        }

        .insight-meta-item {
            position: relative;
            min-height: 105px;
            padding: 1.35rem 1.4rem;
        }

            .insight-meta-item + .insight-meta-item {
                border-left: 1px solid rgba(16,73,40,.065);
            }

        .insight-meta-label {
            display: block;
            margin-bottom: .4rem;
            color: var(--champagne-gold);
            font-size: .65rem;
            font-weight: 820;
            letter-spacing: .085em;
            text-transform: uppercase;
        }

        .insight-meta-value {
            color: var(--brand-green-dark);
            font-size: .88rem;
            font-weight: 720;
            line-height: 1.45;
        }

        /* =========================================================
                   ARTICLE BODY
                   ========================================================= */

        .insight-article-section {
            position: relative;
            padding: 5.5rem 0 7rem;
        }

        .insight-article-container {
            width: min(var(--insight-width), 100%);
        }

        .insight-article {
            position: relative;
            padding: clamp(1.7rem, 4vw, 3.1rem);
            border-radius: 30px;
            color: var(--text-soft);
            font-size: 1.03rem;
            line-height: 1.85;
        }

            .insight-article > *:first-child {
                margin-top: 0;
            }

            .insight-article > *:last-child {
                margin-bottom: 0;
            }

            .insight-article h2,
            .insight-article h3,
            .insight-article h4 {
                color: var(--brand-green-dark);
                letter-spacing: -.035em;
            }

            .insight-article h2 {
                margin: 2.5rem 0 1rem;
                font-size: clamp(1.8rem, 3vw, 2.5rem);
                line-height: 1.08;
            }

            .insight-article h3 {
                margin: 2rem 0 .85rem;
                font-size: clamp(1.35rem, 2.3vw, 1.8rem);
                line-height: 1.15;
            }

            .insight-article h4 {
                margin: 1.7rem 0 .75rem;
                font-size: 1.2rem;
            }

            .insight-article p {
                margin: 0 0 1.25rem;
            }

            .insight-article ul,
            .insight-article ol {
                margin: 1rem 0 1.5rem;
                padding-left: 1.35rem;
            }

            .insight-article li + li {
                margin-top: .5rem;
            }

            .insight-article strong {
                color: var(--brand-green-dark);
                font-weight: 760;
            }

            .insight-article a {
                color: var(--brand-green-dark);
                font-weight: 700;
                text-decoration-color: rgba(197,160,89,.75);
                text-underline-offset: .16em;
            }

            .insight-article blockquote {
                margin: 2rem 0;
                padding: 1.25rem 1.4rem;
                border-left: 2px solid var(--champagne-gold);
                color: var(--brand-green-dark);
                font-weight: 620;
                line-height: 1.7;
                background: linear-gradient( 90deg, rgba(197,160,89,.075), transparent );
            }

            .insight-article code {
                padding: .16rem .34rem;
                border-radius: 6px;
                color: var(--brand-green-dark);
                background: rgba(16,73,40,.055);
                font-size: .9em;
            }

            .insight-article pre {
                overflow-x: auto;
                margin: 1.5rem 0;
                padding: 1.2rem;
                border-radius: 16px;
                color: var(--brand-green-dark);
                background: rgba(255,255,255,.48);
                border: 1px solid rgba(16,73,40,.07);
                line-height: 1.55;
            }

            .insight-article img {
                display: block;
                max-width: 100%;
                height: auto;
                margin: 2rem auto;
                border-radius: 18px;
                box-shadow: 0 14px 32px rgba(42,79,57,.08);
            }

            .insight-article table {
                width: 100%;
                margin: 1.7rem 0;
                border-collapse: collapse;
                font-size: .92rem;
            }

            .insight-article th,
            .insight-article td {
                padding: .8rem .9rem;
                text-align: left;
                border-bottom: 1px solid rgba(16,73,40,.08);
            }

            .insight-article th {
                color: var(--brand-green-dark);
                font-weight: 780;
            }

        /* =========================================================
                   FOOTER ACTIONS
                   ========================================================= */

        .insight-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 1px solid rgba(16,73,40,.08);
        }

            .insight-actions .btn {
                min-height: 49px;
                padding: .82rem 1.5rem;
            }

        /* =========================================================
                   RESPONSIVE
                   ========================================================= */

        @@media (max-width: 760px) {
            .insight-meta-shell {
                margin-top: -1rem;
            }

            .insight-meta-card {
                grid-template-columns: 1fr;
                border-radius: 21px;
            }

            .insight-meta-item {
                min-height: auto;
                padding: 1.15rem 1.25rem;
            }

                .insight-meta-item + .insight-meta-item {
                    border-left: 0;
                    border-top: 1px solid rgba(16,73,40,.065);
                }

            .insight-article-section {
                padding: 4rem 0 5.5rem;
            }

            .insight-article {
                padding: 1.4rem;
                border-radius: 23px;
                font-size: .98rem;
            }

            .insight-actions {
                flex-direction: column;
                align-items: stretch;
            }

                .insight-actions .btn {
                    width: 100%;
                    justify-content: center;
                }
        }
    </style>
}

<div class="insight-detail-page">

    @await Html.PartialAsync(
        "_MetalHero",
        new MetalHeroViewModel
        {
            Id = "insight-detail",

            Size = "compact",

            Eyebrow = $"{Model.Category} · {Model.PublishedAt}",

            Title = Model.Title,

            Subtitle = Model.Excerpt,

            Breadcrumbs = new List<MetalHeroBreadcrumbItem>
            {
                new()
                {
                    Label = "Home",
                    Url = isEn ? "/en" : "/"
                },
                new()
                {
                    Label = "Insights",
                    Url = isEn ? "/en/insights" : "/insights"
                },
                new()
                {
                    Label = Model.Title,
                    IsCurrent = true
                }
            }
        }
    )


    <!-- ==========================================================
         ARTICLE META
         ========================================================== -->
    <section class="insight-meta-section premium-pale-green">

        <div class="container insight-meta-shell">

            <div class="premium-card insight-meta-card">

                <div class="insight-meta-item">

                    <span class="insight-meta-label">
                        @(isEn ? "Author" : "Autore")
                    </span>

                    <div class="insight-meta-value">
                        @Model.Author
                    </div>

                </div>

                <div class="insight-meta-item">

                    <span class="insight-meta-label">
                        @(isEn ? "Published" : "Pubblicato")
                    </span>

                    <div class="insight-meta-value">
                        @Model.PublishedAt
                    </div>

                </div>

                <div class="insight-meta-item">

                    <span class="insight-meta-label">
                        @(isEn ? "Category" : "Categoria")
                    </span>

                    <div class="insight-meta-value">
                        @Model.Category
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         ARTICLE
         ========================================================== -->
    <section class="insight-article-section premium-pale-green soft-transition transition-from-warm">

        <div class="container insight-article-container">

            <article class="premium-card insight-article"
                     data-motif="architecture">

                @Html.Raw(Model.Content)

            </article>


            <div class="insight-actions">

                <a href="@(isEn
                                               ? "/en/insights"
                                               : "/insights")"
                   class="btn btn-secondary">

                    ← @(isEn
                                            ? "Back to Insights"
                                            : "Torna agli Insights")

                </a>

                <a href="@(isEn
                                               ? "/en/contact"
                                               : "/contatti")"
                   class="btn btn-primary">

                    @(isEn
                        ? "Discuss your requirement"
                        : "Parliamo della tua esigenza")

                </a>

            </div>

        </div>

    </section>

</div>