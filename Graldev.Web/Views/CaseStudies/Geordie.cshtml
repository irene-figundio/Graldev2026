@using Graldev.Web.Models

@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

@section Style {
    <style>
        .geo-case {
            --geo-max-copy: 720px;
            --geo-border: rgba(16, 73, 40, .08);
            --geo-gold-border: rgba(197, 160, 89, .22);
        }

        /* =========================================================
                   PROJECT OVERVIEW
                   ========================================================= */

        .geo-overview-section {
            position: relative;
            padding: 0 0 6.5rem;
        }

        .geo-overview-shell {
            position: relative;
            z-index: 5;
            margin-top: -2.1rem;
        }

        .geo-overview-grid {
            display: grid;
            grid-template-columns: 1.15fr 1.15fr 1.35fr 1fr;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, .78);
            border-radius: 27px;
            background: linear-gradient( 145deg, rgba(255, 255, 255, .69), rgba(247, 252, 249, .52) 45%, rgba(231, 245, 237, .43) );
            -webkit-backdrop-filter: blur(22px) saturate(122%);
            backdrop-filter: blur(22px) saturate(122%);
            box-shadow: 18px 22px 48px rgba(49, 73, 59, .09), -10px -10px 30px rgba(255, 255, 255, .74), inset 1px 1px 0 rgba(255, 255, 255, .95);
        }

        .geo-meta {
            position: relative;
            min-height: 148px;
            padding: 1.8rem 1.65rem;
        }

            .geo-meta + .geo-meta {
                border-left: 1px solid rgba(16, 73, 40, .065);
            }

            .geo-meta::before {
                content: "";
                position: absolute;
                top: 0;
                left: 1.65rem;
                width: 34px;
                height: 2px;
                border-radius: 999px;
                background: linear-gradient( 90deg, var(--champagne-gold), rgba(197, 160, 89, .15) );
            }

        .geo-meta-label {
            display: block;
            margin-bottom: .75rem;
            color: var(--champagne-gold);
            font-size: .68rem;
            font-weight: 800;
            letter-spacing: .095em;
            text-transform: uppercase;
        }

        .geo-meta-value {
            max-width: 255px;
            color: var(--brand-green-dark);
            font-size: clamp(1rem, 1.3vw, 1.15rem);
            font-weight: 780;
            line-height: 1.4;
            letter-spacing: -.025em;
        }

        /* =========================================================
                   CONTENT
                   ========================================================= */

        .geo-content-section {
            position: relative;
            padding: 7.5rem 0;
        }

        .geo-section-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.04fr) minmax(390px, .96fr);
            gap: clamp(3.5rem, 7vw, 7.5rem);
            align-items: center;
        }

        .geo-section-grid--reverse {
            grid-template-columns: minmax(390px, .96fr) minmax(0, 1.04fr);
        }

        .geo-copy {
            max-width: var(--geo-max-copy);
        }

            .geo-copy h2 {
                max-width: 700px;
                margin: 0 0 1.4rem;
                color: var(--brand-green-dark);
                font-size: clamp(2.15rem, 4vw, 3.6rem);
                line-height: 1.02;
                letter-spacing: -.045em;
            }

            .geo-copy > p {
                margin: 0;
                max-width: 700px;
                color: var(--text-soft);
                font-size: clamp(1rem, 1.4vw, 1.08rem);
                line-height: 1.82;
            }

        .geo-copy-highlight {
            margin-top: 2rem;
            padding: 1.25rem 1.35rem;
            border-left: 2px solid var(--champagne-gold);
            color: var(--brand-green-dark);
            font-size: .98rem;
            font-weight: 650;
            line-height: 1.65;
            background: linear-gradient( 90deg, rgba(197, 160, 89, .075), transparent );
        }

        /* =========================================================
                   CONNECTED SYSTEMS
                   ========================================================= */

        .geo-network-card,
        .geo-flow-card {
            position: relative;
            padding: 2rem;
            border-radius: 28px;
        }

        .geo-card-kicker {
            display: flex;
            align-items: center;
            gap: .7rem;
            margin-bottom: 1.5rem;
            color: var(--brand-green);
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .09em;
            text-transform: uppercase;
        }

            .geo-card-kicker::before {
                content: "";
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--champagne-gold);
                box-shadow: 0 0 0 5px rgba(197, 160, 89, .10);
            }

        .geo-network-card h3,
        .geo-flow-card h3 {
            color: var(--brand-green-dark);
            letter-spacing: -.035em;
        }

        .geo-network-card h3 {
            margin: 0 0 1.6rem;
            font-size: 1.55rem;
        }

        .geo-flow-card h3 {
            margin: 0 0 .4rem;
            font-size: 1.45rem;
        }

        .geo-system-list {
            display: grid;
            gap: .72rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .geo-system-item {
            display: grid;
            grid-template-columns: 44px minmax(0, 1fr);
            gap: .9rem;
            align-items: center;
            min-height: 68px;
            padding: .75rem .85rem;
            border: 1px solid rgba(255, 255, 255, .48);
            border-radius: 16px;
            background: rgba(255, 255, 255, .26);
        }

        .geo-system-icon {
            width: 44px;
            height: 44px;
            display: grid;
            place-items: center;
            border-radius: 13px;
            border: 1px solid rgba(255, 255, 255, .78);
            background: linear-gradient( 145deg, rgba(255, 255, 255, .75), rgba(229, 244, 235, .46) );
            box-shadow: 7px 8px 18px rgba(42, 79, 57, .065), inset 1px 1px 0 rgba(255, 255, 255, .96);
            color: var(--brand-green-dark);
            font-size: .67rem;
            font-weight: 850;
        }

        .geo-system-name {
            color: var(--brand-green-dark);
            font-size: .91rem;
            font-weight: 720;
            line-height: 1.42;
        }

        .geo-system-type {
            display: block;
            margin-top: .12rem;
            color: var(--text-muted);
            font-size: .75rem;
            font-weight: 550;
        }

        /* =========================================================
                   FLOW
                   ========================================================= */

        .geo-flow-intro {
            margin: 0 0 1.7rem;
            color: var(--text-muted);
            font-size: .88rem;
            line-height: 1.55;
        }

        .geo-flow {
            display: grid;
            gap: .65rem;
        }

        .geo-flow-step {
            display: grid;
            grid-template-columns: 38px minmax(0, 1fr) auto;
            gap: .85rem;
            align-items: center;
            min-height: 67px;
            padding: .72rem .85rem;
            border: 1px solid rgba(255, 255, 255, .50);
            border-radius: 16px;
            background: rgba(255, 255, 255, .27);
        }

        .geo-flow-index {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            color: var(--brand-green-dark);
            font-size: .72rem;
            font-weight: 850;
            border: 1px solid rgba(255, 255, 255, .78);
            background: linear-gradient( 145deg, rgba(255, 255, 255, .76), rgba(229, 244, 235, .42) );
            box-shadow: 6px 7px 16px rgba(42, 79, 57, .06), inset 1px 1px 0 rgba(255, 255, 255, .96);
        }

        .geo-flow-copy strong {
            display: block;
            color: var(--brand-green-dark);
            font-size: .88rem;
            line-height: 1.3;
        }

        .geo-flow-copy span {
            display: block;
            margin-top: .17rem;
            color: var(--text-muted);
            font-size: .73rem;
            line-height: 1.35;
        }

        .geo-flow-arrow {
            color: var(--champagne-gold);
        }

        .geo-flow-output {
            margin-top: .85rem;
            padding: 1.1rem 1.2rem;
            border-radius: 17px;
            border: 1px solid rgba(17, 171, 100, .10);
            background: linear-gradient( 135deg, rgba(17, 171, 100, .08), rgba(255, 255, 255, .27) );
        }

        .geo-flow-output-label {
            display: block;
            margin-bottom: .35rem;
            color: var(--brand-green);
            font-size: .65rem;
            font-weight: 820;
            letter-spacing: .09em;
            text-transform: uppercase;
        }

        .geo-flow-output strong {
            color: var(--brand-green-dark);
            font-size: .91rem;
            line-height: 1.45;
        }

        /* =========================================================
                   RESULTS
                   ========================================================= */

        .geo-results-section {
            padding: 6.8rem 0 7.2rem;
        }

        .geo-results-heading {
            max-width: 800px;
            margin: 0 auto 3.5rem;
            text-align: center;
        }

            .geo-results-heading h2 {
                margin: 0 0 1rem;
                color: var(--brand-green-dark);
                font-size: clamp(2.1rem, 4vw, 3.4rem);
                letter-spacing: -.045em;
            }

            .geo-results-heading p {
                max-width: 650px;
                margin: 0 auto;
                color: var(--text-soft);
                line-height: 1.72;
            }

        .geo-results-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem;
        }

        .geo-result {
            min-height: 225px;
            padding: 1.6rem;
            border-radius: 23px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .geo-result-number {
            color: var(--champagne-gold);
            font-size: .7rem;
            font-weight: 850;
            letter-spacing: .08em;
        }

        .geo-result h3 {
            margin: 2.4rem 0 .7rem;
            color: var(--brand-green-dark);
            font-size: 1.2rem;
            line-height: 1.2;
            letter-spacing: -.03em;
        }

        .geo-result p {
            margin: 0;
            color: var(--text-soft);
            font-size: .83rem;
            line-height: 1.55;
        }

        /* =========================================================
                   TESTIMONIALS
                   ========================================================= */

        .geo-feedback-section {
            padding: 7rem 0;
        }

        .geo-feedback-heading {
            max-width: 720px;
            margin: 0 auto 3.5rem;
            text-align: center;
        }

            .geo-feedback-heading h2 {
                margin: 0;
                color: var(--brand-green-dark);
                font-size: clamp(2rem, 3.7vw, 3rem);
                letter-spacing: -.045em;
            }

        .geo-feedback-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1.25rem;
        }

        .geo-quote {
            min-height: 300px;
            padding: 2.1rem;
            border-radius: 27px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .geo-quote-mark {
            color: var(--champagne-gold);
            font-family: Georgia, serif;
            font-size: 4rem;
            line-height: .7;
            opacity: .72;
        }

        .geo-quote blockquote {
            margin: 1.2rem 0 1.7rem;
            color: var(--text-soft);
            font-size: 1rem;
            line-height: 1.75;
        }

        .geo-quote-author {
            padding-top: 1rem;
            border-top: 1px solid rgba(16, 73, 40, .07);
        }

        .geo-quote-company {
            color: var(--brand-green-dark);
            font-size: .9rem;
            font-weight: 800;
        }

        .geo-quote-label {
            display: block;
            margin-top: .15rem;
            color: var(--text-muted);
            font-size: .7rem;
        }

        /* =========================================================
                   CTA
                   ========================================================= */

        .geo-cta-section {
            padding: 2rem 0 7rem;
        }

        .geo-cta {
            position: relative;
            overflow: hidden;
            padding: clamp(3rem, 7vw, 5.8rem);
            border-radius: 34px;
            text-align: center;
            background: radial-gradient( circle at 50% 0%, rgba(255,255,255,.88), rgba(245,251,247,.72) 38%, rgba(231,244,236,.72) 100% );
            border: 1px solid rgba(255,255,255,.80);
            box-shadow: 20px 25px 58px rgba(49,73,59,.095), inset 1px 1px 0 rgba(255,255,255,.96);
        }

            .geo-cta::before,
            .geo-cta::after {
                content: "";
                position: absolute;
                border-radius: 50%;
                pointer-events: none;
            }

            .geo-cta::before {
                width: 360px;
                height: 360px;
                left: -130px;
                top: -180px;
                background: radial-gradient( circle, rgba(197,160,89,.13), transparent 68% );
            }

            .geo-cta::after {
                width: 430px;
                height: 430px;
                right: -180px;
                bottom: -250px;
                background: radial-gradient( circle, rgba(17,171,100,.09), transparent 68% );
            }

        .geo-cta-content {
            position: relative;
            z-index: 2;
            max-width: 830px;
            margin: 0 auto;
        }

        .geo-cta h2 {
            margin: 0 auto 1.15rem;
            color: var(--brand-green-dark);
            font-size: clamp(2.15rem, 4.7vw, 4rem);
            line-height: 1.02;
            letter-spacing: -.05em;
        }

        .geo-cta p {
            max-width: 620px;
            margin: 0 auto 2rem;
            color: var(--text-soft);
            line-height: 1.72;
        }

        /* =========================================================
                   RESPONSIVE
                   ========================================================= */

        @@media (max-width: 1100px) {
            .geo-overview-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .geo-meta:nth-child(3) {
                border-left: 0;
            }

            .geo-meta:nth-child(3),
            .geo-meta:nth-child(4) {
                border-top: 1px solid rgba(16, 73, 40, .065);
            }

            .geo-section-grid,
            .geo-section-grid--reverse {
                grid-template-columns: minmax(0, 1fr) minmax(330px, .9fr);
                gap: 3rem;
            }

            .geo-results-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 860px) {
            .geo-overview-section {
                padding-bottom: 5rem;
            }

            .geo-section-grid,
            .geo-section-grid--reverse {
                grid-template-columns: 1fr;
                gap: 2.5rem;
            }

                .geo-section-grid--reverse .geo-visual {
                    order: 2;
                }

                .geo-section-grid--reverse .geo-copy {
                    order: 1;
                }

            .geo-content-section {
                padding: 5.5rem 0;
            }
        }

        @@media (max-width: 700px) {
            .geo-feedback-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 620px) {
            .geo-overview-shell {
                margin-top: -1.3rem;
            }

            .geo-overview-grid {
                grid-template-columns: 1fr;
                border-radius: 23px;
            }

            .geo-meta {
                min-height: 118px;
                padding: 1.45rem;
            }

                .geo-meta + .geo-meta,
                .geo-meta:nth-child(3),
                .geo-meta:nth-child(4) {
                    border-left: 0;
                    border-top: 1px solid rgba(16, 73, 40, .065);
                }

            .geo-network-card,
            .geo-flow-card {
                padding: 1.25rem;
                border-radius: 22px;
            }

            .geo-flow-step {
                grid-template-columns: 36px minmax(0, 1fr);
            }

            .geo-flow-arrow {
                display: none;
            }

            .geo-results-grid {
                grid-template-columns: 1fr;
            }

            .geo-result {
                min-height: 190px;
            }

            .geo-quote {
                min-height: auto;
                padding: 1.55rem;
            }

            .geo-cta {
                padding: 3rem 1.35rem;
                border-radius: 27px;
            }
        }
    </style>
}

<div class="geo-case">

    @await Html.PartialAsync(
        "_MetalHero",
        new MetalHeroViewModel
        {
            Id = "case-geordie",
            Size = "large",
            Eyebrow = "CASE STUDY · DIGITAL COMMERCE",
            Title = "Geordie: Omnichannel ERP & Multistore Integration",
            Subtitle = isEn
                ? "A centralized integration layer engineered to synchronize inventory, prices, orders and logistics across ERP systems, eCommerce stores, marketplaces and carriers."
                : "Un livello di integrazione centralizzato progettato per sincronizzare stock, prezzi, ordini e logistica tra ERP, store eCommerce, marketplace e corrieri.",

            Breadcrumbs = new List<MetalHeroBreadcrumbItem>
            {
                new()
                {
                    Label = "Home",
                    Url = isEn ? "/en" : "/"
                },
                new()
                {
                    Label = isEn ? "Case Studies" : "Case Study",
                    Url = isEn
                        ? "/en/case-studies"
                        : "/case-study"
                },
                new()
                {
                    Label = "Geordie",
                    IsCurrent = true
                }
            }
        }
    )

    <section class="premium-pale-green geo-overview-section">
        <div class="container geo-overview-shell">
            <div class="geo-overview-grid">

                <article class="geo-meta">
                    <span class="geo-meta-label">
                        @(isEn ? "Clients" : "Clienti")
                    </span>
                    <div class="geo-meta-value">
                        Soncar S.r.l. &amp; Dorenah
                    </div>
                </article>

                <article class="geo-meta">
                    <span class="geo-meta-label">
                        @(isEn ? "Sectors" : "Settori")
                    </span>
                    <div class="geo-meta-value">
                        Retail, eCommerce &amp; Automotive
                    </div>
                </article>

                <article class="geo-meta">
                    <span class="geo-meta-label">
                        @(isEn ? "Integrations" : "Integrazioni")
                    </span>
                    <div class="geo-meta-value">
                        Shopify, Amazon, eBay, GLS &amp; BRT
                    </div>
                </article>

                <article class="geo-meta">
                    <span class="geo-meta-label">
                        @(isEn ? "Platform" : "Piattaforma")
                    </span>
                    <div class="geo-meta-value">
                        Desktop &amp; Mobile Web App
                    </div>
                </article>

            </div>
        </div>
    </section>


    <section class="geo-content-section bg-warm-white soft-transition transition-from-green">
        <div class="container geo-section-grid">

            <div class="geo-copy">

                <span class="section-eyebrow">
                    @(isEn ? "THE CHALLENGE" : "LA SFIDA")
                </span>

                <h2>
                    @(isEn
                        ? "One inventory. Too many disconnected channels."
                        : "Un solo magazzino. Troppi canali scollegati.")
                </h2>

                <p>
                    @(isEn
                        ? "High-volume online sales were being managed across multiple systems without real-time synchronization. Inventory mismatches could result in products being sold after stock depletion, while orders, carrier requests and tracking updates required repeated manual operations."
                        : "La gestione di elevati volumi di vendita online avveniva attraverso sistemi differenti e privi di un allineamento in tempo reale. I disallineamenti di stock potevano causare vendite di prodotti ormai esauriti, mentre ordini, prese in carico dei corrieri e tracking richiedevano numerose operazioni manuali.")
                </p>

                <div class="geo-copy-highlight">
                    @(isEn
                        ? "The problem was not a single missing integration: it was the absence of a reliable orchestration layer connecting the entire commerce lifecycle."
                        : "Il problema non era una singola integrazione mancante, ma l'assenza di un livello affidabile di orchestrazione capace di collegare l'intero ciclo di vendita.")
                </div>

            </div>


            <div class="geo-visual">

                <article class="premium-card geo-network-card"
                         data-motif="network">

                    <div class="geo-card-kicker">
                        @(isEn ? "Commerce ecosystem" : "Ecosistema commerce")
                    </div>

                    <h3>
                        @(isEn ? "Connected systems" : "Sistemi da orchestrare")
                    </h3>

                    <ul class="geo-system-list">

                        <li class="geo-system-item">
                            <span class="geo-system-icon">ERP</span>
                            <span class="geo-system-name">
                                @(isEn ? "Internal ERP" : "ERP interno")
                                <span class="geo-system-type">
                                    @(isEn
                                        ? "Inventory, products and operational data"
                                        : "Magazzino, prodotti e dati operativi")
                                </span>
                            </span>
                        </li>

                        <li class="geo-system-item">
                            <span class="geo-system-icon">SHOP</span>
                            <span class="geo-system-name">
                                Shopify Stores
                                <span class="geo-system-type">
                                    @(isEn
                                        ? "Direct-to-consumer storefronts"
                                        : "Store proprietari direct-to-consumer")
                                </span>
                            </span>
                        </li>

                        <li class="geo-system-item">
                            <span class="geo-system-icon">MKT</span>
                            <span class="geo-system-name">
                                Amazon &amp; eBay
                                <span class="geo-system-type">
                                    @(isEn
                                        ? "External marketplace accounts"
                                        : "Account marketplace esterni")
                                </span>
                            </span>
                        </li>

                        <li class="geo-system-item">
                            <span class="geo-system-icon">API</span>
                            <span class="geo-system-name">
                                GLS &amp; BRT
                                <span class="geo-system-type">
                                    @(isEn
                                        ? "Shipping and tracking APIs"
                                        : "API di spedizione e tracking")
                                </span>
                            </span>
                        </li>

                    </ul>

                </article>

            </div>

        </div>
    </section>


    <section class="geo-content-section premium-pale-green soft-transition transition-from-warm">

        <div class="container geo-section-grid geo-section-grid--reverse">

            <div class="geo-visual">

                <article class="premium-card geo-flow-card"
                         data-motif="roadmap">

                    <div class="geo-card-kicker">
                        Geordie Middleware
                    </div>

                    <h3>
                        @(isEn
                            ? "One orchestration layer across the whole flow"
                            : "Un unico livello di orchestrazione")
                    </h3>

                    <p class="geo-flow-intro">
                        @(isEn
                            ? "Orders, stock and logistics move through one coordinated integration pipeline."
                            : "Ordini, stock e logistica attraversano un unico flusso coordinato.")
                    </p>

                    <div class="geo-flow">

                        <div class="geo-flow-step">
                            <span class="geo-flow-index">01</span>
                            <span class="geo-flow-copy">
                                <strong>
                                    @(isEn ? "Order acquisition" : "Acquisizione ordini")
                                </strong>
                                <span>
                                    @(isEn
                                        ? "Marketplace and store orders are collected automatically"
                                        : "Gli ordini vengono acquisiti automaticamente dai diversi canali")
                                </span>
                            </span>
                            <span class="geo-flow-arrow" aria-hidden="true">↓</span>
                        </div>

                        <div class="geo-flow-step">
                            <span class="geo-flow-index">02</span>
                            <span class="geo-flow-copy">
                                <strong>
                                    @(isEn ? "ERP synchronization" : "Sincronizzazione ERP")
                                </strong>
                                <span>
                                    @(isEn
                                        ? "Products, availability and internal records are reconciled"
                                        : "Prodotti, disponibilità e anagrafiche vengono allineati")
                                </span>
                            </span>
                            <span class="geo-flow-arrow" aria-hidden="true">↓</span>
                        </div>

                        <div class="geo-flow-step">
                            <span class="geo-flow-index">03</span>
                            <span class="geo-flow-copy">
                                <strong>
                                    @(isEn ? "Shipping automation" : "Automazione spedizioni")
                                </strong>
                                <span>
                                    @(isEn
                                        ? "Carrier APIs generate shipments and labels"
