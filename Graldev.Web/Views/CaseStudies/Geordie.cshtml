@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

<section class="case-study-hero">
    <div class="container">
        <span class="section-eyebrow">CASE STUDY: DIGITAL COMMERCE</span>
        <h1 class="section-title">Geordie: Omnichannel ERP & Multistore Integration</h1>
        <p class="section-subtitle">
            @(isEn ? "How Graldev engineered an automated middleware to synchronize inventory, prices, and massive sales flows across global eCommerce and marketplaces." : "In che modo Graldev ha ingegnerizzato un middleware automatico per sincronizzare magazzini, listini e ordini massivi tra ERP e canali di vendita digitali.")
        </p>

        <div class="case-study-meta-grid">
            <div>
                <div class="case-meta-label">Client / Clienti</div>
                <div class="case-meta-value">Soncar S.r.l. & Dorenah</div>
            </div>
            <div>
                <div class="case-meta-label">Sectors / Settori</div>
                <div class="case-meta-value">Retail, eCommerce & Automotive</div>
            </div>
            <div>
                <div class="case-meta-label">Key Integrations / Sistemi</div>
                <div class="case-meta-value">Shopify, Amazon, eBay, GLS, BRT APIs</div>
            </div>
            <div>
                <div class="case-meta-label">Target / Canali</div>
                <div class="case-meta-value">Desktop, Mobile Web Application</div>
            </div>
        </div>
    </div>
</section>

<!-- Visual Storytelling: Scannable Case study split into report layout -->
<section class="white-section" style="padding: 3rem 0;">
    <div class="container split-layout">
        <div class="split-left">
            <h3 class="case-block-title">THE CHALLENGE</h3>
            <p style="font-size: 1rem; line-height: 1.5;">
                @(isEn ? "Managing high-volume online stores manually caused inventory mismatches, double sales of unavailable stock, delayed shipping label creation, and human errors. Orders were picked multiple times or missed due to lack of real-time synchronization between the main warehouse database and eBay, Amazon, and Shopify channels." : "La gestione manuale di svariati store online ad alto volume causava continui disallineamenti di stock, doppie vendite di merce esaurita, e pesanti rallentamenti nell'elaborazione delle spedizioni. Senza un allineamento in tempo reale, gli operatori commettevano errori di copia-incolla per compilare le prese in carico e i tracking dei corrieri.")
            </p>
        </div>
        <div class="split-right">
            <!-- Systems Diagram -->
            <div class="card-glass" style="border-color: rgba(0, 138, 38, 0.25); background-color: var(--brand-green-soft); padding: 1.25rem;">
                <h4 style="color: var(--brand-green-dark); margin-bottom: 0.75rem; font-size: 1rem;">SISTEMI COLLEGATI</h4>
                <div style="display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.8rem; font-weight: 700;">
                    <div class="card-neomorphic" style="padding: 0.5rem;">🏢 ERP Interno (Produzione)</div>
                    <div class="card-neomorphic" style="padding: 0.5rem;">🛍️ Shopify Stores</div>
                    <div class="card-neomorphic" style="padding: 0.5rem;">📦 eBay & Amazon Accounts</div>
                    <div class="card-neomorphic" style="padding: 0.5rem;">🚚 GLS / BRT Carrier APIs</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="alt-section" style="padding: 3rem 0;">
    <div class="container split-layout" style="flex-direction: row-reverse;">
        <div class="split-left">
            <h3 class="case-block-title">THE SOLUTION</h3>
            <p style="font-size: 1rem; line-height: 1.5;">
                @(isEn ? "Graldev mapped API limits and drafted a custom centralized middleware. Geordie automatically downloads orders, maps records with the SQL database, schedules automated shipments with GLS/BRT, prints physical carrier labels, and updates customers with tracking numbers." : "Graldev ha progettato un middleware denominato Geordie. Il sistema allinea stock e prezzi su tutti i canali, preleva automaticamente le anagrafiche ordine per la fatturazione locale, invia le chiamate alle API GLS/BRT per generare le etichette di spedizione e spedisce le email con il codice di tracciamento.")
            </p>
        </div>
        <div class="split-right">
            <!-- Outcome points -->
            <div class="premium-card">
                <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">@(isEn ? "Outcome Metrics" : "Dati e Risultati Reali")</h3>
                <ul style="list-style-position: inside; color: var(--text-secondary); display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.85rem;">
                    <li>✔️ 24/365 Sincronizzazione automatica</li>
                    <li>✔️ Zero errori di presa in carico ordini</li>
                    <li>✔️ Emissione etichette istantanea in magazzino</li>
                    <li>✔️ Controllo completo del flusso dei corrieri</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Reviews and Real Quotes -->
<section class="white-section" style="padding: 3rem 0;">
    <div class="container">
        <div style="text-align: center; margin-bottom: 2rem;">
            <span class="section-eyebrow">FEEDBACK</span>
            <h2 style="font-weight: 900; font-size: 1.8rem;">@(isEn ? "Client Testimonials" : "Cosa dicono i nostri clienti")</h2>
        </div>

        <div class="grid-2" style="gap: 1.5rem;">
            <div class="case-quote-box">
                <p style="font-size: 0.95rem;">
                    "Da quando Geordie gestisce i nostri stores online le vendite sono aumentate e si è accelerato tutto il sistema degli ordini. Raccoglie e gestisce tutti gli ordini automaticamente, eliminando l'invio multiplo di merci."
                </p>
                <div style="font-weight: 700; margin-top: 0.75rem; color: var(--brand-green-dark); font-size: 0.9rem;">— Soncar S.r.l.</div>
            </div>

            <div class="case-quote-box">
                <p style="font-size: 0.95rem;">
                    "Geordie ha contribuito all'aumento del nostro fatturato. Un software molto semplice ed intuitivo con funzionalità cucite su misura per il nostro negozio online."
                </p>
                <div style="font-weight: 700; margin-top: 0.75rem; color: var(--brand-green-dark); font-size: 0.9rem;">— Dorenah</div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section style="text-align: center; background-color: var(--brand-green-soft);">
    <div class="container">
        <h2>@(isEn ? "Do you need to automate your commerce operations?" : "Devi ottimizzare i tuoi processi di vendita online?")</h2>
        <p style="max-width: 600px; margin: 0 auto 1.5rem auto; font-size: 1rem;">
            @(isEn ? "Schedule a dedicated technical review with Graldev senior integration consultants." : "Parla con i nostri consulenti per mappare i tuoi gestionali ed automatizzare i flussi ordini.")
        </p>
        <a href="@(isEn ? "/en/contact" : "/contatti")" class="btn btn-primary" style="padding: 0.75rem 1.5rem;">
            @(isEn ? "Parliamo della tua esigenza" : "Parliamo della tua esigenza")
        </a>
    </div>
</section>
