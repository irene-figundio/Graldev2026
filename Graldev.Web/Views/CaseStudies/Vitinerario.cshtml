@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

<section class="case-study-hero">
    <div class="container">
        <span class="section-eyebrow">CASE STUDY: AI INTEGRATION</span>
        <h1 class="section-title">Vitinerario: Virtual Sommelier AI Assistant</h1>
        <p class="section-subtitle">
            @(isEn ? "Integrating Large Language Models and Retrieval-Augmented Generation to build an interactive enological conversational advisor." : "Integrazione di Modelli Generativi di Linguaggio (LLM) e sistemi RAG per dare vita a un consulente enologico conversazionale interattivo.")
        </p>

        <div class="case-study-meta-grid">
            <div>
                <div class="case-meta-label">Client / Clienti</div>
                <div class="case-meta-value">Vitinerario App</div>
            </div>
            <div>
                <div class="case-meta-label">Sectors / Settori</div>
                <div class="case-meta-value">Agri-Tech, Food & Beverage, Tourism</div>
            </div>
            <div>
                <div class="case-meta-label">Key Integrations / Sistemi</div>
                <div class="case-meta-value">Semantic Databases, Vector Databases, OpenAI</div>
            </div>
            <div>
                <div class="case-meta-label">Target / Canali</div>
                <div class="case-meta-value">Mobile Web App, Conversational Assistant</div>
            </div>
        </div>
    </div>
</section>

<!-- Visual Storytelling split sections -->
<section class="white-section" style="padding: 3rem 0;">
    <div class="container split-layout">
        <div class="split-left">
            <h3 class="case-block-title">THE CHALLENGE</h3>
            <p style="font-size: 1rem; line-height: 1.5;">
                @(isEn ? "Standard search engines or rigid filter forms on gastronomy platforms fail to answer complex, human conversational queries like 'Which white wine from Basilicata matches truffle-based dishes?'. Traditional chatbots felt robotic, while generic public AI models lacked verified enological databases and often hallucinated." : "I tradizionali sistemi a filtri rigidi faticano ad accogliere richieste complesse e sfumate come 'Quale vino bianco lucano posso abbinare a un risotto al tartufo?'. D'altro canto, i chatbot commerciali tradizionali erano troppo rigidi e i modelli AI generici pubblici mancavano di fonti verificate ed allucinavano.")
            </p>
        </div>
        <div class="split-right">
            <!-- Systems Involved Glass panel -->
            <div class="card-glass" style="border-color: rgba(0, 138, 38, 0.25); background-color: var(--brand-green-soft); padding: 1.25rem;">
                <h4 style="color: var(--brand-green-dark); margin-bottom: 0.75rem; font-size: 1rem;">DATA SOURCES USED</h4>
                <div style="display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.8rem; font-weight: 700;">
                    <div class="card-neomorphic" style="padding: 0.5rem;">🍷 Specialized Wine Databases</div>
                    <div class="card-neomorphic" style="padding: 0.5rem;">💾 Vector Embeddings Databases</div>
                    <div class="card-neomorphic" style="padding: 0.5rem;">🧠 OpenAI GPT-4 Large Language Model</div>
                    <div class="card-neomorphic" style="padding: 0.5rem;">📡 API Connectors mapping local cellars</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="alt-section" style="padding: 3rem 0;">
    <div class="container split-layout" style="flex-direction: row-reverse;">
        <div class="split-left">
            <h3 class="case-block-title">THE SOLUTION</h3>
            <p style="font-size: 1rem; line-height: 1.5;">
                @(isEn ? "Graldev designed an enterprise RAG (Retrieval-Augmented Generation) pipeline. We segmented catalogs and winery cards, converting them into vector embeddings inside an isolated database. When a user asks a question, the system retrieves the verified parameters first, feeding them to the LLM as strict context, ensuring absolute accuracy." : "Graldev ha strutturato un'architettura RAG (Retrieval-Augmented Generation) sicura. Abbiamo suddiviso cataloghi enologici e schede cantine, memorizzandoli come vettori in un database cognitivo isolato. L'AI formula risposte precise ancorate esclusivamente a dati reali, suggerendo cantine ed etichette certificate.")
            </p>
        </div>
        <div class="split-right">
            <!-- Outcomes -->
            <div class="premium-card">
                <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">@(isEn ? "Outcome Metrics" : "Dati e Risultati Reali")</h3>
                <ul style="list-style-position: inside; color: var(--text-secondary); display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.85rem;">
                    <li>✔️ 100% Conversational Sommelier advice</li>
                    <li>✔️ Zero AI hallucinations on Wine types</li>
                    <li>✔️ Fully compliant with Graldev AI Governance</li>
                    <li>✔️ Responsive conversational interface</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section style="text-align: center; background-color: var(--brand-green-soft);">
    <div class="container">
        <h2>@(isEn ? "Do you want to integrate AI securely into your company workflows?" : "Vuoi integrare l'Intelligenza Artificiale nei tuoi flussi in modo sicuro?")</h2>
        <p style="max-width: 600px; margin: 0 auto 1.5rem auto; font-size: 1rem;">
            @(isEn ? "Schedule a dedicated AI feasibility review with Graldev cognitive technology partners." : "Fissa un incontro per mappare i tuoi dati ed individuare dove e come l'AI può portare reale efficienza operativa.")
        </p>
        <a href="@(isEn ? "/en/contact" : "/contatti")" class="btn btn-primary" style="padding: 0.75rem 1.5rem;">
            @(isEn ? "Parliamo della tua esigenza" : "Parliamo della tua esigenza")
        </a>
    </div>
</section>
