@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

<section class="case-study-hero">
    <div class="container">
        <span class="section-eyebrow">CASE STUDY: AR & INTERACTIVE TECH</span>
        <h1 class="section-title">Gralcall AR: Spatial Web Augmented Reality</h1>
        <p class="section-subtitle">
            @(isEn ? "How Graldev merged spatial WebAR technologies with video narration to create marker-based tourism and museum guides." : "In che modo Graldev ha unito la tecnologia WebAR ad itinerari video interattivi per valorizzare musei e borghi storici.")
        </p>

        <div class="case-study-meta-grid">
            <div>
                <div class="case-meta-label">Client & Partner</div>
                <div class="case-meta-value">Associazione Manthano ETS</div>
            </div>
            <div>
                <div class="case-meta-label">Sectors / Settori</div>
                <div class="case-meta-value">Tourism, Education, Cultural Heritage</div>
            </div>
            <div>
                <div class="case-meta-label">Key Integrations / Sistemi</div>
                <div class="case-meta-value">WebAR engines, HTML5 video frameworks, Mobile Web</div>
            </div>
            <div>
                <div class="case-meta-label">Target / Canali</div>
                <div class="case-meta-value">Mobile Web Browser, no-app WebAR</div>
            </div>
        </div>
    </div>
</section>

<!-- Visual Storytelling columns -->
<section class="white-section" style="padding: 3rem 0;">
    <div class="container split-layout">
        <div class="split-left">
            <h3 class="case-block-title">THE CHALLENGE</h3>
            <p style="font-size: 1rem; line-height: 1.5;">
                @(isEn ? "Traditional tourism mobile applications fail because tourists refuse to download and install heavy, platform-specific apps (iOS/Android) from stores merely to read a plaque or watch a short video. The solution had to be immediate, web-based, and zero-install." : "I tradizionali progetti basati su app native falliscono perché i turisti si rifiutano di scaricare ed installare pesanti applicazioni dagli store semplicemente per inquadrare una targa o guardare un breve video descrittivo. La soluzione doveva essere immediata, accessibile tramite web e senza alcuna installazione.")
            </p>
        </div>
        <div class="split-right">
            <!-- Systems Involved Glass Panel -->
            <div class="card-glass" style="border-color: rgba(0, 138, 38, 0.25); background-color: var(--brand-green-soft); padding: 1.25rem;">
                <h4 style="color: var(--brand-green-dark); margin-bottom: 0.75rem; font-size: 1rem;">INTEGRATED AR TECHS</h4>
                <div style="display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.8rem; font-weight: 700;">
                    <div class="card-neomorphic" style="padding: 0.5rem;">📱 Native Web Browsers</div>
                    <div class="card-neomorphic" style="padding: 0.5rem;">🕶️ MindAR Spatial Markers</div>
                    <div class="card-neomorphic" style="padding: 0.5rem;">🎨 Three.js / WebGL Renderers</div>
                    <div class="card-neomorphic" style="padding: 0.5rem;">📹 Interactive HTML5 video layers</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="alt-section" style="padding: 3rem 0;">
    <div class="container split-layout" style="flex-direction: row-reverse;">
        <div class="split-left">
            <h3 class="case-block-title">THE SOLUTION</h3>
            <p style="font-size: 1rem; line-height: 1.5;">
                @(isEn ? "Graldev engineered 'Gralcall AR', a versatile web application that activates augmented reality directly inside standard mobile web browsers. Users scan a custom QR-code on physical plaques, pointing their mobile cameras at designated target images to overlay digital reconstructions or videos." : "Graldev ha sviluppato Gralcall AR, una web-app universale che abilita la realtà aumentata direttamente nel browser nativo del cellulare, inquadrando un QR-code e sovrapponendo video storici e modelli 3D in tempo reale.")
            </p>
        </div>
        <div class="split-right">
            <!-- Outcomes -->
            <div class="premium-card">
                <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">@(isEn ? "Outcome Metrics" : "Dati e Risultati Reali")</h3>
                <ul style="list-style-position: inside; color: var(--text-secondary); display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.85rem;">
                    <li>✔️ 100% Zero-app installation required</li>
                    <li>✔️ Attivazione istantanea tramite fotocamera</li>
                    <li>✔️ Supporto a video nativi e modelli 3D</li>
                    <li>✔️ Statistiche sulle scansioni collegate nel backoffice</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section style="text-align: center; background-color: var(--brand-green-soft);">
    <div class="container">
        <h2>@(isEn ? "Bring immersive interactive spatial technology to your audience" : "Porta la Realtà Aumentata nei tuoi progetti")</h2>
        <p style="max-width: 600px; margin: 0 auto 1.5rem auto; font-size: 1rem;">
            @(isEn ? "Talk to our spatial technology consultants to design custom WebAR campaigns, educational tools or interactive showcases." : "Pianifica un incontro con i nostri specialisti di tecnologie immersive per ideare percorsi museali, cataloghi 3D o progetti educativi.")
        </p>
        <a href="@(isEn ? "/en/contact" : "/contatti")" class="btn btn-primary" style="padding: 0.75rem 1.5rem;">
            @(isEn ? "Parliamo della tua esigenza" : "Parliamo della tua esigenza")
        </a>
    </div>
</section>
