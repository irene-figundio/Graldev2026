@using Graldev.Web.Models

@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

@section Style {
    <style>
        .gralcall-page {
            --gralcall-copy: 760px;
        }

        /* =========================================================
                   PROJECT OVERVIEW
                   ========================================================= */

        .gralcall-overview {
            position: relative;
            padding: 0 0 6.5rem;
        }

        .gralcall-overview-shell {
            position: relative;
            z-index: 5;
            margin-top: -2rem;
        }

        .gralcall-overview-grid {
            display: grid;
            grid-template-columns: 1.15fr 1.15fr 1.35fr 1fr;
            overflow: hidden;
            border-radius: 27px;
            border: 1px solid rgba(255,255,255,.8);
            background: linear-gradient( 145deg, rgba(255,255,255,.69), rgba(247,252,249,.52) 45%, rgba(231,245,237,.43) );
            -webkit-backdrop-filter: blur(22px) saturate(122%);
            backdrop-filter: blur(22px) saturate(122%);
            box-shadow: 18px 22px 48px rgba(49,73,59,.09), -10px -10px 30px rgba(255,255,255,.74), inset 1px 1px 0 rgba(255,255,255,.95);
        }

        .gralcall-meta {
            position: relative;
            min-height: 148px;
            padding: 1.8rem 1.65rem;
        }

            .gralcall-meta + .gralcall-meta {
                border-left: 1px solid rgba(16,73,40,.065);
            }

            .gralcall-meta::before {
                content: "";
                position: absolute;
                top: 0;
                left: 1.65rem;
                width: 34px;
                height: 2px;
                border-radius: 999px;
                background: linear-gradient( 90deg, var(--champagne-gold), rgba(197,160,89,.15) );
            }

        .gralcall-meta-label {
            display: block;
            margin-bottom: .75rem;
            color: var(--champagne-gold);
            font-size: .68rem;
            font-weight: 800;
            letter-spacing: .095em;
            text-transform: uppercase;
        }

        .gralcall-meta-value {
            max-width: 255px;
            color: var(--brand-green-dark);
            font-size: clamp(1rem, 1.3vw, 1.15rem);
            font-weight: 780;
            line-height: 1.4;
            letter-spacing: -.025em;
        }

        /* =========================================================
                   CONTENT SECTIONS
                   ========================================================= */

        .gralcall-content-section {
            position: relative;
            padding: 7.5rem 0;
        }

        .gralcall-section-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.04fr) minmax(390px, .96fr);
            gap: clamp(3.5rem, 7vw, 7.5rem);
            align-items: center;
        }

        .gralcall-section-grid--reverse {
            grid-template-columns: minmax(390px, .96fr) minmax(0, 1.04fr);
        }

        .gralcall-copy {
            max-width: var(--gralcall-copy);
        }

            .gralcall-copy h2 {
                max-width: 700px;
                margin: 0 0 1.4rem;
                color: var(--brand-green-dark);
                font-size: clamp(2.15rem, 4vw, 3.6rem);
                line-height: 1.02;
                letter-spacing: -.045em;
            }

            .gralcall-copy > p {
                max-width: 700px;
                margin: 0;
                color: var(--text-soft);
                font-size: clamp(1rem, 1.4vw, 1.08rem);
                line-height: 1.82;
            }

        .gralcall-highlight {
            margin-top: 2rem;
            padding: 1.25rem 1.35rem;
            border-left: 2px solid var(--champagne-gold);
            color: var(--brand-green-dark);
            font-size: .98rem;
            font-weight: 650;
            line-height: 1.65;
            background: linear-gradient( 90deg, rgba(197,160,89,.075), transparent );
        }

        /* =========================================================
                   TECHNOLOGY CARD
                   ========================================================= */

        .gralcall-tech-card {
            padding: 2rem;
            border-radius: 29px;
        }

        .gralcall-card-kicker {
            display: inline-flex;
            align-items: center;
            gap: .65rem;
            margin-bottom: .7rem;
            color: var(--brand-green);
            font-size: .69rem;
            font-weight: 820;
            letter-spacing: .09em;
            text-transform: uppercase;
        }

            .gralcall-card-kicker::before {
                content: "";
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--champagne-gold);
                box-shadow: 0 0 0 5px rgba(197,160,89,.10);
            }

        .gralcall-tech-card h3 {
            margin: 0 0 1.5rem;
            color: var(--brand-green-dark);
            font-size: 1.55rem;
            line-height: 1.15;
            letter-spacing: -.035em;
        }

        .gralcall-tech-list {
            display: grid;
            gap: .72rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .gralcall-tech-item {
            display: grid;
            grid-template-columns: 48px minmax(0, 1fr);
            gap: .9rem;
            align-items: center;
            min-height: 70px;
            padding: .75rem .85rem;
            border: 1px solid rgba(255,255,255,.48);
            border-radius: 16px;
            background: rgba(255,255,255,.26);
        }

        .gralcall-tech-code {
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            border-radius: 13px;
            color: var(--brand-green-dark);
            font-size: .61rem;
            font-weight: 850;
            background: linear-gradient( 145deg, rgba(255,255,255,.76), rgba(229,244,235,.46) );
            border: 1px solid rgba(255,255,255,.78);
            box-shadow: 6px 7px 16px rgba(42,79,57,.06), inset 1px 1px 0 rgba(255,255,255,.96);
        }

        .gralcall-tech-copy strong {
            display: block;
            color: var(--brand-green-dark);
            font-size: .87rem;
            line-height: 1.3;
        }

        .gralcall-tech-copy span {
            display: block;
            margin-top: .14rem;
            color: var(--text-muted);
            font-size: .71rem;
            line-height: 1.4;
        }

        /* =========================================================
                   EXPERIENCE FLOW
                   ========================================================= */

        .gralcall-flow-card {
            padding: 2rem;
            border-radius: 29px;
        }

            .gralcall-flow-card h3 {
                margin: 0 0 .45rem;
                color: var(--brand-green-dark);
                font-size: 1.45rem;
                letter-spacing: -.035em;
            }

        .gralcall-flow-intro {
            margin: 0 0 1.6rem;
            color: var(--text-muted);
            font-size: .87rem;
            line-height: 1.55;
        }

        .gralcall-flow {
            display: grid;
            gap: .65rem;
        }

        .gralcall-flow-step {
            display: grid;
            grid-template-columns: 40px minmax(0, 1fr);
            gap: .85rem;
            align-items: center;
            min-height: 67px;
            padding: .72rem .85rem;
            border: 1px solid rgba(255,255,255,.50);
            border-radius: 16px;
            background: rgba(255,255,255,.27);
        }

        .gralcall-flow-index {
            width: 40px;
            height: 40px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            color: var(--brand-green-dark);
            font-size: .7rem;
            font-weight: 850;
            background: linear-gradient( 145deg, rgba(255,255,255,.76), rgba(229,244,235,.42) );
            border: 1px solid rgba(255,255,255,.78);
        }

        .gralcall-flow-copy strong {
            display: block;
            color: var(--brand-green-dark);
            font-size: .87rem;
            line-height: 1.3;
        }

        .gralcall-flow-copy span {
            display: block;
            margin-top: .17rem;
            color: var(--text-muted);
            font-size: .72rem;
            line-height: 1.35;
        }

        /* =========================================================
                   OUTCOMES
                   ========================================================= */

        .gralcall-results-section {
            padding: 7rem 0;
        }

        .gralcall-results-heading {
            max-width: 810px;
            margin: 0 auto 3.5rem;
            text-align: center;
        }

            .gralcall-results-heading h2 {
                margin: 0 0 1rem;
                color: var(--brand-green-dark);
                font-size: clamp(2.1rem, 4vw, 3.4rem);
                line-height: 1.04;
                letter-spacing: -.045em;
            }

            .gralcall-results-heading p {
                max-width: 650px;
                margin: 0 auto;
                color: var(--text-soft);
                line-height: 1.72;
            }

        .gralcall-results-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem;
        }

        .gralcall-result {
            min-height: 230px;
            padding: 1.6rem;
            border-radius: 23px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .gralcall-result-number {
            color: var(--champagne-gold);
            font-size: .7rem;
            font-weight: 850;
            letter-spacing: .08em;
        }

        .gralcall-result h3 {
            margin: 2.2rem 0 .7rem;
            color: var(--brand-green-dark);
            font-size: 1.18rem;
            line-height: 1.2;
            letter-spacing: -.03em;
        }

        .gralcall-result p {
            margin: 0;
            color: var(--text-soft);
            font-size: .82rem;
            line-height: 1.56;
        }

        /* =========================================================
                   PARTNERSHIP
                   ========================================================= */

        .gralcall-partner-section {
            padding: 0 0 7rem;
        }

        .gralcall-partner {
            position: relative;
            overflow: hidden;
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(330px, .8fr);
            gap: clamp(2.5rem, 6vw, 5.5rem);
            align-items: center;
            padding: clamp(2.8rem, 5vw, 4.6rem);
            border-radius: 32px;
            background: linear-gradient( 145deg, rgba(255,255,255,.66), rgba(237,248,241,.56) );
            border: 1px solid rgba(255,255,255,.82);
            box-shadow: 18px 22px 48px rgba(49,73,59,.085), inset 1px 1px 0 rgba(255,255,255,.95);
        }

            .gralcall-partner::after {
                content: "";
                position: absolute;
                width: 430px;
                height: 430px;
                right: -180px;
                top: -230px;
                border-radius: 50%;
                background: radial-gradient( circle, rgba(197,160,89,.14), transparent 68% );
                pointer-events: none;
            }

        .gralcall-partner-copy,
        .gralcall-partner-meta {
            position: relative;
            z-index: 2;
        }

        .gralcall-partner h2 {
            margin: 0 0 1rem;
            color: var(--brand-green-dark);
            font-size: clamp(2rem, 4vw, 3.4rem);
            line-height: 1.04;
            letter-spacing: -.045em;
        }

        .gralcall-partner-copy p {
            max-width: 700px;
            margin: 0;
            color: var(--text-soft);
            line-height: 1.76;
        }

        .gralcall-partner-meta {
            display: grid;
            gap: .7rem;
        }

        .gralcall-partner-meta-item {
            padding: 1rem 1.1rem;
            border-radius: 16px;
            background: rgba(255,255,255,.27);
            border: 1px solid rgba(255,255,255,.48);
        }

        .gralcall-partner-meta-label {
            display: block;
            margin-bottom: .25rem;
            color: var(--champagne-gold);
            font-size: .64rem;
            font-weight: 820;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .gralcall-partner-meta-value {
            color: var(--brand-green-dark);
            font-size: .86rem;
            font-weight: 720;
            line-height: 1.4;
        }

        /* =========================================================
                   CTA
                   ========================================================= */

        .gralcall-cta-section {
            padding: 1rem 0 7rem;
        }

        .gralcall-cta {
            position: relative;
            overflow: hidden;
            padding: clamp(3rem, 7vw, 5.7rem);
            border-radius: 34px;
            text-align: center;
            background: radial-gradient( circle at 50% 0%, rgba(255,255,255,.9), rgba(245,251,247,.74) 40%, rgba(231,244,236,.72) );
            border: 1px solid rgba(255,255,255,.82);
            box-shadow: 20px 25px 58px rgba(49,73,59,.09), inset 1px 1px 0 rgba(255,255,255,.96);
        }

            .gralcall-cta h2 {
                max-width: 860px;
                margin: 0 auto 1rem;
                color: var(--brand-green-dark);
                font-size: clamp(2.1rem, 4.4vw, 3.8rem);
                line-height: 1.03;
                letter-spacing: -.05em;
            }

            .gralcall-cta p {
                max-width: 650px;
                margin: 0 auto 2rem;
                color: var(--text-soft);
                line-height: 1.72;
            }

        /* =========================================================
                   RESPONSIVE
                   ========================================================= */

        @@media (max-width: 1100px) {

            .gralcall-overview-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .gralcall-meta:nth-child(3) {
                border-left: 0;
                border-top: 1px solid rgba(16,73,40,.065);
            }

            .gralcall-meta:nth-child(4) {
                border-top: 1px solid rgba(16,73,40,.065);
            }

            .gralcall-results-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 900px) {

            .gralcall-section-grid,
            .gralcall-section-grid--reverse,
            .gralcall-partner {
                grid-template-columns: 1fr;
            }

            .gralcall-content-section {
                padding: 5.5rem 0;
            }

            .gralcall-section-grid--reverse .gralcall-visual {
                order: 2;
            }

            .gralcall-section-grid--reverse .gralcall-copy {
                order: 1;
            }
        }

        @@media (max-width: 620px) {

            .gralcall-overview-shell {
                margin-top: -1.2rem;
            }

            .gralcall-overview-grid {
                grid-template-columns: 1fr;
                border-radius: 23px;
            }

            .gralcall-meta {
                min-height: 118px;
                padding: 1.45rem;
            }

                .gralcall-meta + .gralcall-meta,
                .gralcall-meta:nth-child(3),
                .gralcall-meta:nth-child(4) {
                    border-left: 0;
                    border-top: 1px solid rgba(16,73,40,.065);
                }

            .gralcall-tech-card,
            .gralcall-flow-card {
                padding: 1.3rem;
                border-radius: 22px;
            }

            .gralcall-results-grid {
                grid-template-columns: 1fr;
            }

            .gralcall-result {
                min-height: 190px;
            }

            .gralcall-partner,
            .gralcall-cta {
                padding: 3rem 1.35rem;
                border-radius: 27px;
            }
        }

        /* =========================================================
                   DARK MODE PREMIUM SPECIFIC OVERRIDES
                   ========================================================= */
        [data-theme="dark"] .gralcall-tech-card,
        [data-theme="dark"] .gralcall-flow-card,
        [data-theme="dark"] .gralcall-result,
        [data-theme="dark"] .gralcall-partner,
        [data-theme="dark"] .gralcall-overview-grid,
        [data-theme="dark"] .gralcall-cta {
            background: linear-gradient(145deg, rgba(15, 38, 26, .92), rgba(8, 24, 16, .96)) !important;
            border: 1px solid rgba(201, 168, 91, .16) !important;
            box-shadow: 0 18px 40px rgba(0, 0, 0, .28), inset 1px 1px 0 rgba(255, 255, 255, .035) !important;
        }

        [data-theme="dark"] .gralcall-copy h2,
        [data-theme="dark"] .gralcall-tech-card h3,
        [data-theme="dark"] .gralcall-flow-card h3,
        [data-theme="dark"] .gralcall-result h3,
        [data-theme="dark"] .gralcall-results-heading h2,
        [data-theme="dark"] .gralcall-partner h2,
        [data-theme="dark"] .gralcall-cta h2,
        [data-theme="dark"] .gralcall-meta-value {
            color: #edf2ec !important;
        }

        [data-theme="dark"] .gralcall-copy > p,
        [data-theme="dark"] .gralcall-result p,
        [data-theme="dark"] .gralcall-results-heading p,
        [data-theme="dark"] .gralcall-partner-copy p,
        [data-theme="dark"] .gralcall-cta p,
        [data-theme="dark"] .gralcall-flow-intro {
            color: #b8c6bc !important;
        }

        [data-theme="dark"] .gralcall-card-kicker,
        [data-theme="dark"] .gralcall-meta-label,
        [data-theme="dark"] .gralcall-result-number,
        [data-theme="dark"] .gralcall-partner-meta-label {
            color: #d2ad5e !important;
        }

        [data-theme="dark"] .gralcall-tech-item,
        [data-theme="dark"] .gralcall-flow-step,
        [data-theme="dark"] .gralcall-partner-meta-item,
        [data-theme="dark"] .gralcall-meta {
            background: rgba(231, 241, 234, .05) !important;
            border-color: rgba(231, 241, 234, .08) !important;
        }

        [data-theme="dark"] .gralcall-tech-code,
        [data-theme="dark"] .gralcall-flow-index {
            background: linear-gradient(145deg, rgba(20, 48, 33, .95), rgba(11, 29, 20, .96)) !important;
            border: 1px solid rgba(201, 168, 91, .24) !important;
            color: #48cf8a !important;
        }

        [data-theme="dark"] .gralcall-tech-copy strong,
        [data-theme="dark"] .gralcall-flow-copy strong,
        [data-theme="dark"] .gralcall-partner-meta-value {
            color: #edf2ec !important;
        }

        [data-theme="dark"] .gralcall-tech-copy span,
        [data-theme="dark"] .gralcall-flow-copy span {
            color: #819287 !important;
        }
    </style>
}

<div class="gralcall-page">

    @await Html.PartialAsync(
        "_MetalHero",
        new MetalHeroViewModel
        {
            Id = "case-gralcall",

            Size = "large",

            Eyebrow = isEn
                ? "CASE STUDY · WEBAR & INTERACTIVE TECH"
                : "CASE STUDY · WEBAR & TECNOLOGIE INTERATTIVE",

            Title = isEn
                ? "Gralcall AR: cultural experiences directly inside the mobile browser."
                : "Gralcall AR: esperienze culturali direttamente nel browser dello smartphone.",

            Subtitle = isEn
                ? "A WebAR experience designed to connect physical places with video, augmented content and interactive storytelling without requiring a dedicated native app."
                : "Un'esperienza WebAR progettata per collegare luoghi fisici, video, contenuti aumentati e storytelling interattivo senza richiedere un'app nativa dedicata.",

            Breadcrumbs = new List<MetalHeroBreadcrumbItem>
            {
                new()
                {
                    Label = "Home",
                    Url = isEn ? "/en" : "/"
                },
                new()
                {
                    Label = isEn ? "Case Studies" : "Case Study",
                    Url = isEn
                        ? "/en/case-studies"
                        : "/case-study"
                },
                new()
                {
                    Label = "Gralcall AR",
                    IsCurrent = true
                }
            }
        }
    )


    <!-- ==========================================================
         PROJECT OVERVIEW
         ========================================================== -->
    <section class="premium-pale-green gralcall-overview">

        <div class="container gralcall-overview-shell">

            <div class="gralcall-overview-grid">

                <article class="gralcall-meta">

                    <span class="gralcall-meta-label">
                        @(isEn
                            ? "Partner"
                            : "Partner")
                    </span>

                    <div class="gralcall-meta-value">
                        Associazione Manthano ETS
                    </div>

                </article>


                <article class="gralcall-meta">

                    <span class="gralcall-meta-label">
                        @(isEn
                            ? "Sectors"
                            : "Settori")
                    </span>

                    <div class="gralcall-meta-value">
                        @(isEn
                            ? "Tourism, Education & Cultural Heritage"
                            : "Turismo, Educazione & Patrimonio Culturale")
                    </div>

                </article>


                <article class="gralcall-meta">

                    <span class="gralcall-meta-label">
                        @(isEn
                            ? "Technology"
                            : "Tecnologia")
                    </span>

                    <div class="gralcall-meta-value">
                        WebAR · MindAR · Three.js · HTML5
                    </div>

                </article>


                <article class="gralcall-meta">

                    <span class="gralcall-meta-label">
                        @(isEn
                            ? "Experience"
                            : "Esperienza")
                    </span>

                    <div class="gralcall-meta-value">
                        Mobile Browser · No Dedicated App
                    </div>

                </article>

            </div>

        </div>

    </section>


    <!-- ==========================================================
         CHALLENGE
         ========================================================== -->
    <section class="gralcall-content-section bg-warm-white soft-transition transition-from-green">

        <div class="container gralcall-section-grid">

            <div class="gralcall-copy">

                <span class="section-eyebrow">
                    @(isEn
                        ? "THE CHALLENGE"
                        : "LA SFIDA")
                </span>

                <h2>
                    @(isEn
                        ? "Immersive content loses value if accessing it creates friction."
                        : "Un contenuto immersivo perde valore se accedervi crea troppo attrito.")
                </h2>

                <p>
                    @(isEn
                        ? "For a visitor walking through a museum, village or cultural itinerary, asking them to search an app store, install a dedicated application and complete an onboarding process can interrupt the experience before it even begins."
                        : "Per un visitatore che percorre un museo, un borgo o un itinerario culturale, chiedere di cercare un'app nello store, installarla e completare un onboarding può interrompere l'esperienza prima ancora che inizi.")
                </p>

                <div class="gralcall-highlight">
                    @(isEn
                        ? "The experience needed to start from something already familiar to every visitor: the smartphone camera and the browser."
                        : "L'esperienza doveva partire da strumenti già familiari a ogni visitatore: la fotocamera dello smartphone e il browser.")
                </div>

            </div>


            <div class="gralcall-visual">

                <aside class="premium-card gralcall-tech-card"
                       data-motif="network">

                    <span class="gralcall-card-kicker">
                        @(isEn
                            ? "Technology stack"
                            : "Stack tecnologico")
                    </span>

                    <h3>
                        @(isEn
                            ? "Interactive web technologies"
                            : "Tecnologie web interattive")
                    </h3>

                    <ul class="gralcall-tech-list">

                        <li class="gralcall-tech-item">

                            <span class="gralcall-tech-code">
                                WEB
                            </span>

                            <span class="gralcall-tech-copy">

                                <strong>
                                    Mobile Web Browser
                                </strong>

                                <span>
                                    @(isEn
                                        ? "Access without a dedicated native application"
                                        : "Accesso senza un'applicazione nativa dedicata")
                                </span>

                            </span>

                        </li>


                        <li class="gralcall-tech-item">

                            <span class="gralcall-tech-code">
                                AR
                            </span>

                            <span class="gralcall-tech-copy">

                                <strong>
                                    MindAR
                                </strong>

                                <span>
                                    @(isEn
                                        ? "Image-target augmented reality"
                                        : "Realtà aumentata basata su image target")
                                </span>

                            </span>

                        </li>


                        <li class="gralcall-tech-item">

                            <span class="gralcall-tech-code">
                                3D
                            </span>

                            <span class="gralcall-tech-copy">

                                <strong>
                                    Three.js / WebGL
                                </strong>

                                <span>
                                    @(isEn
                                        ? "Interactive spatial rendering"
                                        : "Rendering spaziale interattivo")
                                </span>

                            </span>

                        </li>


                        <li class="gralcall-tech-item">

