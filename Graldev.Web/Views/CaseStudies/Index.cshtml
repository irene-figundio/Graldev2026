@using Graldev.Web.Models

@{
    bool isEn = ViewData["IsEn"] as bool? ?? false;
}

@section Style {
    <style>
        .cases-page {
            --cases-border: rgba(16, 73, 40, .075);
        }

        /* =========================================================
                   CASE STUDIES SECTION
                   ========================================================= */

        .cases-section {
            padding: 7rem 0 7.5rem;
        }

        .cases-heading {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(300px, .55fr);
            gap: 3rem;
            align-items: end;
            margin-bottom: 3.5rem;
        }

            .cases-heading h2 {
                max-width: 760px;
                margin: 0;
                color: var(--brand-green-dark);
                font-size: clamp(2.15rem, 4vw, 3.5rem);
                line-height: 1.03;
                letter-spacing: -.045em;
            }

            .cases-heading p {
                max-width: 480px;
                margin: 0;
                color: var(--text-soft);
                font-size: .98rem;
                line-height: 1.7;
            }

        /* =========================================================
                   FEATURED CASE
                   ========================================================= */

        .case-featured {
            position: relative;
            overflow: hidden;
            min-height: 510px;
            padding: clamp(2rem, 4vw, 3.4rem);
            display: grid;
            grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
            gap: clamp(2.5rem, 6vw, 6rem);
            align-items: center;
            border-radius: 32px;
            background: linear-gradient( 145deg, rgba(255,255,255,.72), rgba(249,253,251,.55) 42%, rgba(230,244,236,.43) );
            border: 1px solid rgba(255,255,255,.82);
            -webkit-backdrop-filter: blur(22px) saturate(122%);
            backdrop-filter: blur(22px) saturate(122%);
            box-shadow: 19px 23px 48px rgba(49,73,59,.09), -10px -10px 30px rgba(255,255,255,.8), inset 1px 1px 0 rgba(255,255,255,.96);
        }

            .case-featured::after {
                content: "";
                position: absolute;
                width: 470px;
                height: 470px;
                right: -180px;
                top: -210px;
                border-radius: 50%;
                pointer-events: none;
                background: radial-gradient( circle, rgba(197,160,89,.14), transparent 68% );
            }

        .case-featured-content,
        .case-featured-visual {
            position: relative;
            z-index: 2;
        }

        .case-kicker {
            display: inline-flex;
            align-items: center;
            gap: .65rem;
            margin-bottom: 1.1rem;
            color: var(--brand-green);
            font-size: .68rem;
            font-weight: 820;
            letter-spacing: .09em;
            text-transform: uppercase;
        }

            .case-kicker::before {
                content: "";
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--champagne-gold);
                box-shadow: 0 0 0 5px rgba(197,160,89,.10);
            }

        .case-featured h3 {
            margin: 0 0 .9rem;
            color: var(--brand-green-dark);
            font-size: clamp(2.2rem, 4vw, 3.5rem);
            line-height: 1;
            letter-spacing: -.05em;
        }

        .case-category {
            display: block;
            margin-bottom: 1.2rem;
            color: var(--champagne-gold);
            font-size: .72rem;
            font-weight: 800;
            letter-spacing: .075em;
            text-transform: uppercase;
        }

        .case-featured-copy {
            max-width: 680px;
            margin: 0;
            color: var(--text-soft);
            font-size: 1rem;
            line-height: 1.78;
        }

        .case-tags {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
            margin: 1.6rem 0 2rem;
            padding: 0;
            list-style: none;
        }

        .case-tag {
            padding: .46rem .7rem;
            border-radius: 999px;
            color: var(--brand-green-dark);
            font-size: .68rem;
            font-weight: 720;
            background: rgba(255,255,255,.4);
            border: 1px solid rgba(16,73,40,.07);
        }

        [data-theme="dark"] .case-tag {
            background: rgba(231, 241, 234, 0.08) !important;
            border: 1px solid rgba(231, 241, 234, 0.09) !important;
            color: #d1dbd3 !important;
        }

        [data-theme="dark"] .case-card-badge {
            background: rgba(17, 171, 100, 0.08) !important;
            border: 1px solid rgba(17, 171, 100, 0.18) !important;
            color: #48cf8a !important;
        }

        [data-theme="dark"] .case-category,
        [data-theme="dark"] .case-card-category {
            color: #d2ad5e !important;
        }

        [data-theme="dark"] .case-featured h3,
        [data-theme="dark"] .case-card h3 {
            color: #edf2ec !important;
        }

        [data-theme="dark"] .case-featured-copy,
        [data-theme="dark"] .case-card p {
            color: #b8c6bc !important;
        }

        .case-link {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            color: var(--brand-green-dark);
            font-size: .84rem;
            font-weight: 780;
            text-decoration: none;
        }

            .case-link::after {
                content: "↗";
                color: var(--champagne-gold);
                transition: transform 180ms ease;
            }

            .case-link:hover::after {
                transform: translate(2px, -2px);
            }

        /* =========================================================
                   FEATURED VISUAL (GEORDIE ARCHITECTURE DIAGRAM)
                   ========================================================= */

        .case-featured-visual {
            display: flex;
            justify-content: center;
            width: 100%;
        }

        .geordie-arch-diagram {
            position: relative;
            width: 100%;
            max-width: 440px;
            padding: 1.5rem 1rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.25rem;
        }

        .arch-row {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1.25rem;
            width: 100%;
            position: relative;
        }

        .arch-core-node {
            width: 140px;
            height: 96px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 18px;
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.85), rgba(230, 244, 236, 0.65));
            border: 1px solid rgba(197, 160, 89, 0.35);
            box-shadow: 0 12px 28px rgba(42, 79, 57, 0.12), inset 1px 1px 0 rgba(255, 255, 255, 0.95);
            position: relative;
            z-index: 3;
            text-align: center;
        }

        .arch-core-title {
            font-size: 1.05rem;
            font-weight: 850;
            color: var(--brand-green-dark);
            letter-spacing: -0.02em;
        }

        .arch-core-sub {
            font-size: 0.65rem;
            font-weight: 700;
            color: var(--champagne-gold);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-top: 2px;
        }

        .arch-sub-node {
            flex: 1;
            max-width: 110px;
            min-height: 52px;
            padding: 0.5rem 0.4rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.55);
            border: 1px solid rgba(255, 255, 255, 0.82);
            box-shadow: 0 6px 16px rgba(42, 79, 57, 0.06);
            font-size: 0.73rem;
            font-weight: 750;
            color: var(--brand-green-dark);
            line-height: 1.25;
            position: relative;
            z-index: 2;
        }

        /* Connecting lines between nodes */
        .arch-line-v {
            width: 2px;
            height: 20px;
            background: linear-gradient(to bottom, rgba(197, 160, 89, 0.4), rgba(17, 171, 100, 0.3));
        }

        .arch-line-h {
            height: 2px;
            width: 24px;
            background: rgba(197, 160, 89, 0.35);
        }

        [data-theme="dark"] .arch-core-node {
            background: linear-gradient(145deg, rgba(20, 48, 33, 0.95), rgba(11, 29, 20, 0.96)) !important;
            border: 1px solid rgba(201, 168, 91, 0.28) !important;
            box-shadow: 0 14px 32px rgba(0, 0, 0, 0.32), inset 1px 1px 0 rgba(255, 255, 255, 0.04) !important;
        }

        [data-theme="dark"] .arch-core-title {
            color: #edf2ec !important;
        }

        [data-theme="dark"] .arch-core-sub {
            color: #d2ad5e !important;
        }

        [data-theme="dark"] .arch-sub-node {
            background: rgba(16, 39, 27, 0.75) !important;
            border: 1px solid rgba(184, 205, 190, 0.12) !important;
            color: #d5dfd7 !important;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25) !important;
        }

        [data-theme="dark"] .arch-line-v,
        [data-theme="dark"] .arch-line-h {
            background: rgba(201, 168, 91, 0.28) !important;
        }

        /* =========================================================
                   SECONDARY CASES
                   ========================================================= */

        .cases-secondary-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1.25rem;
            margin-top: 1.25rem;
        }

        .case-card {
            min-height: 390px;
            padding: 2rem;
            border-radius: 27px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .case-card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
        }

        .case-card-number {
            color: var(--champagne-gold);
            font-size: .7rem;
            font-weight: 850;
            letter-spacing: .08em;
        }

        .case-card-badge {
            padding: .43rem .7rem;
            border-radius: 999px;
            color: var(--brand-green);
            background: rgba(17,171,100,.055);
            border: 1px solid rgba(17,171,100,.08);
            font-size: .63rem;
            font-weight: 800;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .case-card h3 {
            margin: 3.2rem 0 .65rem;
            color: var(--brand-green-dark);
            font-size: clamp(1.7rem, 3vw, 2.35rem);
            letter-spacing: -.045em;
        }

        .case-card-category {
            display: block;
            margin-bottom: 1rem;
            color: var(--champagne-gold);
            font-size: .69rem;
            font-weight: 800;
            letter-spacing: .065em;
            text-transform: uppercase;
        }

        .case-card p {
            max-width: 520px;
            margin: 0;
            color: var(--text-soft);
            font-size: .91rem;
            line-height: 1.68;
        }

        .case-card .case-tags {
            margin-bottom: 1.55rem;
        }

        /* =========================================================
                   CLOSING
                   ========================================================= */

        .cases-closing {
            padding: 0 0 7rem;
        }

        .cases-closing-card {
            position: relative;
            overflow: hidden;
            padding: clamp(2.8rem, 6vw, 5rem);
            border-radius: 32px;
            text-align: center;
            background: radial-gradient( circle at 50% 0%, rgba(255,255,255,.88), rgba(243,250,246,.72) 42%, rgba(230,244,236,.72) );
            border: 1px solid rgba(255,255,255,.82);
            box-shadow: 19px 24px 52px rgba(49,73,59,.09), inset 1px 1px 0 rgba(255,255,255,.96);
        }

            .cases-closing-card h2 {
                max-width: 800px;
                margin: 0 auto 1rem;
                color: var(--brand-green-dark);
                font-size: clamp(2rem, 4.3vw, 3.6rem);
                line-height: 1.03;
                letter-spacing: -.048em;
            }

            .cases-closing-card p {
                max-width: 620px;
                margin: 0 auto;
                color: var(--text-soft);
                line-height: 1.7;
            }

        /* =========================================================
                   RESPONSIVE
                   ========================================================= */

        @@media (max-width: 980px) {
            .cases-heading {
                grid-template-columns: 1fr;
                gap: 1.2rem;
            }

            .case-featured {
                grid-template-columns: 1fr;
            }

            .commerce-diagram {
                margin: 0 auto;
            }
        }

        @@media (max-width: 760px) {
            .cases-section {
                padding: 5.5rem 0;
            }

            .cases-secondary-grid {
                grid-template-columns: 1fr;
            }

            .case-featured {
                min-height: auto;
                padding: 1.6rem;
                border-radius: 25px;
            }

            .case-card {
                min-height: 330px;
            }
        }

        @@media (max-width: 560px) {
            .commerce-diagram {
                min-height: 310px;
                transform: scale(.88);
            }

            .case-card {
                padding: 1.5rem;
                border-radius: 23px;
            }

            .cases-closing-card {
                padding: 3rem 1.35rem;
                border-radius: 26px;
            }
        }
    </style>
}

<div class="cases-page">

    @await Html.PartialAsync(
        "_MetalHero",
        new MetalHeroViewModel
        {
            Id = "case-studies",
            Size = "large",
            Eyebrow = "CASE STUDIES",
            Title = isEn
                ? "Concrete projects, solved problems and tangible outcomes."
                : "Progetti reali, problemi risolti e risultati concreti.",

            Subtitle = isEn
                ? "Explore how we work alongside enterprises to connect systems, automate operations and turn technical complexity into measurable operational efficiency."
                : "Scopri come affianchiamo le aziende per collegare sistemi, automatizzare processi e trasformare la complessità tecnologica in efficienza operativa reale.",

            Breadcrumbs = new List<MetalHeroBreadcrumbItem>
            {
                new()
                {
                    Label = "Home",
                    Url = isEn ? "/en" : "/"
                },
                new()
                {
                    Label = isEn ? "Case Studies" : "Case Study",
                    IsCurrent = true
                }
            }
        }
    )


    <section class="cases-section premium-pale-green soft-transition transition-from-warm">

        <div class="container">

            <div class="cases-heading">

                <div>

                    <span class="section-eyebrow">
                        @(isEn ? "SELECTED WORK" : "PROGETTI SELEZIONATI")
                    </span>

                    <h2>
                        @(isEn
                            ? "Different industries. The same starting point: a real operational problem."
                            : "Settori diversi. Lo stesso punto di partenza: un problema operativo reale.")
                    </h2>

                </div>

                <p>
                    @(isEn
                        ? "Our projects range from enterprise integration and digital commerce to AI and immersive experiences. The technology changes; the method remains the same."
                        : "I nostri progetti spaziano dall'integrazione enterprise e digital commerce all'AI e alle esperienze immersive. Cambia la tecnologia, non il metodo.")
                </p>

            </div>


            <!-- ==================================================
                 GEORDIE
                 ================================================== -->
            <article class="case-featured">

                <div class="case-featured-content">

                    <span class="case-kicker">
                        @(isEn ? "Featured case study" : "Case study in evidenza")
                    </span>

                    <h3>
                        Geordie
                    </h3>

                    <span class="case-category">
                        @(isEn
                            ? "ERP & Omnichannel Commerce Integration"
                            : "ERP & Integrazione Commerce Multicanale")
                    </span>

                    <p class="case-featured-copy">
                        @(isEn
                            ? "A centralized middleware engineered to coordinate ERP data, stock availability, eCommerce stores, marketplaces and carrier operations across Shopify, Amazon, eBay, GLS and BRT."
                            : "Un middleware centralizzato progettato per coordinare dati ERP, disponibilità di magazzino, store eCommerce, marketplace e flussi dei corrieri tra Shopify, Amazon, eBay, GLS e BRT.")
                    </p>

                    <ul class="case-tags">
                        <li class="case-tag">ERP</li>
                        <li class="case-tag">Shopify</li>
                        <li class="case-tag">Amazon</li>
                        <li class="case-tag">eBay</li>
                        <li class="case-tag">API Integration</li>
                        <li class="case-tag">Logistics</li>
                    </ul>

                    <a href="@(isEn
                                                       ? "/en/case-studies/geordie"
                                                       : "/case-study/geordie")"
                       class="case-link">

                        @(isEn
                            ? "Explore the case study"
                            : "Scopri il progetto")

                    </a>

                </div>


                <div class="case-featured-visual"
                     aria-hidden="true">

                    <div class="geordie-arch-diagram">
                        <!-- Top Row: ERP -->
                        <div class="arch-row">
                            <div class="arch-sub-node">
                                <strong>ERP</strong>
                                <span style="font-size: 0.62rem; opacity: 0.8;">Internal System</span>
                            </div>
                        </div>

                        <div class="arch-line-v"></div>

                        <!-- Middle Row: Stock / Orders <---> GEORDIE CORE <---> Shopify -->
                        <div class="arch-row">
                            <div class="arch-sub-node">
                                <strong>Stock &amp; Orders</strong>
                            </div>
                            <div class="arch-line-h"></div>
                            <div class="arch-core-node">
                                <span class="arch-core-title">GEORDIE</span>
                                <span class="arch-core-sub">Core Layer</span>
                            </div>
                            <div class="arch-line-h"></div>
                            <div class="arch-sub-node">
                                <strong>Shopify</strong>
                                <span style="font-size: 0.62rem; opacity: 0.8;">Direct Stores</span>
                            </div>
                        </div>

                        <div class="arch-line-v"></div>

                        <!-- Bottom Row: Amazon/eBay & GLS/BRT -->
                        <div class="arch-row">
                            <div class="arch-sub-node">
                                <strong>Amazon / eBay</strong>
                                <span style="font-size: 0.62rem; opacity: 0.8;">Marketplaces</span>
                            </div>
                            <div class="arch-sub-node">
                                <strong>GLS / BRT</strong>
                                <span style="font-size: 0.62rem; opacity: 0.8;">Logistics APIs</span>
                            </div>
                        </div>
                    </div>

                </div>

            </article>


            <!-- ==================================================
                 SECONDARY CASES
                 ================================================== -->
            <div class="cases-secondary-grid">


                <!-- VITINERARIO -->
                <article class="premium-card case-card"
                         data-motif="ai">

                    <div>

                        <div class="case-card-top">

                            <span class="case-card-number">
                                02
                            </span>

                            <span class="case-card-badge">
                                AI / RAG
                            </span>

                        </div>

                        <h3>
                            Vitinerario
                        </h3>

                        <span class="case-card-category">
                            @(isEn
                                ? "AI Sommelier & RAG Knowledge Architecture"
                                : "AI Sommelier & Knowledge Architecture RAG")
                        </span>

                        <p>
                            @(isEn
                                ? "An interactive virtual sommelier that combines Large Language Models with semantic retrieval and verified enological data to produce contextual wine recommendations."
                                : "Un sommelier virtuale interattivo che combina Large Language Models, retrieval semantico e dati enologici verificati per produrre suggerimenti contestualizzati.")
                        </p>

                        <ul class="case-tags">
                            <li class="case-tag">LLM</li>
                            <li class="case-tag">RAG</li>
                            <li class="case-tag">Vector DB</li>
                            <li class="case-tag">OpenAI</li>
                        </ul>

                    </div>

                    <a href="@(isEn
                                                       ? "/en/case-studies/vitinerario"
                                                       : "/case-study/vitinerario")"
                       class="case-link">

                        @(isEn
                            ? "Explore the case study"
                            : "Scopri il progetto")

                    </a>

                </article>


                <!-- GRALCALL -->
                <article class="premium-card case-card"
                         data-motif="network">

                    <div>

                        <div class="case-card-top">

                            <span class="case-card-number">
                                03
                            </span>

                            <span class="case-card-badge">
                                WebAR
                            </span>

                        </div>

                        <h3>
                            Gralcall AR
                        </h3>

                        <span class="case-card-category">
                            @(isEn
                                ? "WebAR & Interactive Territorial Guides"
                                : "WebAR & Guide Territoriali Interattive")
                        </span>

                        <p>
                            @(isEn
                                ? "A browser-based augmented reality experience that connects physical landmarks with multimedia storytelling, without requiring users to install a dedicated application."
                                : "Un'esperienza di realtà aumentata direttamente nel browser che collega luoghi fisici e narrazione multimediale, senza richiedere l'installazione di un'app dedicata.")
                        </p>

                        <ul class="case-tags">
                            <li class="case-tag">WebAR</li>
                            <li class="case-tag">3D</li>
                            <li class="case-tag">Mobile Web</li>
                            <li class="case-tag">Storytelling</li>
                        </ul>

                    </div>

                    <a href="@(isEn
                                                       ? "/en/case-studies/gralcall"
                                                       : "/case-study/gralcall")"
                       class="case-link">

                        @(isEn
                            ? "Explore the case study"
                            : "Scopri il progetto")

                    </a>

                </article>

            </div>

        </div>

    </section>


    <section class="cases-closing bg-warm-white soft-transition transition-from-green">

        <div class="container">

            <div class="cases-closing-card">

                <span class="section-eyebrow">
                    @(isEn
                        ? "FROM COMPLEXITY TO OPERATIONS"
                        : "DALLA COMPLESSITÀ ALL'OPERATIVITÀ")
                </span>

                <h2>
                    @(isEn
                        ? "The technology is never the starting point."
                        : "La tecnologia non è mai il punto di partenza.")
                </h2>

                <p>
                    @(isEn
                        ? "Each case starts with processes, existing systems and a concrete business constraint. Architecture, integration and custom development come after."
                        : "Ogni progetto parte dai processi, dai sistemi esistenti e da un vincolo concreto di business. Architettura, integrazione e sviluppo custom vengono dopo.")
                </p>

            </div>

        </div>

    </section>

</div>